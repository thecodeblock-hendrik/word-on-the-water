    "/v1/subscribers": {
      "post": {
        "description": "202 with the same body for a new, pending or confirmed address, and for a simple bot.\n\nThe cheap bot checks run first so a bot never costs a Cloudflare call. A token Cloudflare\nrefuses is a 400 (the visitor solves the challenge again); if Cloudflare cannot judge it,\na 503 and nothing is stored, so a sign-up is never accepted unverified.",
        "operationId": "subscribe_v1_subscribers_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
