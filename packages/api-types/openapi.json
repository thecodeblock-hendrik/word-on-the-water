{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "SubscribeRequest": {
        "additionalProperties": false,
        "description": "A sign-up. Strict: unknown fields are an error and every length is capped.",
        "properties": {
          "consent_text_version": {
            "maxLength": 20,
            "minLength": 1,
            "title": "Consent Text Version",
            "type": "string"
          },
          "email": {
            "format": "email",
            "maxLength": 254,
            "title": "Email",
            "type": "string"
          },
          "first_name": {
            "anyOf": [
              {
                "maxLength": 80,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Name"
          },
          "rendered_at": {
            "minimum": 0.0,
            "title": "Rendered At",
            "type": "integer"
          },
          "source": {
            "maxLength": 40,
            "minLength": 1,
            "pattern": "^[a-z0-9_]+$",
            "title": "Source",
            "type": "string"
          },
          "turnstile_token": {
            "maxLength": 2048,
            "minLength": 1,
            "title": "Turnstile Token",
            "type": "string"
          },
          "website": {
            "default": "",
            "maxLength": 1000,
            "title": "Website",
            "type": "string"
          }
        },
        "required": [
          "email",
          "source",
          "consent_text_version",
          "rendered_at",
          "turnstile_token"
        ],
        "title": "SubscribeRequest",
        "type": "object"
      },
      "SubscribeResponse": {
        "description": "One answer for a new, a pending and a confirmed address, so nobody can probe the list.",
        "properties": {
          "status": {
            "const": "check_your_inbox",
            "default": "check_your_inbox",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "SubscribeResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
