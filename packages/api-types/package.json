{
  "name": "@wotw/api-types",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript types generated from the FastAPI OpenAPI schema. Run `make types`.",
  "types": "./src/schema.d.ts",
  "exports": {
    ".": {
      "types": "./src/schema.d.ts"
    }
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/schema.d.ts"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0"
  }
}
