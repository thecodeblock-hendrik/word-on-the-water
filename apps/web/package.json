{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:fast": "playwright test --project=pixel-7 --project=desktop-chromium",
    "check:placeholders": "NODE_NO_WARNINGS=1 node scripts/check-placeholders.mts",
    "make:icons": "NODE_NO_WARNINGS=1 node scripts/make-icons.mts",
    "check:devotionals": "NODE_NO_WARNINGS=1 node scripts/check-devotionals.mts",
    "build:chat-topics": "NODE_NO_WARNINGS=1 node scripts/build-chat-topics.mts",
    "build:bible": "NODE_NO_WARNINGS=1 node scripts/build-bible.mts",
    "broadcast:devotional": "NODE_NO_WARNINGS=1 node --env-file-if-exists=../../.env scripts/broadcast-devotional.mts",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@next/env": "^16.4.6",
    "@sentry/node": "^11.11.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "get-nonce": "^1.0.1",
    "next": "16.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "@wotw/api-types": "workspace:*",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.16.1"
}
