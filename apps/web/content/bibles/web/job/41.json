{"version":"web","book":"job","chapter":41,"blocks":[{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"“Can you draw out Leviathan with a fish hook,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"or press down his tongue with a cord?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"Can you put a rope into his nose,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"or pierce his jaw through with a hook?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"Will he make many petitions to you,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"or will he speak soft words to you?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"Will he make a covenant with you,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"that you should take him for a servant forever?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"Will you play with him as with a bird?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"Or will you bind him for your girls?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"Will traders barter for him?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"Will they part him among the merchants?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"Can you fill his skin with barbed irons,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"or his head with fish spears?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"Lay your hand on him."}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"Remember the battle, and do so no more."}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"Behold, the hope of him is in vain."}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"Won’t one be cast down even at the sight of him?"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"None is so fierce that he dare stir him up."}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"Who then is he who can stand before me?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"Who has first given to me, that I should repay him?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"Everything under the heavens is mine."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"“I will not keep silence concerning his limbs,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"nor his mighty strength, nor his goodly frame."}]},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":true,"text":"Who can strip off his outer garment?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"Who will come within his jaws?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":true,"text":"Who can open the doors of his face?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"Around his teeth is terror."}]},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":true,"text":"Strong scales are his pride,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"shut up together with a close seal."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":true,"text":"One is so near to another,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"that no air can come between them."}]},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":true,"text":"They are joined to one another."}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"They stick together, so that they can’t be pulled apart."}]},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":true,"text":"His sneezing flashes out light."}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"His eyes are like the eyelids of the morning."}]},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":true,"text":"Out of his mouth go burning torches."}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"Sparks of fire leap out."}]},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":true,"text":"Out of his nostrils a smoke goes,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"as of a boiling pot over a fire of reeds."}]},{"kind":"poetry","indent":1,"runs":[{"verse":21,"end":null,"start":true,"text":"His breath kindles coals."}]},{"kind":"poetry","indent":2,"runs":[{"verse":21,"end":null,"start":false,"text":"A flame goes out of his mouth."}]},{"kind":"poetry","indent":1,"runs":[{"verse":22,"end":null,"start":true,"text":"There is strength in his neck."}]},{"kind":"poetry","indent":2,"runs":[{"verse":22,"end":null,"start":false,"text":"Terror dances before him."}]},{"kind":"poetry","indent":1,"runs":[{"verse":23,"end":null,"start":true,"text":"The flakes of his flesh are joined together."}]},{"kind":"poetry","indent":2,"runs":[{"verse":23,"end":null,"start":false,"text":"They are firm on him."}]},{"kind":"poetry","indent":2,"runs":[{"verse":23,"end":null,"start":false,"text":"They can’t be moved."}]},{"kind":"poetry","indent":1,"runs":[{"verse":24,"end":null,"start":true,"text":"His heart is as firm as a stone,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":24,"end":null,"start":false,"text":"yes, firm as the lower millstone."}]},{"kind":"poetry","indent":1,"runs":[{"verse":25,"end":null,"start":true,"text":"When he raises himself up, the mighty are afraid."}]},{"kind":"poetry","indent":2,"runs":[{"verse":25,"end":null,"start":false,"text":"They retreat before his thrashing."}]},{"kind":"poetry","indent":1,"runs":[{"verse":26,"end":null,"start":true,"text":"If one attacks him with the sword, it can’t prevail;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":26,"end":null,"start":false,"text":"nor the spear, the dart, nor the pointed shaft."}]},{"kind":"poetry","indent":1,"runs":[{"verse":27,"end":null,"start":true,"text":"He counts iron as straw,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":27,"end":null,"start":false,"text":"and bronze as rotten wood."}]},{"kind":"poetry","indent":1,"runs":[{"verse":28,"end":null,"start":true,"text":"The arrow can’t make him flee."}]},{"kind":"poetry","indent":2,"runs":[{"verse":28,"end":null,"start":false,"text":"Sling stones are like chaff to him."}]},{"kind":"poetry","indent":1,"runs":[{"verse":29,"end":null,"start":true,"text":"Clubs are counted as stubble."}]},{"kind":"poetry","indent":2,"runs":[{"verse":29,"end":null,"start":false,"text":"He laughs at the rushing of the javelin."}]},{"kind":"poetry","indent":1,"runs":[{"verse":30,"end":null,"start":true,"text":"His undersides are like sharp potsherds,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":30,"end":null,"start":false,"text":"leaving a trail in the mud like a threshing sledge."}]},{"kind":"poetry","indent":1,"runs":[{"verse":31,"end":null,"start":true,"text":"He makes the deep to boil like a pot."}]},{"kind":"poetry","indent":2,"runs":[{"verse":31,"end":null,"start":false,"text":"He makes the sea like a pot of ointment."}]},{"kind":"poetry","indent":1,"runs":[{"verse":32,"end":null,"start":true,"text":"He makes a path shine after him."}]},{"kind":"poetry","indent":2,"runs":[{"verse":32,"end":null,"start":false,"text":"One would think the deep had white hair."}]},{"kind":"poetry","indent":1,"runs":[{"verse":33,"end":null,"start":true,"text":"On earth there is not his equal,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":33,"end":null,"start":false,"text":"that is made without fear."}]},{"kind":"poetry","indent":1,"runs":[{"verse":34,"end":null,"start":true,"text":"He sees everything that is high."}]},{"kind":"poetry","indent":2,"runs":[{"verse":34,"end":null,"start":false,"text":"He is king over all the sons of pride.”"}]},{"kind":"break"}]}
