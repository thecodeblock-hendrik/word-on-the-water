{"version":"web","book":"job","chapter":25,"blocks":[{"kind":"paragraph","indent":0,"runs":[{"verse":1,"end":null,"start":true,"text":"Then Bildad the Shuhite answered,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"“Dominion and fear are with him."}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"He makes peace in his high places."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"Can his armies be counted?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"On whom does his light not arise?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"How then can man be just with God?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"Or how can he who is born of a woman be clean?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"Behold, even the moon has no brightness,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"and the stars are not pure in his sight;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"How much less man, who is a worm,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"and the son of man, who is a worm!”"}]}]}
