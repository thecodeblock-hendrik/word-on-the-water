{"version":"web","book":"lamentations","chapter":3,"blocks":[{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"I am the man who has seen affliction"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"by the rod of his wrath."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"He has led me and caused me to walk in darkness,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"and not in light."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"Surely he turns his hand against me"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"again and again all day long."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"He has made my flesh and my skin old."}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"He has broken my bones."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"He has built against me,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"and surrounded me with bitterness and hardship."}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"He has made me dwell in dark places,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"as those who have been long dead."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"He has walled me about, so that I can’t go out."}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"He has made my chain heavy."}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"Yes, when I cry, and call for help,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"he shuts out my prayer."}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"He has walled up my ways with cut stone."}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"He has made my paths crooked."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"He is to me as a bear lying in wait,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"as a lion in hiding."}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"He has turned away my path,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"and pulled me in pieces."}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"He has made me desolate."}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"He has bent his bow,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"and set me as a mark for the arrow."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":true,"text":"He has caused the shafts of his quiver to enter into my kidneys."}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":true,"text":"I have become a derision to all my people,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"and their song all day long."}]},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":true,"text":"He has filled me with bitterness."}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"He has stuffed me with wormwood."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":true,"text":"He has also broken my teeth with gravel."}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"He has covered me with ashes."}]},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":true,"text":"You have removed my soul far away from peace."}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"I forgot prosperity."}]},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":true,"text":"I said, “My strength has perished,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"along with my expectation from the LORD.”"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":true,"text":"Remember my affliction and my misery,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"the wormwood and the bitterness."}]},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":true,"text":"My soul still remembers them,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"and is bowed down within me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":21,"end":null,"start":true,"text":"This I recall to my mind;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":21,"end":null,"start":false,"text":"therefore I have hope."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":22,"end":null,"start":true,"text":"It is because of the LORD’s loving kindnesses that we are not consumed,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":22,"end":null,"start":false,"text":"because his mercies don’t fail."}]},{"kind":"poetry","indent":1,"runs":[{"verse":23,"end":null,"start":true,"text":"They are new every morning."}]},{"kind":"poetry","indent":2,"runs":[{"verse":23,"end":null,"start":false,"text":"Great is your faithfulness."}]},{"kind":"poetry","indent":1,"runs":[{"verse":24,"end":null,"start":true,"text":"“The LORD is my portion,” says my soul."}]},{"kind":"poetry","indent":2,"runs":[{"verse":24,"end":null,"start":false,"text":"“Therefore I will hope in him.”"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":25,"end":null,"start":true,"text":"The LORD is good to those who wait for him,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":25,"end":null,"start":false,"text":"to the soul who seeks him."}]},{"kind":"poetry","indent":1,"runs":[{"verse":26,"end":null,"start":true,"text":"It is good that a man should hope"}]},{"kind":"poetry","indent":2,"runs":[{"verse":26,"end":null,"start":false,"text":"and quietly wait for the salvation of the LORD."}]},{"kind":"poetry","indent":2,"runs":[{"verse":27,"end":null,"start":true,"text":"It is good for a man that he bear the yoke in his youth."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":28,"end":null,"start":true,"text":"Let him sit alone and keep silence,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":28,"end":null,"start":false,"text":"because he has laid it on him."}]},{"kind":"poetry","indent":1,"runs":[{"verse":29,"end":null,"start":true,"text":"Let him put his mouth in the dust,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":29,"end":null,"start":false,"text":"if it is so that there may be hope."}]},{"kind":"poetry","indent":1,"runs":[{"verse":30,"end":null,"start":true,"text":"Let him give his cheek to him who strikes him."}]},{"kind":"poetry","indent":2,"runs":[{"verse":30,"end":null,"start":false,"text":"Let him be filled full of reproach."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":31,"end":null,"start":true,"text":"For the Lord will not cast off forever."}]},{"kind":"poetry","indent":2,"runs":[{"verse":32,"end":null,"start":true,"text":"For though he causes grief,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":32,"end":null,"start":false,"text":"yet he will have compassion according to the multitude of his loving kindnesses."}]},{"kind":"poetry","indent":1,"runs":[{"verse":33,"end":null,"start":true,"text":"For he does not afflict willingly,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":33,"end":null,"start":false,"text":"nor grieve the children of men."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":34,"end":null,"start":true,"text":"To crush under foot all the prisoners of the earth,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":35,"end":null,"start":true,"text":"to turn away the right of a man before the face of the Most High,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":36,"end":null,"start":true,"text":"to subvert a man in his cause, the Lord doesn’t approve."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":37,"end":null,"start":true,"text":"Who is he who says, and it comes to pass,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":37,"end":null,"start":false,"text":"when the Lord doesn’t command it?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":38,"end":null,"start":true,"text":"Doesn’t evil and good come out of the mouth of the Most High?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":39,"end":null,"start":true,"text":"Why should a living man complain,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":39,"end":null,"start":false,"text":"a man for the punishment of his sins?"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":40,"end":null,"start":true,"text":"Let us search and try our ways,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":40,"end":null,"start":false,"text":"and turn again to the LORD."}]},{"kind":"poetry","indent":1,"runs":[{"verse":41,"end":null,"start":true,"text":"Let’s lift up our heart with our hands to God in the heavens."}]},{"kind":"poetry","indent":2,"runs":[{"verse":42,"end":null,"start":true,"text":"“We have transgressed and have rebelled."}]},{"kind":"poetry","indent":2,"runs":[{"verse":42,"end":null,"start":false,"text":"You have not pardoned."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":43,"end":null,"start":true,"text":"“You have covered us with anger and pursued us."}]},{"kind":"poetry","indent":2,"runs":[{"verse":43,"end":null,"start":false,"text":"You have killed."}]},{"kind":"poetry","indent":2,"runs":[{"verse":43,"end":null,"start":false,"text":"You have not pitied."}]},{"kind":"poetry","indent":1,"runs":[{"verse":44,"end":null,"start":true,"text":"You have covered yourself with a cloud,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":44,"end":null,"start":false,"text":"so that no prayer can pass through."}]},{"kind":"poetry","indent":1,"runs":[{"verse":45,"end":null,"start":true,"text":"You have made us an off-scouring and refuse"}]},{"kind":"poetry","indent":2,"runs":[{"verse":45,"end":null,"start":false,"text":"in the middle of the peoples."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":46,"end":null,"start":true,"text":"“All our enemies have opened their mouth wide against us."}]},{"kind":"poetry","indent":2,"runs":[{"verse":47,"end":null,"start":true,"text":"Terror and the pit have come on us,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":47,"end":null,"start":false,"text":"devastation and destruction.”"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":48,"end":null,"start":true,"text":"My eye runs down with streams of water,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":48,"end":null,"start":false,"text":"for the destruction of the daughter of my people."}]},{"kind":"poetry","indent":1,"runs":[{"verse":49,"end":null,"start":true,"text":"My eye pours down"}]},{"kind":"poetry","indent":2,"runs":[{"verse":49,"end":null,"start":false,"text":"and doesn’t cease,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":49,"end":null,"start":false,"text":"without any intermission,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":50,"end":null,"start":true,"text":"until the LORD looks down,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":50,"end":null,"start":false,"text":"and sees from heaven."}]},{"kind":"poetry","indent":1,"runs":[{"verse":51,"end":null,"start":true,"text":"My eye affects my soul,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":51,"end":null,"start":false,"text":"because of all the daughters of my city."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":52,"end":null,"start":true,"text":"They have chased me relentlessly like a bird,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":52,"end":null,"start":false,"text":"those who are my enemies without cause."}]},{"kind":"poetry","indent":1,"runs":[{"verse":53,"end":null,"start":true,"text":"They have cut off my life in the dungeon,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":53,"end":null,"start":false,"text":"and have cast a stone on me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":54,"end":null,"start":true,"text":"Waters flowed over my head."}]},{"kind":"poetry","indent":2,"runs":[{"verse":54,"end":null,"start":false,"text":"I said, “I am cut off.”"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":55,"end":null,"start":true,"text":"I called on your name, LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":55,"end":null,"start":false,"text":"out of the lowest dungeon."}]},{"kind":"poetry","indent":1,"runs":[{"verse":56,"end":null,"start":true,"text":"You heard my voice:"}]},{"kind":"poetry","indent":2,"runs":[{"verse":56,"end":null,"start":false,"text":"“Don’t hide your ear from my sighing,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":56,"end":null,"start":false,"text":"and my cry.”"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":57,"end":null,"start":true,"text":"You came near in the day that I called on you."}]},{"kind":"poetry","indent":2,"runs":[{"verse":57,"end":null,"start":false,"text":"You said, “Don’t be afraid.”"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":58,"end":null,"start":true,"text":"Lord, you have pleaded the causes of my soul."}]},{"kind":"poetry","indent":2,"runs":[{"verse":58,"end":null,"start":false,"text":"You have redeemed my life."}]},{"kind":"poetry","indent":1,"runs":[{"verse":59,"end":null,"start":true,"text":"LORD, you have seen my wrong."}]},{"kind":"poetry","indent":2,"runs":[{"verse":59,"end":null,"start":false,"text":"Judge my cause."}]},{"kind":"poetry","indent":1,"runs":[{"verse":60,"end":null,"start":true,"text":"You have seen all their vengeance"}]},{"kind":"poetry","indent":2,"runs":[{"verse":60,"end":null,"start":false,"text":"and all their plans against me."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":61,"end":null,"start":true,"text":"You have heard their reproach, LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":61,"end":null,"start":false,"text":"and all their plans against me,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":62,"end":null,"start":true,"text":"the lips of those that rose up against me,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":62,"end":null,"start":false,"text":"and their plots against me all day long."}]},{"kind":"poetry","indent":1,"runs":[{"verse":63,"end":null,"start":true,"text":"You see their sitting down and their rising up."}]},{"kind":"poetry","indent":2,"runs":[{"verse":63,"end":null,"start":false,"text":"I am their song."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":64,"end":null,"start":true,"text":"You will pay them back, LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":64,"end":null,"start":false,"text":"according to the work of their hands."}]},{"kind":"poetry","indent":1,"runs":[{"verse":65,"end":null,"start":true,"text":"You will give them hardness of heart,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":65,"end":null,"start":false,"text":"your curse to them."}]},{"kind":"poetry","indent":1,"runs":[{"verse":66,"end":null,"start":true,"text":"You will pursue them in anger,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":66,"end":null,"start":false,"text":"and destroy them from under the heavens of the LORD."}]}]}
