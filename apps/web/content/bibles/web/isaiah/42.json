{"version":"web","book":"isaiah","chapter":42,"blocks":[{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"“Behold, my servant, whom I uphold,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"my chosen, in whom my soul delights:"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"I have put my Spirit on him."}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"He will bring justice to the nations."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"He will not shout,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"nor raise his voice,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"nor cause it to be heard in the street."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"He won’t break a bruised reed."}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"He won’t quench a dimly burning wick."}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"He will faithfully bring justice."}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"He will not fail nor be discouraged,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"until he has set justice on the earth,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"and the islands wait for his law.”"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"God the LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"he who created the heavens and stretched them out,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"he who spread out the earth and that which comes out of it,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"he who gives breath to its people and spirit to those who walk in it, says:"}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"“I, the LORD, have called you in righteousness."}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"I will hold your hand."}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"I will keep you,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"and make you a covenant for the people,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"as a light for the nations,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":true,"text":"to open the blind eyes,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"to bring the prisoners out of the dungeon,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"and those who sit in darkness out of the prison."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"“I am the LORD."}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"That is my name."}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"I will not give my glory to another,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"nor my praise to engraved images."}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"Behold, the former things have happened"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"and I declare new things."}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"I tell you about them before they come up.”"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"Sing to the LORD a new song,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"and his praise from the end of the earth,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"you who go down to the sea,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"and all that is therein,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"the islands and their inhabitants."}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"Let the wilderness and its cities raise their voices,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"with the villages that Kedar inhabits."}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"Let the inhabitants of Sela sing."}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"Let them shout from the top of the mountains!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"Let them give glory to the LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"and declare his praise in the islands."}]},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":true,"text":"The LORD will go out like a mighty man."}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"He will stir up zeal like a man of war."}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"He will raise a war cry."}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"Yes, he will shout aloud."}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"He will triumph over his enemies."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":true,"text":"“I have been silent a long time."}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"I have been quiet and restrained myself."}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"Now I will cry out like a travailing woman. I will both gasp and pant."}]},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":true,"text":"I will destroy mountains and hills,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"and dry up all their herbs."}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"I will make the rivers islands,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"and will dry up the pools."}]},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":true,"text":"I will bring the blind by a way that they don’t know."}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"I will lead them in paths that they don’t know."}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"I will make darkness light before them,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"and crooked places straight."}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"I will do these things,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"and I will not forsake them."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":true,"text":"“Those who trust in engraved images,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"who tell molten images,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"‘You are our gods,’"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"will be turned back."}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"They will be utterly disappointed."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":true,"text":"“Hear, you deaf,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"and look, you blind,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"that you may see."}]},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":true,"text":"Who is blind, but my servant?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"Or who is as deaf as my messenger whom I send?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":false,"text":"Who is as blind as he who is at peace,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"and as blind as the LORD’s servant?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":true,"text":"You see many things, but don’t observe."}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"His ears are open, but he doesn’t listen."}]},{"kind":"poetry","indent":1,"runs":[{"verse":21,"end":null,"start":true,"text":"It pleased the LORD, for his righteousness’ sake, to magnify the law"}]},{"kind":"poetry","indent":2,"runs":[{"verse":21,"end":null,"start":false,"text":"and make it honorable."}]},{"kind":"poetry","indent":1,"runs":[{"verse":22,"end":null,"start":true,"text":"But this is a robbed and plundered people."}]},{"kind":"poetry","indent":2,"runs":[{"verse":22,"end":null,"start":false,"text":"All of them are snared in holes,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":22,"end":null,"start":false,"text":"and they are hidden in prisons."}]},{"kind":"poetry","indent":1,"runs":[{"verse":22,"end":null,"start":false,"text":"They have become captives, and no one delivers,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":22,"end":null,"start":false,"text":"and a plunder, and no one says, ‘Restore them!’"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":23,"end":null,"start":true,"text":"Who is there among you who will give ear to this?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":23,"end":null,"start":false,"text":"Who will listen and hear for the time to come?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":24,"end":null,"start":true,"text":"Who gave Jacob as plunder,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":24,"end":null,"start":false,"text":"and Israel to the robbers?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":24,"end":null,"start":false,"text":"Didn’t the LORD, he against whom we have sinned?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":24,"end":null,"start":false,"text":"For they would not walk in his ways,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":24,"end":null,"start":false,"text":"and they disobeyed his law."}]},{"kind":"poetry","indent":1,"runs":[{"verse":25,"end":null,"start":true,"text":"Therefore he poured the fierceness of his anger on him,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":25,"end":null,"start":false,"text":"and the strength of battle."}]},{"kind":"poetry","indent":1,"runs":[{"verse":25,"end":null,"start":false,"text":"It set him on fire all around, but he didn’t know."}]},{"kind":"poetry","indent":2,"runs":[{"verse":25,"end":null,"start":false,"text":"It burned him, but he didn’t take it to heart.”"}]}]}
