{"version":"web","book":"isaiah","chapter":48,"blocks":[{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"“Hear this, house of Jacob,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"you who are called by the name of Israel,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"and have come out of the waters of Judah."}]},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":false,"text":"You swear by the LORD’s name,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"and make mention of the God of Israel,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"but not in truth, nor in righteousness—"}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"for they call themselves citizens of the holy city,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"and rely on the God of Israel;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"the LORD of Armies is his name."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"I have declared the former things from of old."}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"Yes, they went out of my mouth, and I revealed them."}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"I did them suddenly, and they happened."}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"Because I knew that you are obstinate,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"and your neck is an iron sinew,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"and your brow bronze;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"therefore I have declared it to you from of old;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"before it came to pass I showed it to you;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"lest you should say, ‘My idol has done them."}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"My engraved image and my molten image has commanded them.’"}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"You have heard it."}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"Now see all this."}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"And you, won’t you declare it?"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":false,"text":"“I have shown you new things from this time,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"even hidden things, which you have not known."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"They are created now, and not from of old."}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"Before today, you didn’t hear them,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"lest you should say, ‘Behold, I knew them.’"}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"Yes, you didn’t hear."}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"Yes, you didn’t know."}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"Yes, from of old your ear was not opened,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":false,"text":"for I knew that you dealt very treacherously,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"and were called a transgressor from the womb."}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"For my name’s sake, I will defer my anger,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"and for my praise, I hold it back for you"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"so that I don’t cut you off."}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"Behold, I have refined you,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"but not as silver."}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"I have chosen you in the furnace of affliction."}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"For my own sake,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"for my own sake, I will do it;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":false,"text":"for how would my name be profaned?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"I will not give my glory to another."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"“Listen to me, O Jacob,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"and Israel my called:"}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":false,"text":"I am he."}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"I am the first."}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"I am also the last."}]},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":true,"text":"Yes, my hand has laid the foundation of the earth,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"and my right hand has spread out the heavens."}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"when I call to them, they stand up together."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":true,"text":"“Assemble yourselves, all of you, and hear!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"Who among them has declared these things?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":false,"text":"He whom the LORD loves will do what he likes to Babylon,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"and his arm will be against the Chaldeans."}]},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":true,"text":"I, even I, have spoken."}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"Yes, I have called him."}]},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":false,"text":"I have brought him"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"and he shall make his way prosperous."}]},{"kind":"paragraph","indent":0,"runs":[{"verse":16,"end":null,"start":true,"text":"“Come near to me and hear this:"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":false,"text":"“From the beginning I have not spoken in secret;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"from the time that it happened, I was there.”"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":false,"text":"Now the Lord GOD has sent me"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"with his Spirit."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":true,"text":"The LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"your Redeemer,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"the Holy One of Israel, says:"}]},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":false,"text":"“I am the LORD your God,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"who teaches you to profit,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"who leads you by the way that you should go."}]},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":true,"text":"Oh that you had listened to my commandments!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"Then your peace would have been like a river"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"and your righteousness like the waves of the sea."}]},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":true,"text":"Your offspring also would have been as the sand"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"and the descendants of your body like its grains."}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"His name would not be cut off nor destroyed from before me.”"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":true,"text":"Leave Babylon!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"Flee from the Chaldeans!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":false,"text":"With the sound of joyful shouting announce this,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"tell it even to the end of the earth;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"say, “The LORD has redeemed his servant Jacob!”"}]},{"kind":"poetry","indent":1,"runs":[{"verse":21,"end":null,"start":true,"text":"They didn’t thirst when he led them through the deserts."}]},{"kind":"poetry","indent":2,"runs":[{"verse":21,"end":null,"start":false,"text":"He caused the waters to flow out of the rock for them."}]},{"kind":"poetry","indent":2,"runs":[{"verse":21,"end":null,"start":false,"text":"He also split the rock and the waters gushed out."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":22,"end":null,"start":true,"text":"“There is no peace”, says the LORD, “for the wicked.”"}]}]}
