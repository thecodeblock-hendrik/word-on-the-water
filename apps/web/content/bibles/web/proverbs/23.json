{"version":"web","book":"proverbs","chapter":23,"blocks":[{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"When you sit to eat with a ruler,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"consider diligently what is before you;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"put a knife to your throat"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"if you are a man given to appetite."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"Don’t be desirous of his dainties,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"since they are deceitful food."}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"Don’t weary yourself to be rich."}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"In your wisdom, show restraint."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"Why do you set your eyes on that which is not?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"For it certainly sprouts wings like an eagle and flies in the sky."}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"Don’t eat the food of him who has a stingy eye,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"and don’t crave his delicacies,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":true,"text":"for as he thinks about the cost, so he is."}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"“Eat and drink!” he says to you,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"but his heart is not with you."}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"You will vomit up the morsel which you have eaten"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"and waste your pleasant words."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"Don’t speak in the ears of a fool,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"for he will despise the wisdom of your words."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"Don’t move the ancient boundary stone."}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"Don’t encroach on the fields of the fatherless,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"for their Defender is strong."}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"He will plead their case against you."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"Apply your heart to instruction,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"and your ears to the words of knowledge."}]},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":true,"text":"Don’t withhold correction from a child."}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"If you punish him with the rod, he will not die."}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":true,"text":"Punish him with the rod,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"and save his soul from Sheol."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":true,"text":"My son, if your heart is wise,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"then my heart will be glad, even mine."}]},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":true,"text":"Yes, my heart will rejoice"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"when your lips speak what is right."}]},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":true,"text":"Don’t let your heart envy sinners,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"but rather fear the LORD all day long."}]},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":true,"text":"Indeed surely there is a future hope,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"and your hope will not be cut off."}]},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":true,"text":"Listen, my son, and be wise,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"and keep your heart on the right path!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":true,"text":"Don’t be among ones drinking too much wine,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"or those who gorge themselves on meat;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":21,"end":null,"start":true,"text":"for the drunkard and the glutton shall become poor;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":21,"end":null,"start":false,"text":"and drowsiness clothes them in rags."}]},{"kind":"poetry","indent":1,"runs":[{"verse":22,"end":null,"start":true,"text":"Listen to your father who gave you life,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":22,"end":null,"start":false,"text":"and don’t despise your mother when she is old."}]},{"kind":"poetry","indent":1,"runs":[{"verse":23,"end":null,"start":true,"text":"Buy the truth, and don’t sell it."}]},{"kind":"poetry","indent":2,"runs":[{"verse":23,"end":null,"start":false,"text":"Get wisdom, discipline, and understanding."}]},{"kind":"poetry","indent":1,"runs":[{"verse":24,"end":null,"start":true,"text":"The father of the righteous has great joy."}]},{"kind":"poetry","indent":2,"runs":[{"verse":24,"end":null,"start":false,"text":"Whoever fathers a wise child delights in him."}]},{"kind":"poetry","indent":1,"runs":[{"verse":25,"end":null,"start":true,"text":"Let your father and your mother be glad!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":25,"end":null,"start":false,"text":"Let her who bore you rejoice!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":26,"end":null,"start":true,"text":"My son, give me your heart;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":26,"end":null,"start":false,"text":"and let your eyes keep in my ways."}]},{"kind":"poetry","indent":1,"runs":[{"verse":27,"end":null,"start":true,"text":"For a prostitute is a deep pit;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":27,"end":null,"start":false,"text":"and a wayward wife is a narrow well."}]},{"kind":"poetry","indent":1,"runs":[{"verse":28,"end":null,"start":true,"text":"Yes, she lies in wait like a robber,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":28,"end":null,"start":false,"text":"and increases the unfaithful among men."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":29,"end":null,"start":true,"text":"Who has woe?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":29,"end":null,"start":false,"text":"Who has sorrow?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":29,"end":null,"start":false,"text":"Who has strife?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":29,"end":null,"start":false,"text":"Who has complaints?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":29,"end":null,"start":false,"text":"Who has needless bruises?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":29,"end":null,"start":false,"text":"Who has bloodshot eyes?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":30,"end":null,"start":true,"text":"Those who stay long at the wine;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":30,"end":null,"start":false,"text":"those who go to seek out mixed wine."}]},{"kind":"poetry","indent":1,"runs":[{"verse":31,"end":null,"start":true,"text":"Don’t look at the wine when it is red,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":31,"end":null,"start":false,"text":"when it sparkles in the cup,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":31,"end":null,"start":false,"text":"when it goes down smoothly."}]},{"kind":"poetry","indent":1,"runs":[{"verse":32,"end":null,"start":true,"text":"In the end, it bites like a snake,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":32,"end":null,"start":false,"text":"and poisons like a viper."}]},{"kind":"poetry","indent":1,"runs":[{"verse":33,"end":null,"start":true,"text":"Your eyes will see strange things,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":33,"end":null,"start":false,"text":"and your mind will imagine confusing things."}]},{"kind":"poetry","indent":1,"runs":[{"verse":34,"end":null,"start":true,"text":"Yes, you will be as he who lies down in the middle of the sea,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":34,"end":null,"start":false,"text":"or as he who lies on top of the rigging:"}]},{"kind":"poetry","indent":1,"runs":[{"verse":35,"end":null,"start":true,"text":"“They hit me, and I was not hurt!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":35,"end":null,"start":false,"text":"They beat me, and I don’t feel it!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":35,"end":null,"start":false,"text":"When will I wake up? I can do it again."}]},{"kind":"poetry","indent":2,"runs":[{"verse":35,"end":null,"start":false,"text":"I will look for more.”"}]},{"kind":"break"}]}
