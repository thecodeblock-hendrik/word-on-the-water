{"version":"web","book":"song-of-solomon","chapter":8,"blocks":[{"kind":"paragraph","indent":0,"runs":[{"verse":1,"end":null,"start":true,"text":"Oh that you were like my brother,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"who nursed from the breasts of my mother!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":false,"text":"If I found you outside, I would kiss you;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"yes, and no one would despise me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"I would lead you, bringing you into the house of my mother,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"who would instruct me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":false,"text":"I would have you drink spiced wine,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"of the juice of my pomegranate."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"His left hand would be under my head."}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"His right hand would embrace me."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"I adjure you, daughters of Jerusalem,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"that you not stir up, nor awaken love,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"until it so desires."}]},{"kind":"label","text":"Friends"},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"Who is this who comes up from the wilderness,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"leaning on her beloved?"}]},{"kind":"break"},{"kind":"label","text":"Beloved"},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":false,"text":"Under the apple tree I awakened you."}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"There your mother conceived you."}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"There she was in labor and bore you."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"Set me as a seal on your heart,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"as a seal on your arm;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"for love is strong as death."}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"Jealousy is as cruel as Sheol."}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"Its flashes are flashes of fire,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"a very flame of the LORD."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"Many waters can’t quench love,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"neither can floods drown it."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":false,"text":"If a man would give all the wealth of his house for love,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"he would be utterly scorned."}]},{"kind":"label","text":"Brothers"},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"We have a little sister."}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"She has no breasts."}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":false,"text":"What shall we do for our sister"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"in the day when she is to be spoken for?"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"If she is a wall,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"we will build on her a turret of silver."}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":false,"text":"If she is a door,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"we will enclose her with boards of cedar."}]},{"kind":"label","text":"Beloved"},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"I am a wall, and my breasts like towers,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"then I was in his eyes like one who found peace."}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"Solomon had a vineyard at Baal Hamon."}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"He leased out the vineyard to keepers."}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"Each was to bring a thousand shekels of silver for its fruit."}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"My own vineyard is before me."}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"The thousand are for you, Solomon,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"two hundred for those who tend its fruit."}]},{"kind":"label","text":"Lover"},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":true,"text":"You who dwell in the gardens, with friends in attendance,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"let me hear your voice!"}]},{"kind":"label","text":"Beloved"},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":true,"text":"Come away, my beloved!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"Be like a gazelle or a young stag on the mountains of spices!"}]}]}
