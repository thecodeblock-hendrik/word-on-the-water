{"version":"web","book":"song-of-solomon","chapter":6,"blocks":[{"kind":"label","text":"Friends"},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"Where has your beloved gone, you fairest among women?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"Where has your beloved turned, that we may seek him with you?"}]},{"kind":"label","text":"Beloved"},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"My beloved has gone down to his garden,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"to the beds of spices,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"to pasture his flock in the gardens, and to gather lilies."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"I am my beloved’s, and my beloved is mine."}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"He browses among the lilies."}]},{"kind":"break"},{"kind":"label","text":"Lover"},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"You are beautiful, my love, as Tirzah,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"lovely as Jerusalem,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"awesome as an army with banners."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"Turn away your eyes from me,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"for they have overcome me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":false,"text":"Your hair is like a flock of goats,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"that lie along the side of Gilead."}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"Your teeth are like a flock of ewes,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"which have come up from the washing,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"of which every one has twins;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"not one is bereaved among them."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"Your temples are like a piece of a pomegranate behind your veil."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"There are sixty queens, eighty concubines,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"and virgins without number."}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"My dove, my perfect one, is unique."}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"She is her mother’s only daughter."}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"She is the favorite one of her who bore her."}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":false,"text":"The daughters saw her, and called her blessed."}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"The queens and the concubines saw her, and they praised her."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"Who is she who looks out as the morning,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"beautiful as the moon,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"clear as the sun,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"and awesome as an army with banners?"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"I went down into the nut tree grove,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"to see the green plants of the valley,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"to see whether the vine budded,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"and the pomegranates were in flower."}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"Without realizing it,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"my desire set me with my royal people’s chariots."}]},{"kind":"label","text":"Friends"},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":true,"text":"Return, return, Shulammite!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"Return, return, that we may gaze at you."}]},{"kind":"label","text":"Lover"},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":false,"text":"Why do you desire to gaze at the Shulammite,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"as at the dance of Mahanaim?"}]}]}
