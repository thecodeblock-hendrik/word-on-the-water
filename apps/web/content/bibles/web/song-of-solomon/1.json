{"version":"web","book":"song-of-solomon","chapter":1,"blocks":[{"kind":"paragraph","indent":0,"runs":[{"verse":1,"end":null,"start":true,"text":"The Song of songs, which is Solomon’s."}]},{"kind":"label","text":"Beloved"},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"Let him kiss me with the kisses of his mouth;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"for your love is better than wine."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"Your oils have a pleasing fragrance."}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"Your name is oil poured out,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"therefore the virgins love you."}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"Take me away with you."}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"Let’s hurry."}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"The king has brought me into his rooms."}]},{"kind":"label","text":"Friends"},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":false,"text":"We will be glad and rejoice in you."}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"We will praise your love more than wine!"}]},{"kind":"label","text":"Beloved"},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":false,"text":"They are right to love you."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"I am dark, but lovely,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"you daughters of Jerusalem,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"like Kedar’s tents,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"like Solomon’s curtains."}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"Don’t stare at me because I am dark,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"because the sun has scorched me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":false,"text":"My mother’s sons were angry with me."}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"They made me keeper of the vineyards."}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"I haven’t kept my own vineyard."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"Tell me, you whom my soul loves,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"where you graze your flock,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"where you rest them at noon;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"for why should I be as one who is veiled"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"beside the flocks of your companions?"}]},{"kind":"label","text":"Lover"},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"If you don’t know, most beautiful among women,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"follow the tracks of the sheep."}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"Graze your young goats beside the shepherds’ tents."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"I have compared you, my love,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"to a steed in Pharaoh’s chariots."}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"Your cheeks are beautiful with earrings,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"your neck with strings of jewels."}]},{"kind":"label","text":"Friends"},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"We will make you earrings of gold,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"with studs of silver."}]},{"kind":"label","text":"Beloved"},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"While the king sat at his table,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"my perfume spread its fragrance."}]},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":true,"text":"My beloved is to me a sachet of myrrh,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"that lies between my breasts."}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":true,"text":"My beloved is to me a cluster of henna blossoms"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"from the vineyards of En Gedi."}]},{"kind":"label","text":"Lover"},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":true,"text":"Behold, you are beautiful, my love."}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"Behold, you are beautiful."}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"Your eyes are like doves."}]},{"kind":"label","text":"Beloved"},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":true,"text":"Behold, you are beautiful, my beloved, yes, pleasant;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"and our couch is verdant."}]},{"kind":"label","text":"Lover"},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":true,"text":"The beams of our house are cedars."}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"Our rafters are firs."}]}]}
