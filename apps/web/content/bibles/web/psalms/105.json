{"version":"web","book":"psalms","chapter":105,"blocks":[{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"Give thanks to the LORD! Call on his name!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"Make his doings known among the peoples."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"Sing to him, sing praises to him!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"Tell of all his marvelous works."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"Glory in his holy name."}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"Let the heart of those who seek the LORD rejoice."}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"Seek the LORD and his strength."}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"Seek his face forever more."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"Remember his marvelous works that he has done:"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"his wonders, and the judgments of his mouth,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"you offspring of Abraham, his servant,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"you children of Jacob, his chosen ones."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"He is the LORD, our God."}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"His judgments are in all the earth."}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"He has remembered his covenant forever,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"the word which he commanded to a thousand generations,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"the covenant which he made with Abraham,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"his oath to Isaac,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"and confirmed it to Jacob for a statute;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"to Israel for an everlasting covenant,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"saying, “To you I will give the land of Canaan,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"the lot of your inheritance,”"}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"when they were but a few men in number,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"yes, very few, and foreigners in it."}]},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":true,"text":"They went about from nation to nation,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"from one kingdom to another people."}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":true,"text":"He allowed no one to do them wrong."}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"Yes, he reproved kings for their sakes,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":true,"text":"“Don’t touch my anointed ones!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"Do my prophets no harm!”"}]},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":true,"text":"He called for a famine on the land."}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"He destroyed the food supplies."}]},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":true,"text":"He sent a man before them."}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"Joseph was sold for a slave."}]},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":true,"text":"They bruised his feet with shackles."}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"His neck was locked in irons,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":true,"text":"until the time that his word happened,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"and the LORD’s word proved him true."}]},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":true,"text":"The king sent and freed him,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"even the ruler of peoples, and let him go free."}]},{"kind":"poetry","indent":1,"runs":[{"verse":21,"end":null,"start":true,"text":"He made him lord of his house,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":21,"end":null,"start":false,"text":"and ruler of all of his possessions,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":22,"end":null,"start":true,"text":"to discipline his princes at his pleasure,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":22,"end":null,"start":false,"text":"and to teach his elders wisdom."}]},{"kind":"poetry","indent":1,"runs":[{"verse":23,"end":null,"start":true,"text":"Israel also came into Egypt."}]},{"kind":"poetry","indent":2,"runs":[{"verse":23,"end":null,"start":false,"text":"Jacob lived in the land of Ham."}]},{"kind":"poetry","indent":1,"runs":[{"verse":24,"end":null,"start":true,"text":"He increased his people greatly,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":24,"end":null,"start":false,"text":"and made them stronger than their adversaries."}]},{"kind":"poetry","indent":1,"runs":[{"verse":25,"end":null,"start":true,"text":"He turned their heart to hate his people,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":25,"end":null,"start":false,"text":"to conspire against his servants."}]},{"kind":"poetry","indent":1,"runs":[{"verse":26,"end":null,"start":true,"text":"He sent Moses, his servant,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":26,"end":null,"start":false,"text":"and Aaron, whom he had chosen."}]},{"kind":"poetry","indent":1,"runs":[{"verse":27,"end":null,"start":true,"text":"They performed miracles among them,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":27,"end":null,"start":false,"text":"and wonders in the land of Ham."}]},{"kind":"poetry","indent":1,"runs":[{"verse":28,"end":null,"start":true,"text":"He sent darkness, and made it dark."}]},{"kind":"poetry","indent":2,"runs":[{"verse":28,"end":null,"start":false,"text":"They didn’t rebel against his words."}]},{"kind":"poetry","indent":1,"runs":[{"verse":29,"end":null,"start":true,"text":"He turned their waters into blood,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":29,"end":null,"start":false,"text":"and killed their fish."}]},{"kind":"poetry","indent":1,"runs":[{"verse":30,"end":null,"start":true,"text":"Their land swarmed with frogs,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":30,"end":null,"start":false,"text":"even in the rooms of their kings."}]},{"kind":"poetry","indent":1,"runs":[{"verse":31,"end":null,"start":true,"text":"He spoke, and swarms of flies came,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":31,"end":null,"start":false,"text":"and lice in all their borders."}]},{"kind":"poetry","indent":1,"runs":[{"verse":32,"end":null,"start":true,"text":"He gave them hail for rain,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":32,"end":null,"start":false,"text":"with lightning in their land."}]},{"kind":"poetry","indent":1,"runs":[{"verse":33,"end":null,"start":true,"text":"He struck their vines and also their fig trees,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":33,"end":null,"start":false,"text":"and shattered the trees of their country."}]},{"kind":"poetry","indent":1,"runs":[{"verse":34,"end":null,"start":true,"text":"He spoke, and the locusts came"}]},{"kind":"poetry","indent":2,"runs":[{"verse":34,"end":null,"start":false,"text":"with the grasshoppers, without number."}]},{"kind":"poetry","indent":1,"runs":[{"verse":35,"end":null,"start":true,"text":"They ate up every plant in their land,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":35,"end":null,"start":false,"text":"and ate up the fruit of their ground."}]},{"kind":"poetry","indent":1,"runs":[{"verse":36,"end":null,"start":true,"text":"He struck also all the firstborn in their land,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":36,"end":null,"start":false,"text":"the first fruits of all their manhood."}]},{"kind":"poetry","indent":1,"runs":[{"verse":37,"end":null,"start":true,"text":"He brought them out with silver and gold."}]},{"kind":"poetry","indent":2,"runs":[{"verse":37,"end":null,"start":false,"text":"There was not one feeble person among his tribes."}]},{"kind":"poetry","indent":1,"runs":[{"verse":38,"end":null,"start":true,"text":"Egypt was glad when they departed,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":38,"end":null,"start":false,"text":"for the fear of them had fallen on them."}]},{"kind":"poetry","indent":1,"runs":[{"verse":39,"end":null,"start":true,"text":"He spread a cloud for a covering,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":39,"end":null,"start":false,"text":"fire to give light in the night."}]},{"kind":"poetry","indent":1,"runs":[{"verse":40,"end":null,"start":true,"text":"They asked, and he brought quails,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":40,"end":null,"start":false,"text":"and satisfied them with the bread of the sky."}]},{"kind":"poetry","indent":1,"runs":[{"verse":41,"end":null,"start":true,"text":"He opened the rock, and waters gushed out."}]},{"kind":"poetry","indent":2,"runs":[{"verse":41,"end":null,"start":false,"text":"They ran as a river in the dry places."}]},{"kind":"poetry","indent":1,"runs":[{"verse":42,"end":null,"start":true,"text":"For he remembered his holy word,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":42,"end":null,"start":false,"text":"and Abraham, his servant."}]},{"kind":"poetry","indent":1,"runs":[{"verse":43,"end":null,"start":true,"text":"He brought his people out with joy,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":43,"end":null,"start":false,"text":"his chosen with singing."}]},{"kind":"poetry","indent":1,"runs":[{"verse":44,"end":null,"start":true,"text":"He gave them the lands of the nations."}]},{"kind":"poetry","indent":2,"runs":[{"verse":44,"end":null,"start":false,"text":"They took the labor of the peoples in possession,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":45,"end":null,"start":true,"text":"that they might keep his statutes,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":45,"end":null,"start":false,"text":"and observe his laws."}]},{"kind":"poetry","indent":2,"runs":[{"verse":45,"end":null,"start":false,"text":"Praise the LORD!"}]}]}
