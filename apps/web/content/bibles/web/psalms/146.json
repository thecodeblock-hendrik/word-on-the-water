{"version":"web","book":"psalms","chapter":146,"blocks":[{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"Praise the LORD!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"Praise the LORD, my soul."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"While I live, I will praise the LORD."}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"I will sing praises to my God as long as I exist."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"Don’t put your trust in princes,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"in a son of man in whom there is no help."}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"His spirit departs, and he returns to the earth."}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"In that very day, his thoughts perish."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"Happy is he who has the God of Jacob for his help,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"whose hope is in the LORD, his God,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"who made heaven and earth,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"the sea, and all that is in them;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"who keeps truth forever;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"who executes justice for the oppressed;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"who gives food to the hungry."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":false,"text":"The LORD frees the prisoners."}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":true,"text":"The LORD opens the eyes of the blind."}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"The LORD raises up those who are bowed down."}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"The LORD loves the righteous."}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"The LORD preserves the foreigners."}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"He upholds the fatherless and widow,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"but he turns the way of the wicked upside down."}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"The LORD will reign forever;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"your God, O Zion, to all generations."}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":false,"text":"Praise the LORD!"}]},{"kind":"break"}]}
