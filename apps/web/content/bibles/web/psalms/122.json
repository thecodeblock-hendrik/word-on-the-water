{"version":"web","book":"psalms","chapter":122,"blocks":[{"kind":"title","text":"A Song of Ascents. By David."},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"I was glad when they said to me,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"“Let’s go to the LORD’s house!”"}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"Our feet are standing within your gates, Jerusalem!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":true,"text":"Jerusalem is built as a city that is compact together,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"where the tribes go up, even the LORD’s tribes,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"according to an ordinance for Israel,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"to give thanks to the LORD’s name."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"For there are set thrones for judgment,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"the thrones of David’s house."}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"Pray for the peace of Jerusalem."}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"Those who love you will prosper."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"Peace be within your walls,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"and prosperity within your palaces."}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"For my brothers’ and companions’ sakes,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"I will now say, “Peace be within you.”"}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"For the sake of the house of the LORD our God,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"I will seek your good."}]}]}
