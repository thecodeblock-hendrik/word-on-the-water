{"version":"web","book":"psalms","chapter":82,"blocks":[{"kind":"title","text":"A Psalm by Asaph."},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"God presides in the great assembly."}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"He judges among the gods."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"“How long will you judge unjustly,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"and show partiality to the wicked?” Selah."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"“Defend the weak, the poor, and the fatherless."}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"Maintain the rights of the poor and oppressed."}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"Rescue the weak and needy."}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"Deliver them out of the hand of the wicked.”"}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"They don’t know, neither do they understand."}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"They walk back and forth in darkness."}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"All the foundations of the earth are shaken."}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"I said, “You are gods,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"all of you are sons of the Most High."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"Nevertheless you shall die like men,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"and fall like one of the rulers.”"}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"Arise, God, judge the earth,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"for you inherit all of the nations."}]}]}
