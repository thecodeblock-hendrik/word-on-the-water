{"version":"web","book":"psalms","chapter":148,"blocks":[{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"Praise the LORD!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"Praise the LORD from the heavens!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"Praise him in the heights!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"Praise him, all his angels!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"Praise him, all his army!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"Praise him, sun and moon!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"Praise him, all you shining stars!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"Praise him, you heavens of heavens,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"you waters that are above the heavens."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"Let them praise the LORD’s name,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"for he commanded, and they were created."}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"He has also established them forever and ever."}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"He has made a decree which will not pass away."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"Praise the LORD from the earth,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"you great sea creatures, and all depths,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"lightning and hail, snow and clouds,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"stormy wind, fulfilling his word,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"mountains and all hills,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"fruit trees and all cedars,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"wild animals and all livestock,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"small creatures and flying birds,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"kings of the earth and all peoples,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"princes and all judges of the earth,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"both young men and maidens,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"old men and children."}]},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":true,"text":"Let them praise the LORD’s name,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"for his name alone is exalted."}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"His glory is above the earth and the heavens."}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":true,"text":"He has lifted up the horn of his people,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"the praise of all his saints,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"even of the children of Israel, a people near to him."}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":false,"text":"Praise the LORD!"}]},{"kind":"break"}]}
