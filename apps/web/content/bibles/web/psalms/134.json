{"version":"web","book":"psalms","chapter":134,"blocks":[{"kind":"title","text":"A Song of Ascents."},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"Look! Praise the LORD, all you servants of the LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"who stand by night in the LORD’s house!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"Lift up your hands in the sanctuary."}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"Praise the LORD!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"May the LORD bless you from Zion,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"even he who made heaven and earth."}]}]}
