{"version":"web","book":"psalms","chapter":100,"blocks":[{"kind":"title","text":"A Psalm of thanksgiving."},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"Shout for joy to the LORD, all you lands!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":true,"text":"Serve the LORD with gladness."}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"Come before his presence with singing."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"Know that the LORD, he is God."}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"It is he who has made us, and we are his."}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"We are his people, and the sheep of his pasture."}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"Enter into his gates with thanksgiving,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"and into his courts with praise."}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"Give thanks to him, and bless his name."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"For the LORD is good."}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"His loving kindness endures forever,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"his faithfulness to all generations."}]}]}
