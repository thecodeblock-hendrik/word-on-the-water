{"version":"web","book":"psalms","chapter":120,"blocks":[{"kind":"title","text":"A Song of Ascents."},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"In my distress, I cried to the LORD."}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"He answered me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"Deliver my soul, LORD, from lying lips,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"from a deceitful tongue."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"What will be given to you, and what will be done more to you,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"you deceitful tongue?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"Sharp arrows of the mighty,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"with coals of juniper."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"Woe is me, that I live in Meshech,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"that I dwell among the tents of Kedar!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"My soul has had her dwelling too long"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"with him who hates peace."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"I am for peace,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"but when I speak, they are for war."}]}]}
