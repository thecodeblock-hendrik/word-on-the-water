{"version":"web","book":"psalms","chapter":115,"blocks":[{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"Not to us, LORD, not to us,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"but to your name give glory,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"for your loving kindness, and for your truth’s sake."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"Why should the nations say,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"“Where is their God, now?”"}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"But our God is in the heavens."}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"He does whatever he pleases."}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"Their idols are silver and gold,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"the work of men’s hands."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"They have mouths, but they don’t speak."}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"They have eyes, but they don’t see."}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"They have ears, but they don’t hear."}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"They have noses, but they don’t smell."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"They have hands, but they don’t feel."}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"They have feet, but they don’t walk,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"neither do they speak through their throat."}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"Those who make them will be like them;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"yes, everyone who trusts in them."}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"Israel, trust in the LORD!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"He is their help and their shield."}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"House of Aaron, trust in the LORD!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"He is their help and their shield."}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"You who fear the LORD, trust in the LORD!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"He is their help and their shield."}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"The LORD remembers us. He will bless us."}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"He will bless the house of Israel."}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"He will bless the house of Aaron."}]},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":true,"text":"He will bless those who fear the LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"both small and great."}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":true,"text":"May the LORD increase you more and more,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"you and your children."}]},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":true,"text":"Blessed are you by the LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"who made heaven and earth."}]},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":true,"text":"The heavens are the LORD’s heavens,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"but he has given the earth to the children of men."}]},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":true,"text":"The dead don’t praise the LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"nor any who go down into silence,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":true,"text":"but we will bless the LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"from this time forward and forever more."}]},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":false,"text":"Praise the LORD!"}]}]}
