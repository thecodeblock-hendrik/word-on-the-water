{"version":"web","book":"psalms","chapter":70,"blocks":[{"kind":"title","text":"For the Chief Musician. By David. A reminder."},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"Hurry, God, to deliver me."}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"Come quickly to help me, LORD."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"Let them be disappointed and confounded who seek my soul."}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"Let those who desire my ruin be turned back in disgrace."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"Let them be turned because of their shame"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"who say, “Aha! Aha!”"}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"Let all those who seek you rejoice and be glad in you."}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"Let those who love your salvation continually say,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"“Let God be exalted!”"}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"But I am poor and needy."}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"Come to me quickly, God."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":false,"text":"You are my help and my deliverer."}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"LORD, don’t delay."}]},{"kind":"break"}]}
