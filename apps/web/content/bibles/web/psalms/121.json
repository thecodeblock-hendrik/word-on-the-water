{"version":"web","book":"psalms","chapter":121,"blocks":[{"kind":"title","text":"A Song of Ascents."},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"I will lift up my eyes to the hills."}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"Where does my help come from?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"My help comes from the LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"who made heaven and earth."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"He will not allow your foot to be moved."}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"He who keeps you will not slumber."}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"Behold, he who keeps Israel"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"will neither slumber nor sleep."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"The LORD is your keeper."}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"The LORD is your shade on your right hand."}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"The sun will not harm you by day,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"nor the moon by night."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"The LORD will keep you from all evil."}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"He will keep your soul."}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"The LORD will keep your going out and your coming in,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"from this time forward, and forever more."}]}]}
