{"version":"web","book":"psalms","chapter":124,"blocks":[{"kind":"title","text":"A Song of Ascents. By David."},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"If it had not been the LORD who was on our side,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"let Israel now say,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"if it had not been the LORD who was on our side,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"when men rose up against us,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"then they would have swallowed us up alive,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"when their wrath was kindled against us,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"then the waters would have overwhelmed us,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"the stream would have gone over our soul."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"Then the proud waters would have gone over our soul."}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"Blessed be the LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"who has not given us as a prey to their teeth."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"Our soul has escaped like a bird out of the fowler’s snare."}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"The snare is broken, and we have escaped."}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"Our help is in the LORD’s name,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"who made heaven and earth."}]}]}
