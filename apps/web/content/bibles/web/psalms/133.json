{"version":"web","book":"psalms","chapter":133,"blocks":[{"kind":"title","text":"A Song of Ascents. By David."},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"See how good and how pleasant it is"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"for brothers to live together in unity!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"It is like the precious oil on the head,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"that ran down on the beard,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"even Aaron’s beard,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"that came down on the edge of his robes,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"like the dew of Hermon,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"that comes down on the hills of Zion;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"for there the LORD gives the blessing,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"even life forever more."}]}]}
