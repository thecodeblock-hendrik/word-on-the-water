{"version":"web","book":"psalms","chapter":127,"blocks":[{"kind":"title","text":"A Song of Ascents. By Solomon."},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"Unless the LORD builds the house,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"they who build it labor in vain."}]},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":false,"text":"Unless the LORD watches over the city,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"the watchman guards it in vain."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"It is vain for you to rise up early,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"to stay up late,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"eating the bread of toil,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"for he gives sleep to his loved ones."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"Behold, children are a heritage of the LORD."}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"The fruit of the womb is his reward."}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"As arrows in the hand of a mighty man,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"so are the children of youth."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"Happy is the man who has his quiver full of them."}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"They won’t be disappointed when they speak with their enemies in the gate."}]}]}
