{"version":"web","book":"psalms","chapter":119,"blocks":[{"kind":"title","text":"ALEPH"},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"Blessed are those whose ways are blameless,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"who walk according to the LORD’s law."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"Blessed are those who keep his statutes,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"who seek him with their whole heart."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"Yes, they do nothing wrong."}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"They walk in his ways."}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"You have commanded your precepts,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"that we should fully obey them."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"Oh that my ways were steadfast"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"to obey your statutes!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"Then I wouldn’t be disappointed,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"when I consider all of your commandments."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"I will give thanks to you with uprightness of heart,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"when I learn your righteous judgments."}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"I will observe your statutes."}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"Don’t utterly forsake me."}]},{"kind":"title","text":"BETH"},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"How can a young man keep his way pure?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"By living according to your word."}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"With my whole heart I have sought you."}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"Don’t let me wander from your commandments."}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"I have hidden your word in my heart,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"that I might not sin against you."}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"Blessed are you, LORD."}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"Teach me your statutes."}]},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":true,"text":"With my lips,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"I have declared all the ordinances of your mouth."}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":true,"text":"I have rejoiced in the way of your testimonies,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"as much as in all riches."}]},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":true,"text":"I will meditate on your precepts,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"and consider your ways."}]},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":true,"text":"I will delight myself in your statutes."}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"I will not forget your word."}]},{"kind":"title","text":"GIMEL"},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":true,"text":"Do good to your servant."}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"I will live and I will obey your word."}]},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":true,"text":"Open my eyes,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"that I may see wondrous things out of your law."}]},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":true,"text":"I am a stranger on the earth."}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"Don’t hide your commandments from me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":true,"text":"My soul is consumed with longing for your ordinances at all times."}]},{"kind":"poetry","indent":1,"runs":[{"verse":21,"end":null,"start":true,"text":"You have rebuked the proud who are cursed,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":21,"end":null,"start":false,"text":"who wander from your commandments."}]},{"kind":"poetry","indent":1,"runs":[{"verse":22,"end":null,"start":true,"text":"Take reproach and contempt away from me,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":22,"end":null,"start":false,"text":"for I have kept your statutes."}]},{"kind":"poetry","indent":1,"runs":[{"verse":23,"end":null,"start":true,"text":"Though princes sit and slander me,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":23,"end":null,"start":false,"text":"your servant will meditate on your statutes."}]},{"kind":"poetry","indent":1,"runs":[{"verse":24,"end":null,"start":true,"text":"Indeed your statutes are my delight,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":24,"end":null,"start":false,"text":"and my counselors."}]},{"kind":"title","text":"DALETH"},{"kind":"poetry","indent":1,"runs":[{"verse":25,"end":null,"start":true,"text":"My soul is laid low in the dust."}]},{"kind":"poetry","indent":2,"runs":[{"verse":25,"end":null,"start":false,"text":"Revive me according to your word!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":26,"end":null,"start":true,"text":"I declared my ways, and you answered me."}]},{"kind":"poetry","indent":2,"runs":[{"verse":26,"end":null,"start":false,"text":"Teach me your statutes."}]},{"kind":"poetry","indent":1,"runs":[{"verse":27,"end":null,"start":true,"text":"Let me understand the teaching of your precepts!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":27,"end":null,"start":false,"text":"Then I will meditate on your wondrous works."}]},{"kind":"poetry","indent":1,"runs":[{"verse":28,"end":null,"start":true,"text":"My soul is weary with sorrow;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":28,"end":null,"start":false,"text":"strengthen me according to your word."}]},{"kind":"poetry","indent":1,"runs":[{"verse":29,"end":null,"start":true,"text":"Keep me from the way of deceit."}]},{"kind":"poetry","indent":2,"runs":[{"verse":29,"end":null,"start":false,"text":"Grant me your law graciously!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":30,"end":null,"start":true,"text":"I have chosen the way of truth."}]},{"kind":"poetry","indent":2,"runs":[{"verse":30,"end":null,"start":false,"text":"I have set your ordinances before me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":31,"end":null,"start":true,"text":"I cling to your statutes, LORD."}]},{"kind":"poetry","indent":2,"runs":[{"verse":31,"end":null,"start":false,"text":"Don’t let me be disappointed."}]},{"kind":"poetry","indent":1,"runs":[{"verse":32,"end":null,"start":true,"text":"I run in the path of your commandments,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":32,"end":null,"start":false,"text":"for you have set my heart free."}]},{"kind":"title","text":"HE"},{"kind":"poetry","indent":1,"runs":[{"verse":33,"end":null,"start":true,"text":"Teach me, LORD, the way of your statutes."}]},{"kind":"poetry","indent":2,"runs":[{"verse":33,"end":null,"start":false,"text":"I will keep them to the end."}]},{"kind":"poetry","indent":1,"runs":[{"verse":34,"end":null,"start":true,"text":"Give me understanding, and I will keep your law."}]},{"kind":"poetry","indent":2,"runs":[{"verse":34,"end":null,"start":false,"text":"Yes, I will obey it with my whole heart."}]},{"kind":"poetry","indent":1,"runs":[{"verse":35,"end":null,"start":true,"text":"Direct me in the path of your commandments,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":35,"end":null,"start":false,"text":"for I delight in them."}]},{"kind":"poetry","indent":1,"runs":[{"verse":36,"end":null,"start":true,"text":"Turn my heart toward your statutes,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":36,"end":null,"start":false,"text":"not toward selfish gain."}]},{"kind":"poetry","indent":1,"runs":[{"verse":37,"end":null,"start":true,"text":"Turn my eyes away from looking at worthless things."}]},{"kind":"poetry","indent":2,"runs":[{"verse":37,"end":null,"start":false,"text":"Revive me in your ways."}]},{"kind":"poetry","indent":1,"runs":[{"verse":38,"end":null,"start":true,"text":"Fulfill your promise to your servant,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":38,"end":null,"start":false,"text":"that you may be feared."}]},{"kind":"poetry","indent":1,"runs":[{"verse":39,"end":null,"start":true,"text":"Take away my disgrace that I dread,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":39,"end":null,"start":false,"text":"for your ordinances are good."}]},{"kind":"poetry","indent":1,"runs":[{"verse":40,"end":null,"start":true,"text":"Behold, I long for your precepts!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":40,"end":null,"start":false,"text":"Revive me in your righteousness."}]},{"kind":"title","text":"VAV"},{"kind":"poetry","indent":1,"runs":[{"verse":41,"end":null,"start":true,"text":"Let your loving kindness also come to me, LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":41,"end":null,"start":false,"text":"your salvation, according to your word."}]},{"kind":"poetry","indent":1,"runs":[{"verse":42,"end":null,"start":true,"text":"So I will have an answer for him who reproaches me,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":42,"end":null,"start":false,"text":"for I trust in your word."}]},{"kind":"poetry","indent":1,"runs":[{"verse":43,"end":null,"start":true,"text":"Don’t snatch the word of truth out of my mouth,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":43,"end":null,"start":false,"text":"for I put my hope in your ordinances."}]},{"kind":"poetry","indent":1,"runs":[{"verse":44,"end":null,"start":true,"text":"So I will obey your law continually,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":44,"end":null,"start":false,"text":"forever and ever."}]},{"kind":"poetry","indent":1,"runs":[{"verse":45,"end":null,"start":true,"text":"I will walk in liberty,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":45,"end":null,"start":false,"text":"for I have sought your precepts."}]},{"kind":"poetry","indent":1,"runs":[{"verse":46,"end":null,"start":true,"text":"I will also speak of your statutes before kings,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":46,"end":null,"start":false,"text":"and will not be disappointed."}]},{"kind":"poetry","indent":1,"runs":[{"verse":47,"end":null,"start":true,"text":"I will delight myself in your commandments,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":47,"end":null,"start":false,"text":"because I love them."}]},{"kind":"poetry","indent":1,"runs":[{"verse":48,"end":null,"start":true,"text":"I reach out my hands for your commandments, which I love."}]},{"kind":"poetry","indent":2,"runs":[{"verse":48,"end":null,"start":false,"text":"I will meditate on your statutes."}]},{"kind":"title","text":"ZAYIN"},{"kind":"poetry","indent":1,"runs":[{"verse":49,"end":null,"start":true,"text":"Remember your word to your servant,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":49,"end":null,"start":false,"text":"because you gave me hope."}]},{"kind":"poetry","indent":1,"runs":[{"verse":50,"end":null,"start":true,"text":"This is my comfort in my affliction,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":50,"end":null,"start":false,"text":"for your word has revived me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":51,"end":null,"start":true,"text":"The arrogant mock me excessively,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":51,"end":null,"start":false,"text":"but I don’t swerve from your law."}]},{"kind":"poetry","indent":1,"runs":[{"verse":52,"end":null,"start":true,"text":"I remember your ordinances of old, LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":52,"end":null,"start":false,"text":"and have comforted myself."}]},{"kind":"poetry","indent":1,"runs":[{"verse":53,"end":null,"start":true,"text":"Indignation has taken hold on me,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":53,"end":null,"start":false,"text":"because of the wicked who forsake your law."}]},{"kind":"poetry","indent":1,"runs":[{"verse":54,"end":null,"start":true,"text":"Your statutes have been my songs"}]},{"kind":"poetry","indent":2,"runs":[{"verse":54,"end":null,"start":false,"text":"in the house where I live."}]},{"kind":"poetry","indent":1,"runs":[{"verse":55,"end":null,"start":true,"text":"I have remembered your name, LORD, in the night,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":55,"end":null,"start":false,"text":"and I obey your law."}]},{"kind":"poetry","indent":1,"runs":[{"verse":56,"end":null,"start":true,"text":"This is my way,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":56,"end":null,"start":false,"text":"that I keep your precepts."}]},{"kind":"title","text":"HETH"},{"kind":"poetry","indent":1,"runs":[{"verse":57,"end":null,"start":true,"text":"The LORD is my portion."}]},{"kind":"poetry","indent":2,"runs":[{"verse":57,"end":null,"start":false,"text":"I promised to obey your words."}]},{"kind":"poetry","indent":1,"runs":[{"verse":58,"end":null,"start":true,"text":"I sought your favor with my whole heart."}]},{"kind":"poetry","indent":2,"runs":[{"verse":58,"end":null,"start":false,"text":"Be merciful to me according to your word."}]},{"kind":"poetry","indent":1,"runs":[{"verse":59,"end":null,"start":true,"text":"I considered my ways,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":59,"end":null,"start":false,"text":"and turned my steps to your statutes."}]},{"kind":"poetry","indent":1,"runs":[{"verse":60,"end":null,"start":true,"text":"I will hurry, and not delay,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":60,"end":null,"start":false,"text":"to obey your commandments."}]},{"kind":"poetry","indent":1,"runs":[{"verse":61,"end":null,"start":true,"text":"The ropes of the wicked bind me,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":61,"end":null,"start":false,"text":"but I won’t forget your law."}]},{"kind":"poetry","indent":1,"runs":[{"verse":62,"end":null,"start":true,"text":"At midnight I will rise to give thanks to you,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":62,"end":null,"start":false,"text":"because of your righteous ordinances."}]},{"kind":"poetry","indent":1,"runs":[{"verse":63,"end":null,"start":true,"text":"I am a friend of all those who fear you,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":63,"end":null,"start":false,"text":"of those who observe your precepts."}]},{"kind":"poetry","indent":1,"runs":[{"verse":64,"end":null,"start":true,"text":"The earth is full of your loving kindness, LORD."}]},{"kind":"poetry","indent":2,"runs":[{"verse":64,"end":null,"start":false,"text":"Teach me your statutes."}]},{"kind":"title","text":"TETH"},{"kind":"poetry","indent":1,"runs":[{"verse":65,"end":null,"start":true,"text":"You have treated your servant well,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":65,"end":null,"start":false,"text":"according to your word, LORD."}]},{"kind":"poetry","indent":1,"runs":[{"verse":66,"end":null,"start":true,"text":"Teach me good judgment and knowledge,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":66,"end":null,"start":false,"text":"for I believe in your commandments."}]},{"kind":"poetry","indent":1,"runs":[{"verse":67,"end":null,"start":true,"text":"Before I was afflicted, I went astray;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":67,"end":null,"start":false,"text":"but now I observe your word."}]},{"kind":"poetry","indent":1,"runs":[{"verse":68,"end":null,"start":true,"text":"You are good, and do good."}]},{"kind":"poetry","indent":2,"runs":[{"verse":68,"end":null,"start":false,"text":"Teach me your statutes."}]},{"kind":"poetry","indent":1,"runs":[{"verse":69,"end":null,"start":true,"text":"The proud have smeared a lie upon me."}]},{"kind":"poetry","indent":2,"runs":[{"verse":69,"end":null,"start":false,"text":"With my whole heart, I will keep your precepts."}]},{"kind":"poetry","indent":1,"runs":[{"verse":70,"end":null,"start":true,"text":"Their heart is as callous as the fat,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":70,"end":null,"start":false,"text":"but I delight in your law."}]},{"kind":"poetry","indent":1,"runs":[{"verse":71,"end":null,"start":true,"text":"It is good for me that I have been afflicted,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":71,"end":null,"start":false,"text":"that I may learn your statutes."}]},{"kind":"poetry","indent":1,"runs":[{"verse":72,"end":null,"start":true,"text":"The law of your mouth is better to me than thousands of pieces of gold and silver."}]},{"kind":"title","text":"YODH"},{"kind":"poetry","indent":1,"runs":[{"verse":73,"end":null,"start":true,"text":"Your hands have made me and formed me."}]},{"kind":"poetry","indent":2,"runs":[{"verse":73,"end":null,"start":false,"text":"Give me understanding, that I may learn your commandments."}]},{"kind":"poetry","indent":1,"runs":[{"verse":74,"end":null,"start":true,"text":"Those who fear you will see me and be glad,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":74,"end":null,"start":false,"text":"because I have put my hope in your word."}]},{"kind":"poetry","indent":1,"runs":[{"verse":75,"end":null,"start":true,"text":"LORD, I know that your judgments are righteous,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":75,"end":null,"start":false,"text":"that in faithfulness you have afflicted me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":76,"end":null,"start":true,"text":"Please let your loving kindness be for my comfort,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":76,"end":null,"start":false,"text":"according to your word to your servant."}]},{"kind":"poetry","indent":1,"runs":[{"verse":77,"end":null,"start":true,"text":"Let your tender mercies come to me, that I may live;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":77,"end":null,"start":false,"text":"for your law is my delight."}]},{"kind":"poetry","indent":1,"runs":[{"verse":78,"end":null,"start":true,"text":"Let the proud be disappointed, for they have overthrown me wrongfully."}]},{"kind":"poetry","indent":2,"runs":[{"verse":78,"end":null,"start":false,"text":"I will meditate on your precepts."}]},{"kind":"poetry","indent":1,"runs":[{"verse":79,"end":null,"start":true,"text":"Let those who fear you turn to me."}]},{"kind":"poetry","indent":2,"runs":[{"verse":79,"end":null,"start":false,"text":"They will know your statutes."}]},{"kind":"poetry","indent":1,"runs":[{"verse":80,"end":null,"start":true,"text":"Let my heart be blameless toward your decrees,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":80,"end":null,"start":false,"text":"that I may not be disappointed."}]},{"kind":"title","text":"KAPF"},{"kind":"poetry","indent":1,"runs":[{"verse":81,"end":null,"start":true,"text":"My soul faints for your salvation."}]},{"kind":"poetry","indent":2,"runs":[{"verse":81,"end":null,"start":false,"text":"I hope in your word."}]},{"kind":"poetry","indent":1,"runs":[{"verse":82,"end":null,"start":true,"text":"My eyes fail for your word."}]},{"kind":"poetry","indent":2,"runs":[{"verse":82,"end":null,"start":false,"text":"I say, “When will you comfort me?”"}]},{"kind":"poetry","indent":1,"runs":[{"verse":83,"end":null,"start":true,"text":"For I have become like a wineskin in the smoke."}]},{"kind":"poetry","indent":2,"runs":[{"verse":83,"end":null,"start":false,"text":"I don’t forget your statutes."}]},{"kind":"poetry","indent":1,"runs":[{"verse":84,"end":null,"start":true,"text":"How many are the days of your servant?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":84,"end":null,"start":false,"text":"When will you execute judgment on those who persecute me?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":85,"end":null,"start":true,"text":"The proud have dug pits for me,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":85,"end":null,"start":false,"text":"contrary to your law."}]},{"kind":"poetry","indent":1,"runs":[{"verse":86,"end":null,"start":true,"text":"All of your commandments are faithful."}]},{"kind":"poetry","indent":2,"runs":[{"verse":86,"end":null,"start":false,"text":"They persecute me wrongfully."}]},{"kind":"poetry","indent":2,"runs":[{"verse":86,"end":null,"start":false,"text":"Help me!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":87,"end":null,"start":true,"text":"They had almost wiped me from the earth,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":87,"end":null,"start":false,"text":"but I didn’t forsake your precepts."}]},{"kind":"poetry","indent":1,"runs":[{"verse":88,"end":null,"start":true,"text":"Preserve my life according to your loving kindness,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":88,"end":null,"start":false,"text":"so I will obey the statutes of your mouth."}]},{"kind":"title","text":"LAMEDH"},{"kind":"poetry","indent":1,"runs":[{"verse":89,"end":null,"start":true,"text":"LORD, your word is settled in heaven forever."}]},{"kind":"poetry","indent":1,"runs":[{"verse":90,"end":null,"start":true,"text":"Your faithfulness is to all generations."}]},{"kind":"poetry","indent":2,"runs":[{"verse":90,"end":null,"start":false,"text":"You have established the earth, and it remains."}]},{"kind":"poetry","indent":1,"runs":[{"verse":91,"end":null,"start":true,"text":"Your laws remain to this day,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":91,"end":null,"start":false,"text":"for all things serve you."}]},{"kind":"poetry","indent":1,"runs":[{"verse":92,"end":null,"start":true,"text":"Unless your law had been my delight,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":92,"end":null,"start":false,"text":"I would have perished in my affliction."}]},{"kind":"poetry","indent":1,"runs":[{"verse":93,"end":null,"start":true,"text":"I will never forget your precepts,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":93,"end":null,"start":false,"text":"for with them, you have revived me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":94,"end":null,"start":true,"text":"I am yours."}]},{"kind":"poetry","indent":2,"runs":[{"verse":94,"end":null,"start":false,"text":"Save me, for I have sought your precepts."}]},{"kind":"poetry","indent":1,"runs":[{"verse":95,"end":null,"start":true,"text":"The wicked have waited for me, to destroy me."}]},{"kind":"poetry","indent":2,"runs":[{"verse":95,"end":null,"start":false,"text":"I will consider your statutes."}]},{"kind":"poetry","indent":1,"runs":[{"verse":96,"end":null,"start":true,"text":"I have seen a limit to all perfection,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":96,"end":null,"start":false,"text":"but your commands are boundless."}]},{"kind":"title","text":"MEM"},{"kind":"poetry","indent":1,"runs":[{"verse":97,"end":null,"start":true,"text":"How I love your law!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":97,"end":null,"start":false,"text":"It is my meditation all day."}]},{"kind":"poetry","indent":1,"runs":[{"verse":98,"end":null,"start":true,"text":"Your commandments make me wiser than my enemies,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":98,"end":null,"start":false,"text":"for your commandments are always with me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":99,"end":null,"start":true,"text":"I have more understanding than all my teachers,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":99,"end":null,"start":false,"text":"for your testimonies are my meditation."}]},{"kind":"poetry","indent":1,"runs":[{"verse":100,"end":null,"start":true,"text":"I understand more than the aged,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":100,"end":null,"start":false,"text":"because I have kept your precepts."}]},{"kind":"poetry","indent":1,"runs":[{"verse":101,"end":null,"start":true,"text":"I have kept my feet from every evil way,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":101,"end":null,"start":false,"text":"that I might observe your word."}]},{"kind":"poetry","indent":1,"runs":[{"verse":102,"end":null,"start":true,"text":"I have not turned away from your ordinances,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":102,"end":null,"start":false,"text":"for you have taught me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":103,"end":null,"start":true,"text":"How sweet are your promises to my taste,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":103,"end":null,"start":false,"text":"more than honey to my mouth!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":104,"end":null,"start":true,"text":"Through your precepts, I get understanding;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":104,"end":null,"start":false,"text":"therefore I hate every false way."}]},{"kind":"title","text":"NUN"},{"kind":"poetry","indent":1,"runs":[{"verse":105,"end":null,"start":true,"text":"Your word is a lamp to my feet,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":105,"end":null,"start":false,"text":"and a light for my path."}]},{"kind":"poetry","indent":1,"runs":[{"verse":106,"end":null,"start":true,"text":"I have sworn, and have confirmed it,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":106,"end":null,"start":false,"text":"that I will obey your righteous ordinances."}]},{"kind":"poetry","indent":1,"runs":[{"verse":107,"end":null,"start":true,"text":"I am afflicted very much."}]},{"kind":"poetry","indent":2,"runs":[{"verse":107,"end":null,"start":false,"text":"Revive me, LORD, according to your word."}]},{"kind":"poetry","indent":1,"runs":[{"verse":108,"end":null,"start":true,"text":"Accept, I beg you, the willing offerings of my mouth."}]},{"kind":"poetry","indent":2,"runs":[{"verse":108,"end":null,"start":false,"text":"LORD, teach me your ordinances."}]},{"kind":"poetry","indent":1,"runs":[{"verse":109,"end":null,"start":true,"text":"My soul is continually in my hand,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":109,"end":null,"start":false,"text":"yet I won’t forget your law."}]},{"kind":"poetry","indent":1,"runs":[{"verse":110,"end":null,"start":true,"text":"The wicked have laid a snare for me,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":110,"end":null,"start":false,"text":"yet I haven’t gone astray from your precepts."}]},{"kind":"poetry","indent":1,"runs":[{"verse":111,"end":null,"start":true,"text":"I have taken your testimonies as a heritage forever,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":111,"end":null,"start":false,"text":"for they are the joy of my heart."}]},{"kind":"poetry","indent":1,"runs":[{"verse":112,"end":null,"start":true,"text":"I have set my heart to perform your statutes forever,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":112,"end":null,"start":false,"text":"even to the end."}]},{"kind":"title","text":"SAMEKH"},{"kind":"poetry","indent":1,"runs":[{"verse":113,"end":null,"start":true,"text":"I hate double-minded men,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":113,"end":null,"start":false,"text":"but I love your law."}]},{"kind":"poetry","indent":1,"runs":[{"verse":114,"end":null,"start":true,"text":"You are my hiding place and my shield."}]},{"kind":"poetry","indent":2,"runs":[{"verse":114,"end":null,"start":false,"text":"I hope in your word."}]},{"kind":"poetry","indent":1,"runs":[{"verse":115,"end":null,"start":true,"text":"Depart from me, you evildoers,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":115,"end":null,"start":false,"text":"that I may keep the commandments of my God."}]},{"kind":"poetry","indent":1,"runs":[{"verse":116,"end":null,"start":true,"text":"Uphold me according to your word, that I may live."}]},{"kind":"poetry","indent":2,"runs":[{"verse":116,"end":null,"start":false,"text":"Let me not be ashamed of my hope."}]},{"kind":"poetry","indent":1,"runs":[{"verse":117,"end":null,"start":true,"text":"Hold me up, and I will be safe,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":117,"end":null,"start":false,"text":"and will have respect for your statutes continually."}]},{"kind":"poetry","indent":1,"runs":[{"verse":118,"end":null,"start":true,"text":"You reject all those who stray from your statutes,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":118,"end":null,"start":false,"text":"for their deceit is in vain."}]},{"kind":"poetry","indent":1,"runs":[{"verse":119,"end":null,"start":true,"text":"You put away all the wicked of the earth like dross."}]},{"kind":"poetry","indent":2,"runs":[{"verse":119,"end":null,"start":false,"text":"Therefore I love your testimonies."}]},{"kind":"poetry","indent":1,"runs":[{"verse":120,"end":null,"start":true,"text":"My flesh trembles for fear of you."}]},{"kind":"poetry","indent":2,"runs":[{"verse":120,"end":null,"start":false,"text":"I am afraid of your judgments."}]},{"kind":"title","text":"AYIN"},{"kind":"poetry","indent":1,"runs":[{"verse":121,"end":null,"start":true,"text":"I have done what is just and righteous."}]},{"kind":"poetry","indent":2,"runs":[{"verse":121,"end":null,"start":false,"text":"Don’t leave me to my oppressors."}]},{"kind":"poetry","indent":1,"runs":[{"verse":122,"end":null,"start":true,"text":"Ensure your servant’s well-being."}]},{"kind":"poetry","indent":2,"runs":[{"verse":122,"end":null,"start":false,"text":"Don’t let the proud oppress me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":123,"end":null,"start":true,"text":"My eyes fail looking for your salvation,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":123,"end":null,"start":false,"text":"for your righteous word."}]},{"kind":"poetry","indent":1,"runs":[{"verse":124,"end":null,"start":true,"text":"Deal with your servant according to your loving kindness."}]},{"kind":"poetry","indent":2,"runs":[{"verse":124,"end":null,"start":false,"text":"Teach me your statutes."}]},{"kind":"poetry","indent":1,"runs":[{"verse":125,"end":null,"start":true,"text":"I am your servant. Give me understanding,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":125,"end":null,"start":false,"text":"that I may know your testimonies."}]},{"kind":"poetry","indent":1,"runs":[{"verse":126,"end":null,"start":true,"text":"It is time to act, LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":126,"end":null,"start":false,"text":"for they break your law."}]},{"kind":"poetry","indent":1,"runs":[{"verse":127,"end":null,"start":true,"text":"Therefore I love your commandments more than gold,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":127,"end":null,"start":false,"text":"yes, more than pure gold."}]},{"kind":"poetry","indent":1,"runs":[{"verse":128,"end":null,"start":true,"text":"Therefore I consider all of your precepts to be right."}]},{"kind":"poetry","indent":2,"runs":[{"verse":128,"end":null,"start":false,"text":"I hate every false way."}]},{"kind":"title","text":"PE"},{"kind":"poetry","indent":1,"runs":[{"verse":129,"end":null,"start":true,"text":"Your testimonies are wonderful,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":129,"end":null,"start":false,"text":"therefore my soul keeps them."}]},{"kind":"poetry","indent":1,"runs":[{"verse":130,"end":null,"start":true,"text":"The entrance of your words gives light."}]},{"kind":"poetry","indent":2,"runs":[{"verse":130,"end":null,"start":false,"text":"It gives understanding to the simple."}]},{"kind":"poetry","indent":1,"runs":[{"verse":131,"end":null,"start":true,"text":"I opened my mouth wide and panted,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":131,"end":null,"start":false,"text":"for I longed for your commandments."}]},{"kind":"poetry","indent":1,"runs":[{"verse":132,"end":null,"start":true,"text":"Turn to me, and have mercy on me,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":132,"end":null,"start":false,"text":"as you always do to those who love your name."}]},{"kind":"poetry","indent":1,"runs":[{"verse":133,"end":null,"start":true,"text":"Establish my footsteps in your word."}]},{"kind":"poetry","indent":2,"runs":[{"verse":133,"end":null,"start":false,"text":"Don’t let any iniquity have dominion over me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":134,"end":null,"start":true,"text":"Redeem me from the oppression of man,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":134,"end":null,"start":false,"text":"so I will observe your precepts."}]},{"kind":"poetry","indent":1,"runs":[{"verse":135,"end":null,"start":true,"text":"Make your face shine on your servant."}]},{"kind":"poetry","indent":2,"runs":[{"verse":135,"end":null,"start":false,"text":"Teach me your statutes."}]},{"kind":"poetry","indent":1,"runs":[{"verse":136,"end":null,"start":true,"text":"Streams of tears run down my eyes,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":136,"end":null,"start":false,"text":"because they don’t observe your law."}]},{"kind":"title","text":"TZADHE"},{"kind":"poetry","indent":1,"runs":[{"verse":137,"end":null,"start":true,"text":"You are righteous, LORD."}]},{"kind":"poetry","indent":2,"runs":[{"verse":137,"end":null,"start":false,"text":"Your judgments are upright."}]},{"kind":"poetry","indent":1,"runs":[{"verse":138,"end":null,"start":true,"text":"You have commanded your statutes in righteousness."}]},{"kind":"poetry","indent":2,"runs":[{"verse":138,"end":null,"start":false,"text":"They are fully trustworthy."}]},{"kind":"poetry","indent":1,"runs":[{"verse":139,"end":null,"start":true,"text":"My zeal wears me out,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":139,"end":null,"start":false,"text":"because my enemies ignore your words."}]},{"kind":"poetry","indent":1,"runs":[{"verse":140,"end":null,"start":true,"text":"Your promises have been thoroughly tested,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":140,"end":null,"start":false,"text":"and your servant loves them."}]},{"kind":"poetry","indent":1,"runs":[{"verse":141,"end":null,"start":true,"text":"I am small and despised."}]},{"kind":"poetry","indent":2,"runs":[{"verse":141,"end":null,"start":false,"text":"I don’t forget your precepts."}]},{"kind":"poetry","indent":1,"runs":[{"verse":142,"end":null,"start":true,"text":"Your righteousness is an everlasting righteousness."}]},{"kind":"poetry","indent":2,"runs":[{"verse":142,"end":null,"start":false,"text":"Your law is truth."}]},{"kind":"poetry","indent":1,"runs":[{"verse":143,"end":null,"start":true,"text":"Trouble and anguish have taken hold of me."}]},{"kind":"poetry","indent":2,"runs":[{"verse":143,"end":null,"start":false,"text":"Your commandments are my delight."}]},{"kind":"poetry","indent":1,"runs":[{"verse":144,"end":null,"start":true,"text":"Your testimonies are righteous forever."}]},{"kind":"poetry","indent":2,"runs":[{"verse":144,"end":null,"start":false,"text":"Give me understanding, that I may live."}]},{"kind":"title","text":"QOPH"},{"kind":"poetry","indent":1,"runs":[{"verse":145,"end":null,"start":true,"text":"I have called with my whole heart."}]},{"kind":"poetry","indent":2,"runs":[{"verse":145,"end":null,"start":false,"text":"Answer me, LORD!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":145,"end":null,"start":false,"text":"I will keep your statutes."}]},{"kind":"poetry","indent":1,"runs":[{"verse":146,"end":null,"start":true,"text":"I have called to you. Save me!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":146,"end":null,"start":false,"text":"I will obey your statutes."}]},{"kind":"poetry","indent":1,"runs":[{"verse":147,"end":null,"start":true,"text":"I rise before dawn and cry for help."}]},{"kind":"poetry","indent":2,"runs":[{"verse":147,"end":null,"start":false,"text":"I put my hope in your words."}]},{"kind":"poetry","indent":1,"runs":[{"verse":148,"end":null,"start":true,"text":"My eyes stay open through the night watches,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":148,"end":null,"start":false,"text":"that I might meditate on your word."}]},{"kind":"poetry","indent":1,"runs":[{"verse":149,"end":null,"start":true,"text":"Hear my voice according to your loving kindness."}]},{"kind":"poetry","indent":2,"runs":[{"verse":149,"end":null,"start":false,"text":"Revive me, LORD, according to your ordinances."}]},{"kind":"poetry","indent":1,"runs":[{"verse":150,"end":null,"start":true,"text":"They draw near who follow after wickedness."}]},{"kind":"poetry","indent":2,"runs":[{"verse":150,"end":null,"start":false,"text":"They are far from your law."}]},{"kind":"poetry","indent":1,"runs":[{"verse":151,"end":null,"start":true,"text":"You are near, LORD."}]},{"kind":"poetry","indent":2,"runs":[{"verse":151,"end":null,"start":false,"text":"All your commandments are truth."}]},{"kind":"poetry","indent":1,"runs":[{"verse":152,"end":null,"start":true,"text":"Of old I have known from your testimonies,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":152,"end":null,"start":false,"text":"that you have founded them forever."}]},{"kind":"title","text":"RESH"},{"kind":"poetry","indent":1,"runs":[{"verse":153,"end":null,"start":true,"text":"Consider my affliction, and deliver me,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":153,"end":null,"start":false,"text":"for I don’t forget your law."}]},{"kind":"poetry","indent":1,"runs":[{"verse":154,"end":null,"start":true,"text":"Plead my cause, and redeem me!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":154,"end":null,"start":false,"text":"Revive me according to your promise."}]},{"kind":"poetry","indent":1,"runs":[{"verse":155,"end":null,"start":true,"text":"Salvation is far from the wicked,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":155,"end":null,"start":false,"text":"for they don’t seek your statutes."}]},{"kind":"poetry","indent":1,"runs":[{"verse":156,"end":null,"start":true,"text":"Great are your tender mercies, LORD."}]},{"kind":"poetry","indent":2,"runs":[{"verse":156,"end":null,"start":false,"text":"Revive me according to your ordinances."}]},{"kind":"poetry","indent":1,"runs":[{"verse":157,"end":null,"start":true,"text":"Many are my persecutors and my adversaries."}]},{"kind":"poetry","indent":2,"runs":[{"verse":157,"end":null,"start":false,"text":"I haven’t swerved from your testimonies."}]},{"kind":"poetry","indent":1,"runs":[{"verse":158,"end":null,"start":true,"text":"I look at the faithless with loathing,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":158,"end":null,"start":false,"text":"because they don’t observe your word."}]},{"kind":"poetry","indent":1,"runs":[{"verse":159,"end":null,"start":true,"text":"Consider how I love your precepts."}]},{"kind":"poetry","indent":2,"runs":[{"verse":159,"end":null,"start":false,"text":"Revive me, LORD, according to your loving kindness."}]},{"kind":"poetry","indent":1,"runs":[{"verse":160,"end":null,"start":true,"text":"All of your words are truth."}]},{"kind":"poetry","indent":2,"runs":[{"verse":160,"end":null,"start":false,"text":"Every one of your righteous ordinances endures forever."}]},{"kind":"title","text":"SIN AND SHIN"},{"kind":"poetry","indent":1,"runs":[{"verse":161,"end":null,"start":true,"text":"Princes have persecuted me without a cause,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":161,"end":null,"start":false,"text":"but my heart stands in awe of your words."}]},{"kind":"poetry","indent":1,"runs":[{"verse":162,"end":null,"start":true,"text":"I rejoice at your word,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":162,"end":null,"start":false,"text":"as one who finds great plunder."}]},{"kind":"poetry","indent":1,"runs":[{"verse":163,"end":null,"start":true,"text":"I hate and abhor falsehood."}]},{"kind":"poetry","indent":2,"runs":[{"verse":163,"end":null,"start":false,"text":"I love your law."}]},{"kind":"poetry","indent":1,"runs":[{"verse":164,"end":null,"start":true,"text":"Seven times a day, I praise you,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":164,"end":null,"start":false,"text":"because of your righteous ordinances."}]},{"kind":"poetry","indent":1,"runs":[{"verse":165,"end":null,"start":true,"text":"Those who love your law have great peace."}]},{"kind":"poetry","indent":2,"runs":[{"verse":165,"end":null,"start":false,"text":"Nothing causes them to stumble."}]},{"kind":"poetry","indent":1,"runs":[{"verse":166,"end":null,"start":true,"text":"I have hoped for your salvation, LORD."}]},{"kind":"poetry","indent":2,"runs":[{"verse":166,"end":null,"start":false,"text":"I have done your commandments."}]},{"kind":"poetry","indent":1,"runs":[{"verse":167,"end":null,"start":true,"text":"My soul has observed your testimonies."}]},{"kind":"poetry","indent":2,"runs":[{"verse":167,"end":null,"start":false,"text":"I love them exceedingly."}]},{"kind":"poetry","indent":1,"runs":[{"verse":168,"end":null,"start":true,"text":"I have obeyed your precepts and your testimonies,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":168,"end":null,"start":false,"text":"for all my ways are before you."}]},{"kind":"title","text":"TAV"},{"kind":"poetry","indent":1,"runs":[{"verse":169,"end":null,"start":true,"text":"Let my cry come before you, LORD."}]},{"kind":"poetry","indent":2,"runs":[{"verse":169,"end":null,"start":false,"text":"Give me understanding according to your word."}]},{"kind":"poetry","indent":1,"runs":[{"verse":170,"end":null,"start":true,"text":"Let my supplication come before you."}]},{"kind":"poetry","indent":2,"runs":[{"verse":170,"end":null,"start":false,"text":"Deliver me according to your word."}]},{"kind":"poetry","indent":1,"runs":[{"verse":171,"end":null,"start":true,"text":"Let my lips utter praise,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":171,"end":null,"start":false,"text":"for you teach me your statutes."}]},{"kind":"poetry","indent":1,"runs":[{"verse":172,"end":null,"start":true,"text":"Let my tongue sing of your word,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":172,"end":null,"start":false,"text":"for all your commandments are righteousness."}]},{"kind":"poetry","indent":1,"runs":[{"verse":173,"end":null,"start":true,"text":"Let your hand be ready to help me,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":173,"end":null,"start":false,"text":"for I have chosen your precepts."}]},{"kind":"poetry","indent":1,"runs":[{"verse":174,"end":null,"start":true,"text":"I have longed for your salvation, LORD."}]},{"kind":"poetry","indent":2,"runs":[{"verse":174,"end":null,"start":false,"text":"Your law is my delight."}]},{"kind":"poetry","indent":1,"runs":[{"verse":175,"end":null,"start":true,"text":"Let my soul live, that I may praise you."}]},{"kind":"poetry","indent":2,"runs":[{"verse":175,"end":null,"start":false,"text":"Let your ordinances help me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":176,"end":null,"start":true,"text":"I have gone astray like a lost sheep."}]},{"kind":"poetry","indent":2,"runs":[{"verse":176,"end":null,"start":false,"text":"Seek your servant, for I don’t forget your commandments."}]}]}
