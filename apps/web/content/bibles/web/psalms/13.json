{"version":"web","book":"psalms","chapter":13,"blocks":[{"kind":"title","text":"For the Chief Musician. A Psalm by David."},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"How long, LORD?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"Will you forget me forever?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"How long will you hide your face from me?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"How long shall I take counsel in my soul,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"having sorrow in my heart every day?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"How long shall my enemy triumph over me?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"Behold, and answer me, LORD, my God."}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"Give light to my eyes, lest I sleep in death;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":true,"text":"lest my enemy say, “I have prevailed against him;”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"lest my adversaries rejoice when I fall."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"But I trust in your loving kindness."}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"My heart rejoices in your salvation."}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"I will sing to the LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"because he has been good to me."}]}]}
