{"version":"web","book":"hosea","chapter":14,"blocks":[{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"Israel, return to the LORD your God;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"for you have fallen because of your sin."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"Take words with you, and return to the LORD."}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"Tell him, “Forgive all our sins,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"and accept that which is good;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"so we offer bulls as we vowed of our lips."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"Assyria can’t save us."}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"We won’t ride on horses;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"neither will we say any more to the work of our hands, ‘Our gods!’"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"for in you the fatherless finds mercy.”"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"“I will heal their waywardness."}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"I will love them freely;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"for my anger is turned away from them."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"I will be like the dew to Israel."}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"He will blossom like the lily,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"and send down his roots like Lebanon."}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"His branches will spread,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"and his beauty will be like the olive tree,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"and his fragrance like Lebanon."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"Men will dwell in his shade."}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"They will revive like the grain,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"and blossom like the vine."}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"Their fragrance will be like the wine of Lebanon."}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"Ephraim, what have I to do any more with idols?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"I answer, and will take care of him."}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"I am like a green cypress tree;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"from me your fruit is found.”"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"Who is wise, that he may understand these things?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"Who is prudent, that he may know them?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"For the ways of the LORD are right,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"and the righteous walk in them,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"but the rebellious stumble in them."}]}]}
