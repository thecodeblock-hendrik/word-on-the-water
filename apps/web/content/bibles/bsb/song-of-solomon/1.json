{"version":"bsb","book":"song-of-solomon","chapter":1,"blocks":[{"kind":"heading","level":2,"text":"The Bride Confesses Her Love"},{"kind":"paragraph","indent":0,"runs":[{"verse":1,"end":null,"start":true,"text":"This is Solomon’s Song of Songs."}]},{"kind":"heading","level":3,"text":"The Bride"},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"Let him kiss me with the kisses of his mouth!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"For your love is more delightful than wine."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"The fragrance of your perfume is pleasing;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"your name is like perfume poured out."}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"No wonder the maidens adore you."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"Take me away with you— let us hurry!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"May the king bring me to his chambers."}]},{"kind":"heading","level":3,"text":"The Friends"},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":false,"text":"We will rejoice and delight in you;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"we will praise your love more than wine."}]},{"kind":"heading","level":3,"text":"The Bride"},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":false,"text":"It is only right that they adore you."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"I am dark, yet lovely, O daughters of Jerusalem,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"like the tents of Kedar, like the curtains of Solomon."}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"Do not stare because I am dark,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"for the sun has gazed upon me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":false,"text":"My mother’s sons were angry with me;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"they made me a keeper of the vineyards,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"but my own vineyard I have neglected."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"Tell me, O one I love,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"where do you pasture your sheep?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"Where do you rest them at midday?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":false,"text":"Why should I be like a veiled woman"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"beside the flocks of your companions?"}]},{"kind":"heading","level":3,"text":"The Friends"},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"If you do not know, O fairest of women,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"follow the tracks of the flock,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":false,"text":"and graze your young goats"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"near the tents of the shepherds."}]},{"kind":"heading","level":3,"text":"The Bridegroom"},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"I compare you, my darling,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"to a mare among Pharaoh’s chariots."}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"Your cheeks are beautiful with ornaments,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"your neck with strings of jewels."}]},{"kind":"heading","level":3,"text":"The Friends"},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"We will make you ornaments of gold,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"studded with beads of silver."}]},{"kind":"heading","level":3,"text":"The Bride"},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"While the king was at his table,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"my perfume spread its fragrance."}]},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":true,"text":"My beloved is to me a sachet of myrrh"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"resting between my breasts."}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":true,"text":"My beloved is to me a cluster of henna blossoms"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"in the vineyards of En-gedi."}]},{"kind":"heading","level":3,"text":"The Bridegroom"},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":true,"text":"How beautiful you are, my darling!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"Oh, how very beautiful!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"Your eyes are like doves."}]},{"kind":"heading","level":3,"text":"The Bride"},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":true,"text":"How handsome you are, my beloved!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"Oh, how delightful!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"The soft grass is our bed."}]},{"kind":"heading","level":3,"text":"The Bridegroom"},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":true,"text":"The beams of our house are cedars;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"our rafters are fragrant firs."}]}]}
