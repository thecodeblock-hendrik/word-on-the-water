{"version":"bsb","book":"song-of-solomon","chapter":4,"blocks":[{"kind":"heading","level":2,"text":"Solomon Admires His Bride"},{"kind":"heading","level":3,"text":"The Bridegroom"},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"How beautiful you are, my darling—"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"how very beautiful!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":false,"text":"Your eyes are like doves"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"behind your veil."}]},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":false,"text":"Your hair is like a flock of goats"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"streaming down Mount Gilead."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"Your teeth are like a flock of newly shorn sheep"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"coming up from the washing;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":false,"text":"each has its twin,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"and not one of them is lost."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"Your lips are like a scarlet ribbon,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"and your mouth is lovely."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":false,"text":"Your brow behind your veil"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"is like a slice of pomegranate."}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"Your neck is like the tower of David,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"built with rows of stones;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":false,"text":"on it hang a thousand shields,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"all of them shields of warriors."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"Your breasts are like two fawns,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"twins of a gazelle grazing among the lilies."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"Before the day breaks and the shadows flee,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"I will make my way"}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":false,"text":"to the mountain of myrrh"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"and to the hill of frankincense."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"You are altogether beautiful, my darling;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"in you there is no flaw."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"Come with me from Lebanon, my bride,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"come with me from Lebanon!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":false,"text":"Descend from the peak of Amana,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"from the summits of Senir and Hermon,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":false,"text":"from the dens of the lions,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"from the mountains of the leopards."}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"You have captured my heart,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"my sister, my bride;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":false,"text":"you have stolen my heart with one glance of your eyes,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"with one jewel of your neck."}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"How delightful is your love,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"my sister, my bride!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":false,"text":"Your love is much better than wine,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"and the fragrance of your perfume than all spices."}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"Your lips, my bride,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"drip sweetness like the honeycomb;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":false,"text":"honey and milk are under your tongue,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"and the fragrance of your garments"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"is like the aroma of Lebanon."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"My sister, my bride, you are a garden locked up,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"a spring enclosed, a fountain sealed."}]},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":true,"text":"Your branches are an orchard of pomegranates"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"with the choicest of fruits, with henna and nard,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":true,"text":"with nard and saffron, with calamus and cinnamon,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"with every kind of frankincense tree,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":false,"text":"with myrrh and aloes,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"with all the finest spices."}]},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":true,"text":"You are a garden spring,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"a well of fresh water"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"flowing down from Lebanon."}]},{"kind":"heading","level":3,"text":"The Bride"},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":true,"text":"Awake, O north wind,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"and come, O south wind."}]},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":false,"text":"Breathe on my garden"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"and spread the fragrance of its spices."}]},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":false,"text":"Let my beloved come into his garden"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"and taste its choicest fruits."}]}]}
