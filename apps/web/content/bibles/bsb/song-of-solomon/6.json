{"version":"bsb","book":"song-of-solomon","chapter":6,"blocks":[{"kind":"heading","level":2,"text":"Together in the Garden"},{"kind":"heading","level":3,"text":"The Friends"},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"Where has your beloved gone,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"O most beautiful among women?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":false,"text":"Which way has he turned?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"We will seek him with you."}]},{"kind":"heading","level":3,"text":"The Bride"},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"My beloved has gone down to his garden,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"to the beds of spices,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":false,"text":"to pasture his flock in the gardens"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"and to gather lilies."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"I belong to my beloved and he belongs to me;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"he pastures his flock among the lilies."}]},{"kind":"heading","level":3,"text":"The Bridegroom"},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"You are as beautiful, my darling, as Tirzah,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"as lovely as Jerusalem,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"as majestic as troops with banners."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"Turn your eyes away from me,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"for they have overcome me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":false,"text":"Your hair is like a flock of goats"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"streaming down from Gilead."}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"Your teeth are like a flock of sheep"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"coming up from the washing;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":false,"text":"each has its twin,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"and not one of them is lost."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"Your brow behind your veil"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"is like a slice of pomegranate."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"There are sixty queens and eighty concubines,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"and maidens without number,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"but my dove, my perfect one, is unique,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"the favorite of the mother who bore her."}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":false,"text":"The maidens see her and call her blessed;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"the queens and concubines sing her praises."}]},{"kind":"heading","level":3,"text":"The Friends"},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"Who is this who shines like the dawn,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"as fair as the moon,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":false,"text":"as bright as the sun,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"as majestic as the stars in procession?"}]},{"kind":"heading","level":3,"text":"The Bridegroom"},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"I went down to the walnut grove"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"to see the blossoms of the valley,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":false,"text":"to see if the vines were budding"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"or the pomegranates were in bloom."}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"Before I realized it, my desire had set me"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"among the royal chariots of my people."}]},{"kind":"heading","level":3,"text":"The Friends"},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":true,"text":"Come back, come back, O Shulammite!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"Come back, come back, that we may gaze upon you."}]},{"kind":"heading","level":3,"text":"The Bridegroom"},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":false,"text":"Why do you look at the Shulammite,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"as on the dance of Mahanaim?"}]}]}
