{"version":"bsb","book":"song-of-solomon","chapter":8,"blocks":[{"kind":"heading","level":2,"text":"Longing for Her Beloved"},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"O that you were to me like a brother"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"who nursed at my mother’s breasts!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":false,"text":"If I found you outdoors, I would kiss you,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"and no one would despise me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"I would lead you and bring you"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"to the house of my mother who taught me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":false,"text":"I would give you spiced wine to drink,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"the nectar of my pomegranates."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"His left hand is under my head,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"and his right arm embraces me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"O daughters of Jerusalem, I adjure you:"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"Do not arouse or awaken love"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"until the time is right."}]},{"kind":"heading","level":3,"text":"The Friends"},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"Who is this coming up from the wilderness,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"leaning on her beloved?"}]},{"kind":"heading","level":3,"text":"The Bride"},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":false,"text":"I roused you under the apple tree;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"there your mother conceived you;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"there she travailed and brought you forth."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"Set me as a seal over your heart,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"as a seal upon your arm."}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":false,"text":"For love is as strong as death,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"its jealousy as unrelenting as Sheol."}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":false,"text":"Its sparks are fiery flames,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"the fiercest blaze of all."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"Mighty waters cannot quench love;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"rivers cannot sweep it away."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":false,"text":"If a man were to give all the wealth of his house for love,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"his offer would be utterly scorned."}]},{"kind":"heading","level":3,"text":"The Friends"},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"We have a little sister,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"and her breasts are not yet grown."}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":false,"text":"What shall we do for our sister"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"on the day she is spoken for?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"If she is a wall,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"we will build a tower of silver upon her."}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":false,"text":"If she is a door,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"we will enclose her with panels of cedar."}]},{"kind":"heading","level":3,"text":"The Bride"},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"I am a wall,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"and my breasts are like towers."}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":false,"text":"So I have become in his eyes"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"like one who brings peace."}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"Solomon had a vineyard in Baal-hamon."}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"He leased it to the tenants."}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":false,"text":"For its fruit, each was to bring"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"a thousand shekels of silver."}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"But my own vineyard is mine to give;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"the thousand shekels are for you, O Solomon,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"and two hundred are for those who tend its fruit."}]},{"kind":"heading","level":3,"text":"The Bridegroom"},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":true,"text":"You who dwell in the gardens,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"my companions are listening for your voice."}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"Let me hear it!"}]},{"kind":"heading","level":3,"text":"The Bride"},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":true,"text":"Come away, my beloved,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"and be like a gazelle"}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":false,"text":"or a young stag"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"on the mountains of spices."}]}]}
