{"version":"bsb","book":"job","chapter":18,"blocks":[{"kind":"heading","level":2,"text":"Bildad: God Punishes the Wicked"},{"kind":"paragraph","indent":0,"runs":[{"verse":1,"end":null,"start":true,"text":"Then Bildad the Shuhite replied:"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"“How long until you end these speeches?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"Show some sense, and then we can talk."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"Why are we regarded as cattle,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"as stupid in your sight?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"You who tear yourself in anger—"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"should the earth be forsaken on your account,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"or the rocks be moved from their place?"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"Indeed, the lamp of the wicked is extinguished;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"the flame of his fire does not glow."}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"The light in his tent grows dark,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"and the lamp beside him goes out."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"His vigorous stride is shortened,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"and his own schemes trip him up."}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"For his own feet lead him into a net,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"and he wanders into its mesh."}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"A trap seizes his heel;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"a snare grips him."}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"A noose is hidden in the ground,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"and a trap lies in his path."}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"Terrors frighten him on every side"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"and harass his every step."}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"His strength is depleted,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"and calamity is ready at his side."}]},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":true,"text":"It devours patches of his skin;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"the firstborn of death devours his limbs."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":true,"text":"He is torn from the shelter of his tent"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"and is marched off to the king of terrors."}]},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":true,"text":"Fire resides in his tent;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"burning sulfur rains down on his dwelling."}]},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":true,"text":"The roots beneath him dry up,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"and the branches above him wither away."}]},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":true,"text":"The memory of him perishes from the earth,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"and he has no name in the land."}]},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":true,"text":"He is driven from light into darkness"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"and is chased from the inhabited world."}]},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":true,"text":"He has no offspring or posterity among his people,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"no survivor where he once lived."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":true,"text":"Those in the west are appalled at his fate,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"while those in the east tremble in horror."}]},{"kind":"poetry","indent":1,"runs":[{"verse":21,"end":null,"start":true,"text":"Surely such is the dwelling of the wicked"}]},{"kind":"poetry","indent":2,"runs":[{"verse":21,"end":null,"start":false,"text":"and the place of one who does not know God.”"}]}]}
