{"version":"bsb","book":"job","chapter":19,"blocks":[{"kind":"heading","level":2,"text":"Job: My Redeemer Lives"},{"kind":"paragraph","indent":0,"runs":[{"verse":1,"end":null,"start":true,"text":"Then Job answered:"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"“How long will you torment me"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"and crush me with your words?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"Ten times now you have reproached me;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"you shamelessly mistreat me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"Even if I have truly gone astray,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"my error concerns me alone."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"If indeed you would exalt yourselves above me"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"and use my disgrace against me,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"then understand that it is God who has wronged me"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"and drawn His net around me."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"Though I cry out, ‘Violence!’ I get no response;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"though I call for help, there is no justice."}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"He has blocked my way so I cannot pass;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"He has veiled my paths with darkness."}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"He has stripped me of my honor"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"and removed the crown from my head."}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"He tears me down on every side until I am gone;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"He uproots my hope like a tree."}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"His anger burns against me,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"and He counts me among His enemies."}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"His troops advance together;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"they construct a ramp against me"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"and encamp around my tent."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":true,"text":"He has removed my brothers from me;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"my acquaintances have abandoned me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":true,"text":"My kinsmen have failed me,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"and my friends have forgotten me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":true,"text":"My guests and maidservants count me as a stranger;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"I am a foreigner in their sight."}]},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":true,"text":"I call for my servant, but he does not answer,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"though I implore him with my own mouth."}]},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":true,"text":"My breath is repulsive to my wife,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"and I am loathsome to my own family."}]},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":true,"text":"Even little boys scorn me;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"when I appear, they deride me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":true,"text":"All my best friends despise me,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"and those I love have turned against me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":true,"text":"My skin and flesh cling to my bones;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"I have escaped by the skin of my teeth."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":21,"end":null,"start":true,"text":"Have pity on me, my friends, have pity,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":21,"end":null,"start":false,"text":"for the hand of God has struck me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":22,"end":null,"start":true,"text":"Why do you persecute me as God does?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":22,"end":null,"start":false,"text":"Will you never get enough of my flesh?"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":23,"end":null,"start":true,"text":"I wish that my words were recorded"}]},{"kind":"poetry","indent":2,"runs":[{"verse":23,"end":null,"start":false,"text":"and inscribed in a book,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":24,"end":null,"start":true,"text":"by an iron stylus on lead,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":24,"end":null,"start":false,"text":"or chiseled in stone forever."}]},{"kind":"poetry","indent":1,"runs":[{"verse":25,"end":null,"start":true,"text":"But I know that my Redeemer lives,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":25,"end":null,"start":false,"text":"and in the end He will stand upon the earth."}]},{"kind":"poetry","indent":1,"runs":[{"verse":26,"end":null,"start":true,"text":"Even after my skin has been destroyed,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":26,"end":null,"start":false,"text":"yet in my flesh I will see God."}]},{"kind":"poetry","indent":1,"runs":[{"verse":27,"end":null,"start":true,"text":"I will see Him for myself;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":27,"end":null,"start":false,"text":"my eyes will behold Him, and not as a stranger."}]},{"kind":"poetry","indent":2,"runs":[{"verse":27,"end":null,"start":false,"text":"How my heart yearns within me!"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":28,"end":null,"start":true,"text":"If you say, ‘Let us persecute him,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":28,"end":null,"start":false,"text":"since the root of the matter lies with him,’"}]},{"kind":"poetry","indent":1,"runs":[{"verse":29,"end":null,"start":true,"text":"then you should fear the sword yourselves,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":29,"end":null,"start":false,"text":"because wrath brings punishment by the sword,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":29,"end":null,"start":false,"text":"so that you may know there is a judgment.”"}]}]}
