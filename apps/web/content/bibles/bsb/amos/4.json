{"version":"bsb","book":"amos","chapter":4,"blocks":[{"kind":"heading","level":2,"text":"Punishment Brings No Repentance"},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"Hear this word,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"you cows of Bashan on Mount Samaria,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":false,"text":"you women who oppress the poor"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"and crush the needy,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":false,"text":"who say to your husbands,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"“Bring us more to drink.”"}]},{"kind":"paragraph","indent":0,"runs":[{"verse":2,"end":null,"start":true,"text":"The Lord GOD has sworn by His holiness:"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":false,"text":"“Behold, the days are coming"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"when you will be taken away with hooks,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"and your posterity with fishhooks."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"You will go out through broken walls,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"each one straight ahead of her,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"and you will be cast out toward Harmon,”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"declares the LORD."}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"“Go to Bethel and transgress;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"rebel even more at Gilgal!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":false,"text":"Bring your sacrifices every morning,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"your tithes every three days."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"Offer leavened bread as a thank offering,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"and loudly proclaim your freewill offerings."}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"For that is what you children of Israel love to do,”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"declares the Lord GOD."}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"“I afflicted all your cities with cleanness of teeth"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"and all your towns with lack of bread,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"yet you did not return to Me,”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"declares the LORD."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"“I also withheld the rain from you"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"when the harvest was three months away."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":false,"text":"I sent rain on one city"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"but withheld it from another."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":false,"text":"One field received rain;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"another without rain withered."}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"People staggered from city to city"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"for water to drink,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":false,"text":"but they were not satisfied;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"yet you did not return to Me,”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"declares the LORD."}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"“I struck you with blight and mildew"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"in your growing gardens and vineyards;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":false,"text":"the locust devoured your fig and olive trees,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"yet you did not return to Me,”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"declares the LORD."}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"“I sent plagues among you"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"like those of Egypt;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":false,"text":"I killed your young men with the sword,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"along with your captured horses."}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":false,"text":"I filled your nostrils with the stench of your camp,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"yet you did not return to Me,”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"declares the LORD."}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"“Some of you I overthrew"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"as I overthrew Sodom and Gomorrah,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":false,"text":"and you were like a firebrand snatched from a blaze,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"yet you did not return to Me,”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"declares the LORD."}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"“Therefore, that is what I will do"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"to you, O Israel,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":false,"text":"and since I will do this to you,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"prepare to meet your God, O Israel!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":true,"text":"For behold, He who forms the mountains,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"who creates the wind"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"and reveals His thoughts to man,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":false,"text":"who turns the dawn to darkness"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"and strides on the heights of the earth—"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"the LORD, the God of Hosts, is His name.”"}]}]}
