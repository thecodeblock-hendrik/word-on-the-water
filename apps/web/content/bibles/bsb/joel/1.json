{"version":"bsb","book":"joel","chapter":1,"blocks":[{"kind":"heading","level":2,"text":"The Invasion of Locusts"},{"kind":"paragraph","indent":0,"runs":[{"verse":1,"end":null,"start":true,"text":"This is the word of the LORD that came to Joel son of Pethuel:"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"Hear this, O elders;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"and give ear, all who dwell in the land."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":false,"text":"Has anything like this ever happened in your days"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"or in the days of your fathers?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"Tell it to your children;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"let your children tell it to their children,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"and their children to the next generation."}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"What the devouring locust has left,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"the swarming locust has eaten;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":false,"text":"what the swarming locust has left,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"the young locust has eaten;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":false,"text":"and what the young locust has left,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"the destroying locust has eaten."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"Wake up, you drunkards, and weep;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"wail, all you drinkers of wine,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":false,"text":"because of the sweet wine,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"for it has been cut off from your mouth."}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"For a nation has invaded My land,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"powerful and without number;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":false,"text":"its teeth are the teeth of a lion,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"and its fangs are the fangs of a lioness."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"It has laid waste My grapevine"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"and splintered My fig tree."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":false,"text":"It has stripped off the bark and thrown it away;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"the branches have turned white."}]},{"kind":"heading","level":2,"text":"A Call to Mourning"},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"Wail like a virgin dressed in sackcloth,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"grieving for the husband of her youth."}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"Grain and drink offerings have been cut off"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"from the house of the LORD;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":false,"text":"the priests are in mourning,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"those who minister before the LORD."}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"The field is ruined;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"the land mourns."}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":false,"text":"For the grain is destroyed,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"the new wine is dried up, and the oil fails."}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"Be dismayed, O farmers,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"wail, O vinedressers,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":false,"text":"over the wheat and barley,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"because the harvest of the field has perished."}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"The grapevine is dried up,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"and the fig tree is withered;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":false,"text":"the pomegranate, palm, and apple—"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"all the trees of the orchard— are withered."}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"Surely the joy of mankind has dried up."}]},{"kind":"heading","level":2,"text":"A Call to Repentance"},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":true,"text":"Put on sackcloth and lament, O priests;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"wail, O ministers of the altar."}]},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":false,"text":"Come, spend the night in sackcloth,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"O ministers of my God,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":false,"text":"because the grain and drink offerings"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"are withheld from the house of your God."}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":true,"text":"Consecrate a fast;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"proclaim a solemn assembly!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":false,"text":"Gather the elders"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"and all the residents of the land"}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":false,"text":"to the house of the LORD your God,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"and cry out to the LORD."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":true,"text":"Alas for the day!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"For the Day of the LORD is near,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":false,"text":"and it will come"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"as destruction from the Almighty."}]},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":true,"text":"Has not the food been cut off"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"before our very eyes —"}]},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":false,"text":"joy and gladness"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"from the house of our God?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":true,"text":"The seeds lie shriveled beneath the clods;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"the storehouses are in ruins;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":false,"text":"the granaries are broken down,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"for the grain has withered away."}]},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":true,"text":"How the cattle groan!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"The herds wander in confusion"}]},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":false,"text":"because they have no pasture."}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"Even the flocks of sheep are suffering."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":true,"text":"To You, O LORD, I call,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"for fire has consumed the open pastures"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"and flames have scorched all the trees of the field."}]},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":true,"text":"Even the beasts of the field pant for You,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"for the streams of water have dried up,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"and fire has consumed the open pastures."}]}]}
