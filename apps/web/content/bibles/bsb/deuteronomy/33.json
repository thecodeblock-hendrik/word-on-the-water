{"version":"bsb","book":"deuteronomy","chapter":33,"blocks":[{"kind":"heading","level":2,"text":"Moses Blesses the Twelve Tribes"},{"kind":"paragraph","indent":0,"runs":[{"verse":1,"end":null,"start":true,"text":"This is the blessing that Moses the man of God pronounced upon the Israelites before his death."},{"verse":2,"end":null,"start":true,"text":"He said:"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":false,"text":"“The LORD came from Sinai"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"and dawned upon us from Seir;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":false,"text":"He shone forth from Mount Paran"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"and came with myriads of holy ones,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"with flaming fire at His right hand."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"Surely You love the people;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"all the holy ones are in Your hand,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":false,"text":"and they sit down at Your feet;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"each receives Your words —"}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"the law that Moses gave us,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"the possession of the assembly of Jacob."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"So the LORD became King in Jeshurun"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"when the leaders of the people gathered,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"when the tribes of Israel came together."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"Let Reuben live and not die,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"nor his men be few.”"}]},{"kind":"paragraph","indent":0,"runs":[{"verse":7,"end":null,"start":true,"text":"And concerning Judah he said:"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":false,"text":"“O LORD, hear the cry of Judah"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"and bring him to his people."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":false,"text":"With his own hands he defends his cause,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"but may You be a help against his foes.”"}]},{"kind":"paragraph","indent":0,"runs":[{"verse":8,"end":null,"start":true,"text":"Concerning Levi he said:"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":false,"text":"“Give Your Thummim to Levi"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"and Your Urim to Your godly one,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":false,"text":"whom You tested at Massah"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"and contested at the waters of Meribah."}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"He said of his father and mother,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"‘I do not consider them.’"}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":false,"text":"He disregarded his brothers"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"and did not know his own sons,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":false,"text":"for he kept Your word"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"and maintained Your covenant."}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"He will teach Your ordinances to Jacob"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"and Your law to Israel;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":false,"text":"he will set incense before You"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"and whole burnt offerings on Your altar."}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"Bless his substance, O LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"and accept the work of his hands."}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":false,"text":"Smash the loins of those who rise against him,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"and of his foes so they can rise no more.”"}]},{"kind":"paragraph","indent":0,"runs":[{"verse":12,"end":null,"start":true,"text":"Concerning Benjamin he said:"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":false,"text":"“May the beloved of the LORD"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"rest secure in Him;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":false,"text":"God shields him all day long,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"and upon His shoulders he rests.”"}]},{"kind":"paragraph","indent":0,"runs":[{"verse":13,"end":null,"start":true,"text":"Concerning Joseph he said:"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":false,"text":"“May his land be blessed by the LORD"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"with the precious dew from heaven above"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"and the deep waters that lie beneath,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":true,"text":"with the bountiful harvest from the sun"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"and the abundant yield of the seasons,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":true,"text":"with the best of the ancient mountains"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"and the bounty of the everlasting hills,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":true,"text":"with the choice gifts of the land and everything in it,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"and with the favor of Him who dwelt in the burning bush."}]},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":false,"text":"May these rest on the head of Joseph"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"and crown the brow of the prince of his brothers."}]},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":true,"text":"His majesty is like a firstborn bull,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"and his horns are like those of a wild ox."}]},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":false,"text":"With them he will gore the nations,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"even to the ends of the earth."}]},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":false,"text":"Such are the myriads of Ephraim,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"and such are the thousands of Manasseh.”"}]},{"kind":"paragraph","indent":0,"runs":[{"verse":18,"end":null,"start":true,"text":"Concerning Zebulun he said:"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":false,"text":"“Rejoice, Zebulun, in your journeys,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"and Issachar, in your tents."}]},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":true,"text":"They will call the peoples to a mountain;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"there they will offer sacrifices of righteousness."}]},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":false,"text":"For they will feast on the abundance of the seas"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"and the hidden treasures of the sand.”"}]},{"kind":"paragraph","indent":0,"runs":[{"verse":20,"end":null,"start":true,"text":"Concerning Gad he said:"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":false,"text":"“Blessed is he who enlarges"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"the domain of Gad!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":false,"text":"He lies down like a lion"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"and tears off an arm or a head."}]},{"kind":"poetry","indent":1,"runs":[{"verse":21,"end":null,"start":true,"text":"He chose the best land for himself,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":21,"end":null,"start":false,"text":"because a ruler’s portion was reserved for him there."}]},{"kind":"poetry","indent":1,"runs":[{"verse":21,"end":null,"start":false,"text":"He came with the leaders of the people;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":21,"end":null,"start":false,"text":"he administered the LORD’s justice"}]},{"kind":"poetry","indent":2,"runs":[{"verse":21,"end":null,"start":false,"text":"and His ordinances for Israel.”"}]},{"kind":"paragraph","indent":0,"runs":[{"verse":22,"end":null,"start":true,"text":"Concerning Dan he said:"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":22,"end":null,"start":false,"text":"“Dan is a lion’s cub,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":22,"end":null,"start":false,"text":"leaping out of Bashan.”"}]},{"kind":"paragraph","indent":0,"runs":[{"verse":23,"end":null,"start":true,"text":"Concerning Naphtali he said:"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":23,"end":null,"start":false,"text":"“Naphtali is abounding with favor,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":23,"end":null,"start":false,"text":"full of the blessing of the LORD;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":23,"end":null,"start":false,"text":"he shall take possession"}]},{"kind":"poetry","indent":2,"runs":[{"verse":23,"end":null,"start":false,"text":"of the sea and the south.”"}]},{"kind":"paragraph","indent":0,"runs":[{"verse":24,"end":null,"start":true,"text":"And concerning Asher he said:"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":24,"end":null,"start":false,"text":"“May Asher be the most blessed of sons;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":24,"end":null,"start":false,"text":"may he be the most favored among his brothers"}]},{"kind":"poetry","indent":2,"runs":[{"verse":24,"end":null,"start":false,"text":"and dip his foot in oil."}]},{"kind":"poetry","indent":1,"runs":[{"verse":25,"end":null,"start":true,"text":"May the bolts of your gate be iron and bronze,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":25,"end":null,"start":false,"text":"and may your strength match your days.”"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":26,"end":null,"start":true,"text":"“There is none like the God of Jeshurun,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":26,"end":null,"start":false,"text":"who rides the heavens to your aid,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":26,"end":null,"start":false,"text":"and the clouds in His majesty."}]},{"kind":"poetry","indent":1,"runs":[{"verse":27,"end":null,"start":true,"text":"The eternal God is your dwelling place,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":27,"end":null,"start":false,"text":"and underneath are the everlasting arms."}]},{"kind":"poetry","indent":1,"runs":[{"verse":27,"end":null,"start":false,"text":"He drives out the enemy before you,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":27,"end":null,"start":false,"text":"giving the command, ‘Destroy him!’"}]},{"kind":"poetry","indent":1,"runs":[{"verse":28,"end":null,"start":true,"text":"So Israel dwells securely;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":28,"end":null,"start":false,"text":"the fountain of Jacob lives untroubled"}]},{"kind":"poetry","indent":1,"runs":[{"verse":28,"end":null,"start":false,"text":"in a land of grain and new wine,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":28,"end":null,"start":false,"text":"where even the heavens drip with dew."}]},{"kind":"poetry","indent":1,"runs":[{"verse":29,"end":null,"start":true,"text":"Blessed are you, O Israel!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":29,"end":null,"start":false,"text":"Who is like you, a people saved by the LORD?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":29,"end":null,"start":false,"text":"He is the shield that protects you,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":29,"end":null,"start":false,"text":"the sword in which you boast."}]},{"kind":"poetry","indent":1,"runs":[{"verse":29,"end":null,"start":false,"text":"Your enemies will cower before you,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":29,"end":null,"start":false,"text":"and you shall trample their high places.”"}]}]}
