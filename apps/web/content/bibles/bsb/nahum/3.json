{"version":"bsb","book":"nahum","chapter":3,"blocks":[{"kind":"heading","level":2,"text":"Judgment on Nineveh"},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"Woe to the city of blood,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"full of lies,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":false,"text":"full of plunder,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"never without prey."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"The crack of the whip,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"the rumble of the wheel,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":false,"text":"galloping horse"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"and bounding chariot!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"Charging horseman,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"flashing sword,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"shining spear;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":false,"text":"heaps of slain,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"mounds of corpses,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":false,"text":"dead bodies without end—"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"they stumble over their dead—"}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"because of the many harlotries of the harlot,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"the seductive mistress of sorcery,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":false,"text":"who betrays nations by her prostitution"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"and clans by her witchcraft."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"“Behold, I am against you,”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"declares the LORD of Hosts."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":false,"text":"“I will lift your skirts over your face."}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"I will show your nakedness to the nations"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"and your shame to the kingdoms."}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"I will pelt you with filth"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"and treat you with contempt;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"I will make a spectacle of you."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"Then all who see you"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"will recoil from you and say,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":false,"text":"‘Nineveh is devastated;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"who will grieve for her?’"}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":false,"text":"Where can I find"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"comforters for you?”"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"Are you better than Thebes,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"stationed by the Nile with water around her,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":false,"text":"whose rampart was the sea,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"whose wall was the water?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"Cush and Egypt were her boundless strength;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"Put and Libya were her allies."}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"Yet she became an exile;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"she went into captivity."}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":false,"text":"Her infants were dashed to pieces"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"at the head of every street."}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":false,"text":"They cast lots for her dignitaries,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"and all her nobles were bound in chains."}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"You too will become drunk;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"you will go into hiding"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"and seek refuge from the enemy."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"All your fortresses are fig trees"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"with the first ripe figs;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":false,"text":"when shaken, they fall"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"into the mouth of the eater!"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":true,"text":"Look at your troops —"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"they are like your women!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":false,"text":"The gates of your land"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"are wide open to your enemies;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"fire consumes their bars."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":true,"text":"Draw your water for the siege;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"strengthen your fortresses."}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":false,"text":"Work the clay and tread the mortar;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"repair the brick kiln!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":true,"text":"There the fire will devour you;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"the sword will cut you down"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"and consume you like a young locust."}]},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":false,"text":"Make yourself many like the young locust;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"make yourself many like the swarming locust!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":true,"text":"You have multiplied your merchants"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"more than the stars of the sky."}]},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":false,"text":"The young locust strips the land"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"and flies away."}]},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":true,"text":"Your guards are like the swarming locust,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"and your scribes like clouds of locusts"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"that settle on the walls on a cold day."}]},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":false,"text":"When the sun rises, they fly away,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"and no one knows where."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":true,"text":"O king of Assyria, your shepherds slumber;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"your officers sleep."}]},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":false,"text":"Your people are scattered on the mountains"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"with no one to gather them."}]},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":true,"text":"There is no healing for your injury;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"your wound is severe."}]},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":false,"text":"All who hear the news of you"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"applaud your downfall,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":false,"text":"for who has not experienced"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"your constant cruelty?"}]}]}
