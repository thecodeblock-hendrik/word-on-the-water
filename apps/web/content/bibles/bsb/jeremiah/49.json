{"version":"bsb","book":"jeremiah","chapter":49,"blocks":[{"kind":"heading","level":2,"text":"Judgment on the Ammonites"},{"kind":"paragraph","indent":0,"runs":[{"verse":1,"end":null,"start":true,"text":"Concerning the Ammonites, this is what the LORD says:"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":false,"text":"“Has Israel no sons?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"Is he without heir?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":false,"text":"Why then has Milcom taken possession of Gad?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"Why have his people settled in their cities?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"Therefore, behold, the days are coming,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"declares the LORD,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":false,"text":"when I will sound the battle cry"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"against Rabbah of the Ammonites."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":false,"text":"It will become a heap of ruins,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"and its villages will be burned."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":false,"text":"Then Israel will drive out their dispossessors,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"says the LORD."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"Wail, O Heshbon, for Ai has been destroyed;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"cry out, O daughters of Rabbah!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":false,"text":"Put on sackcloth and mourn;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"run back and forth within your walls,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":false,"text":"for Milcom will go into exile"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"together with his priests and officials."}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"Why do you boast of your valleys—"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"your valleys so fruitful,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"O faithless daughter?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":false,"text":"You trust in your riches and say,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"‘Who can come against me?’"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"Behold, I am about to bring terror upon you,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"declares the Lord GOD of Hosts,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"from all those around you."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":false,"text":"You will each be driven headlong,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"with no one to regather the fugitives."}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"Yet afterward I will restore the Ammonites from captivity,”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"declares the LORD."}]},{"kind":"heading","level":2,"text":"Judgment on Edom"},{"kind":"paragraph","indent":0,"runs":[{"verse":7,"end":null,"start":true,"text":"Concerning Edom, this is what the LORD of Hosts says:"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":false,"text":"“Is there no longer wisdom in Teman?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"Has counsel perished from the prudent?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"Has their wisdom decayed?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"Turn and run!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"Lie low, O dwellers of Dedan,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":false,"text":"for I will bring disaster on Esau"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"at the time I punish him."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"If grape gatherers came to you,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"would they not leave some gleanings?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":false,"text":"Were thieves to come in the night,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"would they not steal only what they wanted?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"But I will strip Esau bare;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"I will uncover his hiding places,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"and he will be unable to conceal himself."}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":false,"text":"His descendants will be destroyed"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"along with his relatives and neighbors,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"and he will be no more."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"Abandon your orphans; I will preserve their lives."}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"Let your widows trust in Me.”"}]},{"kind":"paragraph","indent":0,"runs":[{"verse":12,"end":null,"start":true,"text":"For this is what the LORD says: “If those who do not deserve to drink the cup must drink it, can you possibly remain unpunished? You will not go unpunished, for you must drink it too."},{"verse":13,"end":null,"start":true,"text":"For by Myself I have sworn, declares the LORD, that Bozrah will become a desolation, a disgrace, a ruin, and a curse, and all her cities will be in ruins forever.”"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":true,"text":"I have heard a message from the LORD;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"an envoy has been sent to the nations:"}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":false,"text":"“Assemble yourselves to march against her!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"Rise up for battle!”"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":true,"text":"“For behold, I will make you small among nations,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"despised among men."}]},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":true,"text":"The terror you cause"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"and the pride of your heart"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"have deceived you,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":false,"text":"O dwellers in the clefts of the rocks,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"O occupiers of the mountain summit."}]},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":false,"text":"Though you elevate your nest like the eagle,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"even from there I will bring you down,”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"declares the LORD."}]},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":true,"text":"“Edom will become an object of horror."}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"All who pass by will be appalled"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"and will scoff at all her wounds."}]},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":true,"text":"As Sodom and Gomorrah were overthrown"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"along with their neighbors,”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"says the LORD,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":false,"text":"“no one will dwell there;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"no man will abide there."}]},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":true,"text":"Behold, one will come up like a lion"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"from the thickets of the Jordan to the watered pasture."}]},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":false,"text":"For in an instant I will chase Edom from her land."}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"Who is the chosen one I will appoint for this?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":false,"text":"For who is like Me, and who can challenge Me?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"What shepherd can stand against Me?”"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":true,"text":"Therefore hear the plans"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"that the LORD has drawn up against Edom"}]},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":false,"text":"and the strategies He has devised"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"against the people of Teman:"}]},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":false,"text":"Surely the little ones of the flock will be dragged away;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"certainly their pasture will be made desolate because of them."}]},{"kind":"poetry","indent":1,"runs":[{"verse":21,"end":null,"start":true,"text":"At the sound of their fall the earth will quake;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":21,"end":null,"start":false,"text":"their cry will resound to the Red Sea."}]},{"kind":"poetry","indent":1,"runs":[{"verse":22,"end":null,"start":true,"text":"Look! An eagle will soar and swoop down,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":22,"end":null,"start":false,"text":"spreading its wings over Bozrah."}]},{"kind":"poetry","indent":1,"runs":[{"verse":22,"end":null,"start":false,"text":"In that day the hearts of Edom’s mighty men"}]},{"kind":"poetry","indent":2,"runs":[{"verse":22,"end":null,"start":false,"text":"will be like the heart of a woman in labor."}]},{"kind":"heading","level":2,"text":"Judgment on Damascus"},{"kind":"paragraph","indent":0,"runs":[{"verse":23,"end":null,"start":true,"text":"Concerning Damascus:"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":23,"end":null,"start":false,"text":"“Hamath and Arpad are put to shame,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":23,"end":null,"start":false,"text":"for they have heard a bad report;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":23,"end":null,"start":false,"text":"they are agitated like the sea;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":23,"end":null,"start":false,"text":"their anxiety cannot be calmed."}]},{"kind":"poetry","indent":1,"runs":[{"verse":24,"end":null,"start":true,"text":"Damascus has become feeble;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":24,"end":null,"start":false,"text":"she has turned to flee."}]},{"kind":"poetry","indent":1,"runs":[{"verse":24,"end":null,"start":false,"text":"Panic has gripped her;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":24,"end":null,"start":false,"text":"anguish and pain have seized her"}]},{"kind":"poetry","indent":2,"runs":[{"verse":24,"end":null,"start":false,"text":"like a woman in labor."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":25,"end":null,"start":true,"text":"How is the city of praise not forsaken,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":25,"end":null,"start":false,"text":"the town that brings Me joy?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":26,"end":null,"start":true,"text":"For her young men will fall in the streets,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":26,"end":null,"start":false,"text":"and all her warriors will be silenced in that day,”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":26,"end":null,"start":false,"text":"declares the LORD of Hosts."}]},{"kind":"poetry","indent":1,"runs":[{"verse":27,"end":null,"start":true,"text":"“I will set fire to the walls of Damascus;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":27,"end":null,"start":false,"text":"it will consume the fortresses of Ben-hadad.”"}]},{"kind":"heading","level":2,"text":"Judgment on Kedar and Hazor"},{"kind":"paragraph","indent":0,"runs":[{"verse":28,"end":null,"start":true,"text":"Concerning Kedar and the kingdoms of Hazor, which Nebuchadnezzar king of Babylon defeated, this is what the LORD says:"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":28,"end":null,"start":false,"text":"“Rise up, advance against Kedar,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":28,"end":null,"start":false,"text":"and destroy the people of the east!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":29,"end":null,"start":true,"text":"They will take their tents and flocks,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":29,"end":null,"start":false,"text":"their tent curtains and all their goods."}]},{"kind":"poetry","indent":1,"runs":[{"verse":29,"end":null,"start":false,"text":"They will take their camels for themselves."}]},{"kind":"poetry","indent":2,"runs":[{"verse":29,"end":null,"start":false,"text":"They will shout to them: ‘Terror is on every side!’"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":30,"end":null,"start":true,"text":"Run! Escape quickly!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":30,"end":null,"start":false,"text":"Lie low, O residents of Hazor,”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":30,"end":null,"start":false,"text":"declares the LORD,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":30,"end":null,"start":false,"text":"“for Nebuchadnezzar king of Babylon"}]},{"kind":"poetry","indent":2,"runs":[{"verse":30,"end":null,"start":false,"text":"has drawn up a plan against you;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":30,"end":null,"start":false,"text":"he has devised a strategy against you."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":31,"end":null,"start":true,"text":"Rise up, advance against a nation at ease,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":31,"end":null,"start":false,"text":"one that dwells securely,”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":31,"end":null,"start":false,"text":"declares the LORD."}]},{"kind":"poetry","indent":1,"runs":[{"verse":31,"end":null,"start":false,"text":"“They have no gates or bars;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":31,"end":null,"start":false,"text":"they live alone."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":32,"end":null,"start":true,"text":"Their camels will become plunder,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":32,"end":null,"start":false,"text":"and their large herds will be spoil."}]},{"kind":"poetry","indent":1,"runs":[{"verse":32,"end":null,"start":false,"text":"I will scatter to the wind in every direction"}]},{"kind":"poetry","indent":2,"runs":[{"verse":32,"end":null,"start":false,"text":"those who shave their temples;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":32,"end":null,"start":false,"text":"I will bring calamity on them"}]},{"kind":"poetry","indent":2,"runs":[{"verse":32,"end":null,"start":false,"text":"from all sides,”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":32,"end":null,"start":false,"text":"declares the LORD."}]},{"kind":"poetry","indent":1,"runs":[{"verse":33,"end":null,"start":true,"text":"“Hazor will become a haunt for jackals,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":33,"end":null,"start":false,"text":"a desolation forever."}]},{"kind":"poetry","indent":1,"runs":[{"verse":33,"end":null,"start":false,"text":"No one will dwell there;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":33,"end":null,"start":false,"text":"no man will abide there.”"}]},{"kind":"heading","level":2,"text":"Judgment on Elam"},{"kind":"paragraph","indent":0,"runs":[{"verse":34,"end":null,"start":true,"text":"This is the word of the LORD that came to Jeremiah the prophet concerning Elam at the beginning of the reign of Zedekiah king of Judah."},{"verse":35,"end":null,"start":true,"text":"This is what the LORD of Hosts says:"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":35,"end":null,"start":false,"text":"“Behold, I will shatter Elam’s bow,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":35,"end":null,"start":false,"text":"the mainstay of their might."}]},{"kind":"poetry","indent":1,"runs":[{"verse":36,"end":null,"start":true,"text":"I will bring the four winds against Elam"}]},{"kind":"poetry","indent":2,"runs":[{"verse":36,"end":null,"start":false,"text":"from the four corners of the heavens,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":36,"end":null,"start":false,"text":"and I will scatter them"}]},{"kind":"poetry","indent":2,"runs":[{"verse":36,"end":null,"start":false,"text":"to all these winds."}]},{"kind":"poetry","indent":1,"runs":[{"verse":36,"end":null,"start":false,"text":"There will not be a nation"}]},{"kind":"poetry","indent":2,"runs":[{"verse":36,"end":null,"start":false,"text":"to which Elam’s exiles will not go."}]},{"kind":"poetry","indent":1,"runs":[{"verse":37,"end":null,"start":true,"text":"So I will shatter Elam before their foes,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":37,"end":null,"start":false,"text":"before those who seek their lives."}]},{"kind":"poetry","indent":1,"runs":[{"verse":37,"end":null,"start":false,"text":"I will bring disaster upon them,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":37,"end":null,"start":false,"text":"even My fierce anger,”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":37,"end":null,"start":false,"text":"declares the LORD."}]},{"kind":"poetry","indent":1,"runs":[{"verse":37,"end":null,"start":false,"text":"“I will send out the sword after them"}]},{"kind":"poetry","indent":2,"runs":[{"verse":37,"end":null,"start":false,"text":"until I finish them off."}]},{"kind":"poetry","indent":1,"runs":[{"verse":38,"end":null,"start":true,"text":"I will set My throne in Elam,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":38,"end":null,"start":false,"text":"and destroy its king and officials,”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":38,"end":null,"start":false,"text":"declares the LORD."}]},{"kind":"poetry","indent":1,"runs":[{"verse":39,"end":null,"start":true,"text":"“Yet in the last days,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":39,"end":null,"start":false,"text":"I will restore Elam from captivity,”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":39,"end":null,"start":false,"text":"declares the LORD."}]}]}
