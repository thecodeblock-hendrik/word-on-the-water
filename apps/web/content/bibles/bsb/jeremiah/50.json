{"version":"bsb","book":"jeremiah","chapter":50,"blocks":[{"kind":"heading","level":2,"text":"A Prophecy against Babylon"},{"kind":"paragraph","indent":0,"runs":[{"verse":1,"end":null,"start":true,"text":"This is the word that the LORD spoke through Jeremiah the prophet concerning Babylon and the land of the Chaldeans:"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"“Announce and declare to the nations;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"lift up a banner and proclaim it;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"hold nothing back when you say,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":false,"text":"‘Babylon is captured;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"Bel is put to shame;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":false,"text":"Marduk is shattered,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"her images are disgraced,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"her idols are broken in pieces.’"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"For a nation from the north will come against her;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"it will make her land a desolation."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":false,"text":"No one will live in it;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"both man and beast will flee.”"}]},{"kind":"heading","level":2,"text":"Hope for Israel and Judah"},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"“In those days and at that time,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"declares the LORD,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":false,"text":"the children of Israel and the children of Judah"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"will come together, weeping as they come,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"and will seek the LORD their God."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"They will ask the way to Zion"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"and turn their faces toward it."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":false,"text":"They will come and join themselves to the LORD"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"in an everlasting covenant"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"that will never be forgotten."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"My people are lost sheep;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"their shepherds have led them astray,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"causing them to roam the mountains."}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":false,"text":"They have wandered from mountain to hill;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"they have forgotten their resting place."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"All who found them devoured them,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"and their enemies said,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":false,"text":"‘We are not guilty,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"for they have sinned against the LORD, their true pasture,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"the LORD, the hope of their fathers.’"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"Flee from the midst of Babylon;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"depart from the land of the Chaldeans;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"be like the he-goats that lead the flock."}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"For behold, I stir up and bring against Babylon"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"an assembly of great nations from the land of the north."}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":false,"text":"They will line up against her;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"from the north she will be captured."}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":false,"text":"Their arrows will be like skilled warriors"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"who do not return empty-handed."}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"Chaldea will be plundered;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"all who plunder her will have their fill,”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"declares the LORD."}]},{"kind":"heading","level":2,"text":"Babylon’s Fall Is Certain"},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"“Because you rejoice,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"because you sing in triumph—"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"you who plunder My inheritance—"}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":false,"text":"because you frolic like a heifer treading grain"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"and neigh like stallions,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"your mother will be greatly ashamed;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"she who bore you will be disgraced."}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":false,"text":"Behold, she will be the least of the nations,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"a wilderness, a dry land, and a desert."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":true,"text":"Because of the wrath of the LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"she will not be inhabited;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"she will become completely desolate."}]},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":false,"text":"All who pass through Babylon will be horrified"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"and will hiss at all her wounds."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":true,"text":"Line up in formation around Babylon,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"all you who draw the bow!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":false,"text":"Shoot at her! Spare no arrows!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"For she has sinned against the LORD."}]},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":true,"text":"Raise a war cry against her on every side!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"She has thrown up her hands in surrender;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":false,"text":"her towers have fallen;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"her walls are torn down."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":false,"text":"Since this is the vengeance of the LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"take out your vengeance upon her;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":false,"text":"as she has done,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"do the same to her."}]},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":true,"text":"Cut off the sower from Babylon,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"and the one who wields the sickle at harvest time."}]},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":false,"text":"In the face of the oppressor’s sword,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"each will turn to his own people,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"each will flee to his own land."}]},{"kind":"heading","level":2,"text":"Redemption for God’s People"},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":true,"text":"Israel is a scattered flock,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"chased away by lions."}]},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":false,"text":"The first to devour him"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"was the king of Assyria;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":false,"text":"the last to crush his bones"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"was Nebuchadnezzar king of Babylon.”"}]},{"kind":"paragraph","indent":0,"runs":[{"verse":18,"end":null,"start":true,"text":"Therefore this is what the LORD of Hosts, the God of Israel, says:"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":false,"text":"“I will punish the king of Babylon and his land"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"as I punished the king of Assyria."}]},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":true,"text":"I will return Israel to his pasture,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"and he will graze on Carmel and Bashan;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":false,"text":"his soul will be satisfied"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"on the hills of Ephraim and Gilead."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":true,"text":"In those days and at that time,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"declares the LORD,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":false,"text":"a search will be made for Israel’s guilt,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"but there will be none,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":false,"text":"and for Judah’s sins,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"but they will not be found;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":false,"text":"for I will forgive"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"the remnant I preserve."}]},{"kind":"heading","level":2,"text":"The Destruction of Babylon"},{"kind":"poetry","indent":1,"runs":[{"verse":21,"end":null,"start":true,"text":"Go up against the land of Merathaim,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":21,"end":null,"start":false,"text":"and against the residents of Pekod."}]},{"kind":"poetry","indent":1,"runs":[{"verse":21,"end":null,"start":false,"text":"Kill them and devote them to destruction."}]},{"kind":"poetry","indent":2,"runs":[{"verse":21,"end":null,"start":false,"text":"Do all that I have commanded you,”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":21,"end":null,"start":false,"text":"declares the LORD."}]},{"kind":"poetry","indent":1,"runs":[{"verse":22,"end":null,"start":true,"text":"“The noise of battle is in the land —"}]},{"kind":"poetry","indent":2,"runs":[{"verse":22,"end":null,"start":false,"text":"the noise of great destruction."}]},{"kind":"poetry","indent":1,"runs":[{"verse":23,"end":null,"start":true,"text":"How the hammer of the whole earth"}]},{"kind":"poetry","indent":2,"runs":[{"verse":23,"end":null,"start":false,"text":"lies broken and shattered!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":23,"end":null,"start":false,"text":"What a horror Babylon has become"}]},{"kind":"poetry","indent":2,"runs":[{"verse":23,"end":null,"start":false,"text":"among the nations!"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":24,"end":null,"start":true,"text":"I laid a snare for you, O Babylon,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":24,"end":null,"start":false,"text":"and you were caught before you knew it."}]},{"kind":"poetry","indent":1,"runs":[{"verse":24,"end":null,"start":false,"text":"You were found and captured"}]},{"kind":"poetry","indent":2,"runs":[{"verse":24,"end":null,"start":false,"text":"because you challenged the LORD."}]},{"kind":"poetry","indent":1,"runs":[{"verse":25,"end":null,"start":true,"text":"The LORD has opened His armory"}]},{"kind":"poetry","indent":2,"runs":[{"verse":25,"end":null,"start":false,"text":"and brought out His weapons of wrath,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":25,"end":null,"start":false,"text":"for this is the work of the Lord GOD of Hosts"}]},{"kind":"poetry","indent":2,"runs":[{"verse":25,"end":null,"start":false,"text":"in the land of the Chaldeans."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":26,"end":null,"start":true,"text":"Come against her"}]},{"kind":"poetry","indent":2,"runs":[{"verse":26,"end":null,"start":false,"text":"from the farthest border."}]},{"kind":"poetry","indent":1,"runs":[{"verse":26,"end":null,"start":false,"text":"Break open her granaries;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":26,"end":null,"start":false,"text":"pile her up like mounds of grain."}]},{"kind":"poetry","indent":1,"runs":[{"verse":26,"end":null,"start":false,"text":"Devote her to destruction;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":26,"end":null,"start":false,"text":"leave her no survivors."}]},{"kind":"poetry","indent":1,"runs":[{"verse":27,"end":null,"start":true,"text":"Kill all her young bulls;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":27,"end":null,"start":false,"text":"let them go down to the slaughter."}]},{"kind":"poetry","indent":1,"runs":[{"verse":27,"end":null,"start":false,"text":"Woe to them, for their day has come —"}]},{"kind":"poetry","indent":2,"runs":[{"verse":27,"end":null,"start":false,"text":"the time of their punishment."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":28,"end":null,"start":true,"text":"Listen to the fugitives and refugees"}]},{"kind":"poetry","indent":2,"runs":[{"verse":28,"end":null,"start":false,"text":"from the land of Babylon,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":28,"end":null,"start":false,"text":"declaring in Zion the vengeance of the LORD our God,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":28,"end":null,"start":false,"text":"the vengeance for His temple."}]},{"kind":"poetry","indent":1,"runs":[{"verse":29,"end":null,"start":true,"text":"Summon the archers against Babylon,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":29,"end":null,"start":false,"text":"all who string the bow."}]},{"kind":"poetry","indent":1,"runs":[{"verse":29,"end":null,"start":false,"text":"Encamp all around her;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":29,"end":null,"start":false,"text":"let no one escape."}]},{"kind":"poetry","indent":1,"runs":[{"verse":29,"end":null,"start":false,"text":"Repay her according to her deeds;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":29,"end":null,"start":false,"text":"do to her as she has done."}]},{"kind":"poetry","indent":1,"runs":[{"verse":29,"end":null,"start":false,"text":"For she has defied the LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":29,"end":null,"start":false,"text":"the Holy One of Israel."}]},{"kind":"poetry","indent":1,"runs":[{"verse":30,"end":null,"start":true,"text":"Therefore, her young men will fall in the streets,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":30,"end":null,"start":false,"text":"and all her warriors will be silenced in that day,”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":30,"end":null,"start":false,"text":"declares the LORD."}]},{"kind":"poetry","indent":1,"runs":[{"verse":31,"end":null,"start":true,"text":"“Behold, I am against you, O arrogant one,”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":31,"end":null,"start":false,"text":"declares the Lord GOD of Hosts,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":31,"end":null,"start":false,"text":"“for your day has come,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":31,"end":null,"start":false,"text":"the time when I will punish you."}]},{"kind":"poetry","indent":1,"runs":[{"verse":32,"end":null,"start":true,"text":"The arrogant one will stumble and fall"}]},{"kind":"poetry","indent":2,"runs":[{"verse":32,"end":null,"start":false,"text":"with no one to pick him up."}]},{"kind":"poetry","indent":1,"runs":[{"verse":32,"end":null,"start":false,"text":"And I will kindle a fire in his cities"}]},{"kind":"poetry","indent":2,"runs":[{"verse":32,"end":null,"start":false,"text":"to consume all those around him.”"}]},{"kind":"paragraph","indent":0,"runs":[{"verse":33,"end":null,"start":true,"text":"This is what the LORD of Hosts says:"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":33,"end":null,"start":false,"text":"“The sons of Israel are oppressed,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":33,"end":null,"start":false,"text":"and the sons of Judah as well."}]},{"kind":"poetry","indent":1,"runs":[{"verse":33,"end":null,"start":false,"text":"All their captors hold them fast,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":33,"end":null,"start":false,"text":"refusing to release them."}]},{"kind":"poetry","indent":1,"runs":[{"verse":34,"end":null,"start":true,"text":"Their Redeemer is strong;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":34,"end":null,"start":false,"text":"the LORD of Hosts is His name."}]},{"kind":"poetry","indent":1,"runs":[{"verse":34,"end":null,"start":false,"text":"He will fervently plead their case"}]},{"kind":"poetry","indent":2,"runs":[{"verse":34,"end":null,"start":false,"text":"so that He may bring rest to the earth,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":34,"end":null,"start":false,"text":"but turmoil to those who live in Babylon."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":35,"end":null,"start":true,"text":"A sword is against the Chaldeans,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":35,"end":null,"start":false,"text":"declares the LORD,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":35,"end":null,"start":false,"text":"against those who live in Babylon,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":35,"end":null,"start":false,"text":"and against her officials and wise men."}]},{"kind":"poetry","indent":1,"runs":[{"verse":36,"end":null,"start":true,"text":"A sword is against her false prophets,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":36,"end":null,"start":false,"text":"and they will become fools."}]},{"kind":"poetry","indent":1,"runs":[{"verse":36,"end":null,"start":false,"text":"A sword is against her warriors,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":36,"end":null,"start":false,"text":"and they will be filled with terror."}]},{"kind":"poetry","indent":1,"runs":[{"verse":37,"end":null,"start":true,"text":"A sword is against her horses and chariots"}]},{"kind":"poetry","indent":2,"runs":[{"verse":37,"end":null,"start":false,"text":"and against all the foreigners in her midst,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":37,"end":null,"start":false,"text":"and they will become like women."}]},{"kind":"poetry","indent":1,"runs":[{"verse":37,"end":null,"start":false,"text":"A sword is against her treasuries,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":37,"end":null,"start":false,"text":"and they will be plundered."}]},{"kind":"poetry","indent":1,"runs":[{"verse":38,"end":null,"start":true,"text":"A drought is upon her waters,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":38,"end":null,"start":false,"text":"and they will be dried up."}]},{"kind":"poetry","indent":1,"runs":[{"verse":38,"end":null,"start":false,"text":"For it is a land of graven images,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":38,"end":null,"start":false,"text":"and the people go mad over idols."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":39,"end":null,"start":true,"text":"So the desert creatures and hyenas will live there"}]},{"kind":"poetry","indent":2,"runs":[{"verse":39,"end":null,"start":false,"text":"and ostriches will dwell there."}]},{"kind":"poetry","indent":1,"runs":[{"verse":39,"end":null,"start":false,"text":"It will never again be inhabited"}]},{"kind":"poetry","indent":2,"runs":[{"verse":39,"end":null,"start":false,"text":"or lived in from generation to generation."}]},{"kind":"poetry","indent":1,"runs":[{"verse":40,"end":null,"start":true,"text":"As God overthrew Sodom and Gomorrah"}]},{"kind":"poetry","indent":2,"runs":[{"verse":40,"end":null,"start":false,"text":"along with their neighbors,”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":40,"end":null,"start":false,"text":"declares the LORD,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":40,"end":null,"start":false,"text":"“no one will dwell there;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":40,"end":null,"start":false,"text":"no man will abide there."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":41,"end":null,"start":true,"text":"Behold, an army is coming from the north;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":41,"end":null,"start":false,"text":"a great nation and many kings are stirred up"}]},{"kind":"poetry","indent":2,"runs":[{"verse":41,"end":null,"start":false,"text":"from the ends of the earth."}]},{"kind":"poetry","indent":1,"runs":[{"verse":42,"end":null,"start":true,"text":"They grasp the bow and spear;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":42,"end":null,"start":false,"text":"they are cruel and merciless."}]},{"kind":"poetry","indent":1,"runs":[{"verse":42,"end":null,"start":false,"text":"Their voice roars like the sea,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":42,"end":null,"start":false,"text":"and they ride upon horses,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":42,"end":null,"start":false,"text":"lined up like men in formation"}]},{"kind":"poetry","indent":2,"runs":[{"verse":42,"end":null,"start":false,"text":"against you, O Daughter of Babylon."}]},{"kind":"poetry","indent":1,"runs":[{"verse":43,"end":null,"start":true,"text":"The king of Babylon has heard the report,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":43,"end":null,"start":false,"text":"and his hands hang limp."}]},{"kind":"poetry","indent":1,"runs":[{"verse":43,"end":null,"start":false,"text":"Anguish has gripped him,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":43,"end":null,"start":false,"text":"pain like that of a woman in labor."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":44,"end":null,"start":true,"text":"Behold, one will come up like a lion"}]},{"kind":"poetry","indent":2,"runs":[{"verse":44,"end":null,"start":false,"text":"from the thickets of the Jordan to the watered pasture."}]},{"kind":"poetry","indent":1,"runs":[{"verse":44,"end":null,"start":false,"text":"For in an instant I will chase Babylon from her land."}]},{"kind":"poetry","indent":2,"runs":[{"verse":44,"end":null,"start":false,"text":"Who is the chosen one I will appoint for this?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":44,"end":null,"start":false,"text":"For who is like Me, and who can challenge Me?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":44,"end":null,"start":false,"text":"What shepherd can stand against Me?”"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":45,"end":null,"start":true,"text":"Therefore hear the plans"}]},{"kind":"poetry","indent":2,"runs":[{"verse":45,"end":null,"start":false,"text":"that the LORD has drawn up against Babylon"}]},{"kind":"poetry","indent":1,"runs":[{"verse":45,"end":null,"start":false,"text":"and the strategies He has devised"}]},{"kind":"poetry","indent":2,"runs":[{"verse":45,"end":null,"start":false,"text":"against the land of the Chaldeans:"}]},{"kind":"poetry","indent":1,"runs":[{"verse":45,"end":null,"start":false,"text":"Surely the little ones of the flock will be dragged away;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":45,"end":null,"start":false,"text":"certainly their pasture will be made desolate because of them."}]},{"kind":"poetry","indent":1,"runs":[{"verse":46,"end":null,"start":true,"text":"At the sound of Babylon’s capture the earth will quake;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":46,"end":null,"start":false,"text":"a cry will be heard among the nations."}]}]}
