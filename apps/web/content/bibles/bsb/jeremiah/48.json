{"version":"bsb","book":"jeremiah","chapter":48,"blocks":[{"kind":"heading","level":2,"text":"Judgment on Moab"},{"kind":"paragraph","indent":0,"runs":[{"verse":1,"end":null,"start":true,"text":"Concerning Moab, this is what the LORD of Hosts, the God of Israel, says:"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":false,"text":"“Woe to Nebo,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"for it will be devastated."}]},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":false,"text":"Kiriathaim will be captured and disgraced;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"the fortress will be shattered and dismantled."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"There is no longer praise for Moab;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"in Heshbon they devise evil against her:"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"‘Come, let us cut her off from nationhood.’"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":false,"text":"You too, O people of Madmen, will be silenced;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"the sword will pursue you."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"A voice cries out from Horonaim:"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"‘Devastation and great destruction!’"}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"Moab will be shattered;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"her little ones will cry out."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"For on the ascent to Luhith"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"they weep bitterly as they go,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":false,"text":"and on the descent to Horonaim"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"cries of distress resound"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"over the destruction:"}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"‘Flee! Run for your lives!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"Become like a juniper in the desert.’"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"Because you trust in your works and treasures,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"you too will be captured,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":false,"text":"and Chemosh will go into exile"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"with his priests and officials."}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"The destroyer will move against every city,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"and not one town will escape."}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":false,"text":"The valley will also be ruined,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"and the high plain will be destroyed,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"as the LORD has said."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"Put salt on Moab,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"for she will be laid waste;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":false,"text":"her cities will become desolate,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"with no one to dwell in them."}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"Cursed is the one who is remiss"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"in doing the work of the LORD,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":false,"text":"and cursed is he who withholds"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"his sword from bloodshed."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"Moab has been at ease from youth,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"settled like wine on its dregs;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":false,"text":"he has not been poured from vessel to vessel"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"or gone into exile."}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":false,"text":"So his flavor has remained the same,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"and his aroma is unchanged."}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"Therefore behold, the days are coming,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"declares the LORD,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":false,"text":"when I will send to him wanderers,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"who will pour him out."}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":false,"text":"They will empty his vessels"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"and shatter his jars."}]},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":true,"text":"Then Moab will be ashamed of Chemosh,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"just as the house of Israel was ashamed"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"when they trusted in Bethel."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":true,"text":"How can you say, ‘We are warriors,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"mighty men ready for battle’ ?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":true,"text":"Moab has been destroyed"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"and its towns have been invaded;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":false,"text":"the best of its young men"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"have gone down in the slaughter,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":false,"text":"declares the King,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"whose name is the LORD of Hosts."}]},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":true,"text":"Moab’s calamity is at hand,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"and his affliction is rushing swiftly."}]},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":true,"text":"Mourn for him, all you who surround him,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"everyone who knows his name;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":false,"text":"tell how the mighty scepter is shattered —"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"the glorious staff!"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":true,"text":"Come down from your glory; sit on parched ground,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"O daughter dwelling in Dibon,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":false,"text":"for the destroyer of Moab has come against you;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"he has destroyed your fortresses."}]},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":true,"text":"Stand by the road and watch,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"O dweller of Aroer!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":false,"text":"Ask the man fleeing or the woman escaping,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"‘What has happened?’"}]},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":true,"text":"Moab is put to shame, for it has been shattered."}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"Wail and cry out!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":false,"text":"Declare by the Arnon"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"that Moab is destroyed."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":21,"end":null,"start":true,"text":"Judgment has come upon the high plain—"}]},{"kind":"poetry","indent":2,"runs":[{"verse":21,"end":null,"start":false,"text":"upon Holon, Jahzah, and Mephaath,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":22,"end":null,"start":true,"text":"upon Dibon, Nebo, and Beth-diblathaim,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":23,"end":null,"start":true,"text":"upon Kiriathaim, Beth-gamul, and Beth-meon,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":24,"end":null,"start":true,"text":"upon Kerioth, Bozrah, and all the towns of Moab,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":24,"end":null,"start":false,"text":"those far and near."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":25,"end":null,"start":true,"text":"The horn of Moab has been cut off,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":25,"end":null,"start":false,"text":"and his arm is broken,”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":25,"end":null,"start":false,"text":"declares the LORD."}]},{"kind":"poetry","indent":1,"runs":[{"verse":26,"end":null,"start":true,"text":"“Make him drunk,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":26,"end":null,"start":false,"text":"because he has magnified himself against the LORD;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":26,"end":null,"start":false,"text":"so Moab will wallow in his own vomit,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":26,"end":null,"start":false,"text":"and he will also become a laughingstock."}]},{"kind":"poetry","indent":1,"runs":[{"verse":27,"end":null,"start":true,"text":"Was not Israel your object of ridicule?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":27,"end":null,"start":false,"text":"Was he ever found among thieves?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":27,"end":null,"start":false,"text":"For whenever you speak of him"}]},{"kind":"poetry","indent":2,"runs":[{"verse":27,"end":null,"start":false,"text":"you shake your head."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":28,"end":null,"start":true,"text":"Abandon the towns and settle among the rocks,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":28,"end":null,"start":false,"text":"O dwellers of Moab!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":28,"end":null,"start":false,"text":"Be like a dove"}]},{"kind":"poetry","indent":2,"runs":[{"verse":28,"end":null,"start":false,"text":"that nests at the mouth of a cave."}]},{"kind":"poetry","indent":1,"runs":[{"verse":29,"end":null,"start":true,"text":"We have heard of Moab’s pomposity,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":29,"end":null,"start":false,"text":"his exceeding pride and conceit,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":29,"end":null,"start":false,"text":"his proud arrogance and haughtiness of heart."}]},{"kind":"poetry","indent":1,"runs":[{"verse":30,"end":null,"start":true,"text":"I know his insolence,”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":30,"end":null,"start":false,"text":"declares the LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":30,"end":null,"start":false,"text":"“but it is futile."}]},{"kind":"poetry","indent":2,"runs":[{"verse":30,"end":null,"start":false,"text":"His boasting is as empty as his deeds."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":31,"end":null,"start":true,"text":"Therefore I will wail for Moab;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":31,"end":null,"start":false,"text":"I will cry out for all of Moab;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":31,"end":null,"start":false,"text":"I will moan for the men of Kir-heres."}]},{"kind":"poetry","indent":1,"runs":[{"verse":32,"end":null,"start":true,"text":"I will weep for you, O vine of Sibmah,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":32,"end":null,"start":false,"text":"more than I weep for Jazer."}]},{"kind":"poetry","indent":1,"runs":[{"verse":32,"end":null,"start":false,"text":"Your tendrils have extended to the sea;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":32,"end":null,"start":false,"text":"they reach even to Jazer."}]},{"kind":"poetry","indent":1,"runs":[{"verse":32,"end":null,"start":false,"text":"The destroyer has descended"}]},{"kind":"poetry","indent":2,"runs":[{"verse":32,"end":null,"start":false,"text":"on your summer fruit and grape harvest."}]},{"kind":"poetry","indent":1,"runs":[{"verse":33,"end":null,"start":true,"text":"Joy and gladness are removed from the orchard"}]},{"kind":"poetry","indent":2,"runs":[{"verse":33,"end":null,"start":false,"text":"and from the fields of Moab."}]},{"kind":"poetry","indent":1,"runs":[{"verse":33,"end":null,"start":false,"text":"I have stopped the flow of wine from the presses;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":33,"end":null,"start":false,"text":"no one treads them with shouts of joy;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":33,"end":null,"start":false,"text":"their shouts are not for joy."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":34,"end":null,"start":true,"text":"There is a cry from Heshbon to Elealeh;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":34,"end":null,"start":false,"text":"they raise their voices to Jahaz,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":34,"end":null,"start":false,"text":"from Zoar to Horonaim and Eglath-shelishiyah;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":34,"end":null,"start":false,"text":"for even the waters of Nimrim have dried up."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":35,"end":null,"start":true,"text":"In Moab, declares the LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":35,"end":null,"start":false,"text":"I will bring an end"}]},{"kind":"poetry","indent":1,"runs":[{"verse":35,"end":null,"start":false,"text":"to those who make offerings on the high places"}]},{"kind":"poetry","indent":2,"runs":[{"verse":35,"end":null,"start":false,"text":"and burn incense to their gods."}]},{"kind":"poetry","indent":1,"runs":[{"verse":36,"end":null,"start":true,"text":"Therefore My heart laments like a flute for Moab;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":36,"end":null,"start":false,"text":"it laments like a flute for the men of Kir-heres,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":36,"end":null,"start":false,"text":"because the wealth they acquired has perished."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":37,"end":null,"start":true,"text":"For every head is shaved"}]},{"kind":"poetry","indent":2,"runs":[{"verse":37,"end":null,"start":false,"text":"and every beard is clipped;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":37,"end":null,"start":false,"text":"on every hand is a gash,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":37,"end":null,"start":false,"text":"and around every waist is sackcloth."}]},{"kind":"poetry","indent":1,"runs":[{"verse":38,"end":null,"start":true,"text":"On all the rooftops of Moab"}]},{"kind":"poetry","indent":2,"runs":[{"verse":38,"end":null,"start":false,"text":"and in the public squares,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":38,"end":null,"start":false,"text":"everyone is mourning;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":38,"end":null,"start":false,"text":"for I have shattered Moab like an unwanted jar,”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":38,"end":null,"start":false,"text":"declares the LORD."}]},{"kind":"poetry","indent":1,"runs":[{"verse":39,"end":null,"start":true,"text":"“How shattered it is! How they wail!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":39,"end":null,"start":false,"text":"How Moab has turned his back in shame!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":39,"end":null,"start":false,"text":"Moab has become an object of ridicule and horror"}]},{"kind":"poetry","indent":2,"runs":[{"verse":39,"end":null,"start":false,"text":"to all those around him.”"}]},{"kind":"paragraph","indent":0,"runs":[{"verse":40,"end":null,"start":true,"text":"For this is what the LORD says:"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":40,"end":null,"start":false,"text":"“Behold, an eagle swoops down"}]},{"kind":"poetry","indent":2,"runs":[{"verse":40,"end":null,"start":false,"text":"and spreads his wings against Moab."}]},{"kind":"poetry","indent":1,"runs":[{"verse":41,"end":null,"start":true,"text":"Kirioth has been taken,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":41,"end":null,"start":false,"text":"and the strongholds seized."}]},{"kind":"poetry","indent":1,"runs":[{"verse":41,"end":null,"start":false,"text":"In that day the heart of Moab’s warriors"}]},{"kind":"poetry","indent":2,"runs":[{"verse":41,"end":null,"start":false,"text":"will be like the heart of a woman in labor."}]},{"kind":"poetry","indent":1,"runs":[{"verse":42,"end":null,"start":true,"text":"Moab will be destroyed as a nation"}]},{"kind":"poetry","indent":2,"runs":[{"verse":42,"end":null,"start":false,"text":"because he vaunted himself against the LORD."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":43,"end":null,"start":true,"text":"Terror and pit and snare await you, O dweller of Moab,”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":43,"end":null,"start":false,"text":"declares the LORD."}]},{"kind":"poetry","indent":1,"runs":[{"verse":44,"end":null,"start":true,"text":"“Whoever flees the panic"}]},{"kind":"poetry","indent":2,"runs":[{"verse":44,"end":null,"start":false,"text":"will fall into the pit,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":44,"end":null,"start":false,"text":"and whoever climbs from the pit"}]},{"kind":"poetry","indent":2,"runs":[{"verse":44,"end":null,"start":false,"text":"will be caught in the snare."}]},{"kind":"poetry","indent":1,"runs":[{"verse":44,"end":null,"start":false,"text":"For I will bring upon Moab"}]},{"kind":"poetry","indent":2,"runs":[{"verse":44,"end":null,"start":false,"text":"the year of their punishment,”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":44,"end":null,"start":false,"text":"declares the LORD."}]},{"kind":"poetry","indent":1,"runs":[{"verse":45,"end":null,"start":true,"text":"“Those who flee will stand helpless in Heshbon’s shadow,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":45,"end":null,"start":false,"text":"because fire has gone forth from Heshbon"}]},{"kind":"poetry","indent":2,"runs":[{"verse":45,"end":null,"start":false,"text":"and a flame from within Sihon."}]},{"kind":"poetry","indent":1,"runs":[{"verse":45,"end":null,"start":false,"text":"It devours the foreheads of Moab"}]},{"kind":"poetry","indent":2,"runs":[{"verse":45,"end":null,"start":false,"text":"and the skulls of the sons of tumult."}]},{"kind":"poetry","indent":1,"runs":[{"verse":46,"end":null,"start":true,"text":"Woe to you, O Moab!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":46,"end":null,"start":false,"text":"The people of Chemosh have perished;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":46,"end":null,"start":false,"text":"for your sons have been taken into exile"}]},{"kind":"poetry","indent":2,"runs":[{"verse":46,"end":null,"start":false,"text":"and your daughters have gone into captivity."}]},{"kind":"poetry","indent":1,"runs":[{"verse":47,"end":null,"start":true,"text":"Yet in the latter days I will restore Moab from captivity,”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":47,"end":null,"start":false,"text":"declares the LORD."}]},{"kind":"paragraph","indent":0,"runs":[{"verse":47,"end":null,"start":false,"text":"Here ends the judgment on Moab."}]}]}
