{"version":"bsb","book":"jeremiah","chapter":2,"blocks":[{"kind":"heading","level":2,"text":"Israel Has Forsaken God"},{"kind":"paragraph","indent":0,"runs":[{"verse":1,"end":null,"start":true,"text":"Now the word of the LORD came to me, saying,"},{"verse":2,"end":null,"start":true,"text":"“Go and proclaim in the hearing of Jerusalem that this is what the LORD says:"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":false,"text":"‘I remember the devotion of your youth,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"your love as a bride,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":false,"text":"how you followed Me in the wilderness,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"in a land not sown."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"Israel was holy to the LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"the firstfruits of His harvest."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":false,"text":"All who devoured her"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"were found guilty;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":false,"text":"disaster came upon them,’”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"declares the LORD."}]},{"kind":"paragraph","indent":0,"runs":[{"verse":4,"end":null,"start":true,"text":"Hear the word of the LORD, O house of Jacob, and all you families of the house of Israel."},{"verse":5,"end":null,"start":true,"text":"This is what the LORD says:"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":false,"text":"“What fault did your fathers find in Me"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"that they strayed so far from Me?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":false,"text":"They followed worthless idols,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"and became worthless themselves."}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"They did not ask, ‘Where is the LORD"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"who brought us up from the land of Egypt,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":false,"text":"who led us through the wilderness,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"through a land of deserts and pits,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":false,"text":"a land of drought and darkness,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"a land where no one travels and no one lives?’"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"I brought you into a fertile land"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"to eat its fruit and bounty,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":false,"text":"but you came and defiled My land"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"and made My inheritance detestable."}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"The priests did not ask,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"‘Where is the LORD?’"}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":false,"text":"The experts in the law no longer knew Me,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"and the leaders rebelled against Me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":false,"text":"The prophets prophesied by Baal"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"and followed useless idols."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"Therefore, I will contend with you again,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"declares the LORD,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":false,"text":"and I will bring a case"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"against your children’s children."}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"Cross over to the coasts of Cyprus"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"and take a look;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":false,"text":"send to Kedar and consider carefully;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"see if there has ever been anything like this:"}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"Has a nation ever changed its gods?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"(Yet they are not gods at all.)"}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":false,"text":"But My people have exchanged their Glory"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"for useless idols."}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"Be stunned by this, O heavens;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"be shocked and utterly appalled,”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"declares the LORD."}]},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":true,"text":"“For My people have committed two evils:"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":false,"text":"They have forsaken Me,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"the fountain of living water,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":false,"text":"and they have dug their own cisterns —"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"broken cisterns that cannot hold water."}]},{"kind":"heading","level":2,"text":"The Consequence of Israel’s Sin"},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":true,"text":"Is Israel a slave?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"Was he born into slavery?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"Why then has he become prey?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":true,"text":"The young lions have roared at him;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"they have sounded their voices."}]},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":false,"text":"They have laid waste his land;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"his cities lie in ruins, without inhabitant."}]},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":true,"text":"The men of Memphis and Tahpanhes"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"have shaved the crown of your head."}]},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":true,"text":"Have you not brought this on yourself"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"by forsaking the LORD your God"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"when He led you in the way?"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":true,"text":"Now what will you gain on your way to Egypt"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"to drink the waters of the Nile?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":false,"text":"What will you gain on your way to Assyria"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"to drink the waters of the Euphrates?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":true,"text":"Your own evil will discipline you;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"your own apostasies will reprimand you."}]},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":false,"text":"Consider and realize"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"how evil and bitter it is"}]},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":false,"text":"for you to forsake the LORD your God"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"and to have no fear of Me,”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"declares the Lord GOD of Hosts."}]},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":true,"text":"“For long ago you broke your yoke"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"and tore off your chains,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"saying, ‘I will not serve!’"}]},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":false,"text":"Indeed, on every high hill"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"and under every green tree"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"you lay down as a prostitute."}]},{"kind":"poetry","indent":1,"runs":[{"verse":21,"end":null,"start":true,"text":"I had planted you like a choice vine"}]},{"kind":"poetry","indent":2,"runs":[{"verse":21,"end":null,"start":false,"text":"from the very best seed."}]},{"kind":"poetry","indent":1,"runs":[{"verse":21,"end":null,"start":false,"text":"How could you turn yourself before Me"}]},{"kind":"poetry","indent":2,"runs":[{"verse":21,"end":null,"start":false,"text":"into a rotten, wild vine?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":22,"end":null,"start":true,"text":"Although you wash with lye"}]},{"kind":"poetry","indent":2,"runs":[{"verse":22,"end":null,"start":false,"text":"and use an abundance of soap,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":22,"end":null,"start":false,"text":"the stain of your guilt"}]},{"kind":"poetry","indent":2,"runs":[{"verse":22,"end":null,"start":false,"text":"is still before Me,”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":22,"end":null,"start":false,"text":"declares the Lord GOD."}]},{"kind":"heading","level":2,"text":"Israel’s Unfaithfulness"},{"kind":"poetry","indent":1,"runs":[{"verse":23,"end":null,"start":true,"text":"“How can you say, ‘I am not defiled;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":23,"end":null,"start":false,"text":"I have not run after the Baals’?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":23,"end":null,"start":false,"text":"Look at your behavior in the valley;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":23,"end":null,"start":false,"text":"acknowledge what you have done."}]},{"kind":"poetry","indent":1,"runs":[{"verse":23,"end":null,"start":false,"text":"You are a swift young she-camel"}]},{"kind":"poetry","indent":2,"runs":[{"verse":23,"end":null,"start":false,"text":"galloping here and there,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":24,"end":null,"start":true,"text":"a wild donkey at home in the wilderness,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":24,"end":null,"start":false,"text":"sniffing the wind in the heat of her desire."}]},{"kind":"poetry","indent":2,"runs":[{"verse":24,"end":null,"start":false,"text":"Who can restrain her passion?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":24,"end":null,"start":false,"text":"All who seek her need not weary themselves;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":24,"end":null,"start":false,"text":"in mating season they will find her."}]},{"kind":"poetry","indent":1,"runs":[{"verse":25,"end":null,"start":true,"text":"You should have kept your feet from going bare"}]},{"kind":"poetry","indent":2,"runs":[{"verse":25,"end":null,"start":false,"text":"and your throat from being thirsty."}]},{"kind":"poetry","indent":1,"runs":[{"verse":25,"end":null,"start":false,"text":"But you said, ‘It is hopeless!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":25,"end":null,"start":false,"text":"For I love foreign gods,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":25,"end":null,"start":false,"text":"and I must go after them.’"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":26,"end":null,"start":true,"text":"As the thief is ashamed when he is caught,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":26,"end":null,"start":false,"text":"so the house of Israel is disgraced."}]},{"kind":"poetry","indent":1,"runs":[{"verse":26,"end":null,"start":false,"text":"They, their kings, their officials,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":26,"end":null,"start":false,"text":"their priests, and their prophets"}]},{"kind":"poetry","indent":1,"runs":[{"verse":27,"end":null,"start":true,"text":"say to a tree, ‘You are my father,’"}]},{"kind":"poetry","indent":2,"runs":[{"verse":27,"end":null,"start":false,"text":"and to a stone, ‘You gave me birth.’"}]},{"kind":"poetry","indent":1,"runs":[{"verse":27,"end":null,"start":false,"text":"They have turned their backs to Me"}]},{"kind":"poetry","indent":2,"runs":[{"verse":27,"end":null,"start":false,"text":"and not their faces."}]},{"kind":"poetry","indent":1,"runs":[{"verse":27,"end":null,"start":false,"text":"Yet in the time of trouble, they say,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":27,"end":null,"start":false,"text":"‘Rise up and save us!’"}]},{"kind":"poetry","indent":1,"runs":[{"verse":28,"end":null,"start":true,"text":"But where are the gods you made for yourselves?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":28,"end":null,"start":false,"text":"Let them rise up in your time of trouble"}]},{"kind":"poetry","indent":2,"runs":[{"verse":28,"end":null,"start":false,"text":"and save you if they can;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":28,"end":null,"start":false,"text":"for your gods are as numerous"}]},{"kind":"poetry","indent":2,"runs":[{"verse":28,"end":null,"start":false,"text":"as your cities, O Judah."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":29,"end":null,"start":true,"text":"Why do you bring a case against Me?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":29,"end":null,"start":false,"text":"You have all rebelled against Me,”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":29,"end":null,"start":false,"text":"declares the LORD."}]},{"kind":"poetry","indent":1,"runs":[{"verse":30,"end":null,"start":true,"text":"“I have struck your sons in vain;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":30,"end":null,"start":false,"text":"they accepted no discipline."}]},{"kind":"poetry","indent":1,"runs":[{"verse":30,"end":null,"start":false,"text":"Your own sword has devoured your prophets"}]},{"kind":"poetry","indent":2,"runs":[{"verse":30,"end":null,"start":false,"text":"like a voracious lion.”"}]},{"kind":"paragraph","indent":0,"runs":[{"verse":31,"end":null,"start":true,"text":"You people of this generation, consider the word of the LORD:"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":31,"end":null,"start":false,"text":"“Have I been a wilderness to Israel"}]},{"kind":"poetry","indent":2,"runs":[{"verse":31,"end":null,"start":false,"text":"or a land of dense darkness?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":31,"end":null,"start":false,"text":"Why do My people say,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":31,"end":null,"start":false,"text":"‘We are free to roam;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":31,"end":null,"start":false,"text":"we will come to You no more’?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":32,"end":null,"start":true,"text":"Does a maiden forget her jewelry"}]},{"kind":"poetry","indent":2,"runs":[{"verse":32,"end":null,"start":false,"text":"or a bride her wedding sash?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":32,"end":null,"start":false,"text":"Yet My people have forgotten Me"}]},{"kind":"poetry","indent":2,"runs":[{"verse":32,"end":null,"start":false,"text":"for days without number."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":33,"end":null,"start":true,"text":"How skillfully you pursue love!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":33,"end":null,"start":false,"text":"Even the most immoral of women"}]},{"kind":"poetry","indent":2,"runs":[{"verse":33,"end":null,"start":false,"text":"could learn from your ways."}]},{"kind":"poetry","indent":1,"runs":[{"verse":34,"end":null,"start":true,"text":"Moreover, your skirts are stained"}]},{"kind":"poetry","indent":2,"runs":[{"verse":34,"end":null,"start":false,"text":"with the blood of the innocent poor,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":34,"end":null,"start":false,"text":"though you did not find them breaking in."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":34,"end":null,"start":false,"text":"But in spite of all these things"}]},{"kind":"poetry","indent":2,"runs":[{"verse":35,"end":null,"start":true,"text":"you say, ‘I am innocent."}]},{"kind":"poetry","indent":2,"runs":[{"verse":35,"end":null,"start":false,"text":"Surely His anger will turn from me.’"}]},{"kind":"poetry","indent":1,"runs":[{"verse":35,"end":null,"start":false,"text":"Behold, I will judge you,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":35,"end":null,"start":false,"text":"because you say, ‘I have not sinned.’"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":36,"end":null,"start":true,"text":"How impulsive you are,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":36,"end":null,"start":false,"text":"constantly changing your ways!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":36,"end":null,"start":false,"text":"You will be disappointed by Egypt"}]},{"kind":"poetry","indent":2,"runs":[{"verse":36,"end":null,"start":false,"text":"just as you were by Assyria."}]},{"kind":"poetry","indent":1,"runs":[{"verse":37,"end":null,"start":true,"text":"Moreover, you will leave that place"}]},{"kind":"poetry","indent":2,"runs":[{"verse":37,"end":null,"start":false,"text":"with your hands on your head,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":37,"end":null,"start":false,"text":"for the LORD has rejected those you trust;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":37,"end":null,"start":false,"text":"you will not prosper by their help.”"}]}]}
