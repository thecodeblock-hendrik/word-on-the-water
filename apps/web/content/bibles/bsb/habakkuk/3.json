{"version":"bsb","book":"habakkuk","chapter":3,"blocks":[{"kind":"heading","level":2,"text":"Habakkuk’s Prayer"},{"kind":"paragraph","indent":0,"runs":[{"verse":1,"end":null,"start":true,"text":"This is a prayer of Habakkuk the prophet, according to Shigionoth:"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"O LORD, I have heard the report of You;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"I stand in awe, O LORD, of Your deeds."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":false,"text":"Revive them in these years;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"make them known in these years."}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"In Your wrath, remember mercy!"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"God came from Teman,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"and the Holy One from Mount Paran."}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"Selah"}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":false,"text":"His glory covered the heavens,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"and His praise filled the earth."}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"His radiance was like the sunlight;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"rays flashed from His hand,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"where His power is hidden."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"Plague went before Him,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"and fever followed in His steps."}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"He stood and measured the earth;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"He looked and startled the nations;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":false,"text":"the ancient mountains crumbled;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"the perpetual hills collapsed."}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"His ways are everlasting."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"I saw the tents of Cushan in distress;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"the curtains of Midian were trembling."}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"Were You angry at the rivers, O LORD?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"Was Your wrath against the streams?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":false,"text":"Did You rage against the sea"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"when You rode on Your horses,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"on Your chariots of salvation?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"You brandished Your bow;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"You called for many arrows."}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"Selah"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"You split the earth with rivers."}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"The mountains saw You and quaked;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"torrents of water swept by."}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":false,"text":"The deep roared with its voice"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"and lifted its hands on high."}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"Sun and moon stood still"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"in their places"}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":false,"text":"at the flash of Your flying arrows,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"at the brightness of Your shining spear."}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"You marched across the earth with fury;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"You threshed the nations in wrath."}]},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":true,"text":"You went forth for the salvation of Your people,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"to save Your anointed."}]},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":false,"text":"You crushed the head of the house of the wicked"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"and stripped him from head to toe."}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"Selah"}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":true,"text":"With his own spear You pierced his head,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"when his warriors stormed out to scatter us,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":false,"text":"gloating as though ready"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"to secretly devour the weak."}]},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":true,"text":"You trampled the sea with Your horses,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"churning the great waters."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":true,"text":"I heard and trembled within;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"my lips quivered at the sound."}]},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":false,"text":"Decay entered my bones;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"I trembled where I stood."}]},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":false,"text":"Yet I must wait patiently for the day of distress"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"to come upon the people who invade us."}]},{"kind":"heading","level":2,"text":"Habakkuk Rejoices"},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":true,"text":"Though the fig tree does not bud"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"and no fruit is on the vines,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":false,"text":"though the olive crop fails"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"and the fields produce no food,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":false,"text":"though the sheep are cut off from the fold"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"and no cattle are in the stalls,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":true,"text":"yet I will exult in the LORD;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"I will rejoice in the God of my salvation!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":true,"text":"GOD the Lord is my strength;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"He makes my feet like those of a deer;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"He makes me walk upon the heights!"}]}]}
