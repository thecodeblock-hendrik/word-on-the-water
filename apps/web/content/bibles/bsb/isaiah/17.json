{"version":"bsb","book":"isaiah","chapter":17,"blocks":[{"kind":"heading","level":2,"text":"The Burden against Damascus"},{"kind":"paragraph","indent":0,"runs":[{"verse":1,"end":null,"start":true,"text":"This is the burden against Damascus:"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":false,"text":"“Behold, Damascus is no longer a city;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"it has become a heap of ruins."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"The cities of Aroer are forsaken;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"they will be left to the flocks,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"which will lie down with no one to fear."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"The fortress will disappear from Ephraim,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"and the sovereignty from Damascus."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":false,"text":"The remnant of Aram will be"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"like the splendor of the Israelites,”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"declares the LORD of Hosts."}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"“In that day the splendor of Jacob will fade,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"and the fat of his body will waste away,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"as the reaper gathers the standing grain"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"and harvests the ears with his arm,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":false,"text":"as one gleans heads of grain"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"in the Valley of Rephaim."}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"Yet gleanings will remain,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"like an olive tree that has been beaten—"}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":false,"text":"two or three berries atop the tree,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"four or five on its fruitful branches,”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"declares the LORD, the God of Israel."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"In that day men will look to their Maker"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"and turn their eyes to the Holy One of Israel."}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"They will not look to the altars"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"they have fashioned with their hands"}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":false,"text":"or to the Asherahs and incense altars"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"they have made with their fingers."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"In that day their strong cities"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"will be like forsaken thickets and summits,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":false,"text":"abandoned to the Israelites"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"and to utter desolation."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"For you have forgotten the God of your salvation"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"and failed to remember the Rock of your refuge."}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":false,"text":"Therefore, though you cultivate delightful plots"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"and set out cuttings from exotic vines —"}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"though on the day you plant"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"you make them grow,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":false,"text":"and on that morning"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"you help your seed sprout —"}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":false,"text":"yet the harvest will vanish"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"on the day of disease and incurable pain."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"Alas, the tumult of many peoples;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"they rage like the roaring seas and clamoring nations;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"they rumble like the crashing of mighty waters."}]},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":true,"text":"The nations rage like the rush of many waters."}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"He rebukes them, and they flee far away,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":false,"text":"driven before the wind like chaff on the hills,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"like tumbleweeds before a gale."}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":true,"text":"In the evening, there is sudden terror!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"Before morning, they are no more!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":false,"text":"This is the portion of those who loot us"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"and the lot of those who plunder us."}]}]}
