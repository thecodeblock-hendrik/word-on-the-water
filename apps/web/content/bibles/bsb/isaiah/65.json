{"version":"bsb","book":"isaiah","chapter":65,"blocks":[{"kind":"heading","level":2,"text":"Judgments and Promises"},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"“I revealed Myself to those who did not ask for Me;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"I was found by those who did not seek Me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":false,"text":"To a nation that did not call My name,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"I said, ‘Here I am! Here I am!’"}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"All day long I have held out My hands"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"to an obstinate people"}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":false,"text":"who walk in the wrong path,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"who follow their own imaginations,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"to a people who continually provoke Me to My face,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"sacrificing in the gardens"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"and burning incense on altars of brick,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"sitting among the graves,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"spending nights in secret places,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":false,"text":"eating the meat of pigs"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"and polluted broth from their bowls."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"They say, ‘Keep to yourself;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"do not come near me, for I am holier than you!’"}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":false,"text":"Such people are smoke in My nostrils,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"a fire that burns all day long."}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"Behold, it is written before Me:"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"I will not keep silent, but I will repay;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"I will pay it back into their laps,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"both for your iniquities"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"and for those of your fathers,”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"says the LORD."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":false,"text":"“Because they burned incense on the mountains"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"and scorned Me on the hills,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":false,"text":"I will measure into their laps"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"full payment for their former deeds.”"}]},{"kind":"paragraph","indent":0,"runs":[{"verse":8,"end":null,"start":true,"text":"This is what the LORD says:"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":false,"text":"“As the new wine is found in a cluster of grapes,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"and men say, ‘Do not destroy it, for it contains a blessing,’"}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":false,"text":"so I will act on behalf of My servants;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"I will not destroy them all."}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"And I will bring forth descendants from Jacob,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"and heirs from Judah;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":false,"text":"My elect will possess My mountains,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"and My servants will dwell there."}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"Sharon will become a pasture for flocks,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"and the Valley of Achor a resting place for herds,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"for My people who seek Me."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"But you who forsake the LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"who forget My holy mountain,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":false,"text":"who set a table for Fortune"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"and fill bowls of mixed wine for Destiny,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"I will destine you for the sword,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"and you will all kneel down to be slaughtered,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":false,"text":"because I called and you did not answer,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"I spoke and you did not listen;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":false,"text":"you did evil in My sight"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"and chose that in which I did not delight.”"}]},{"kind":"paragraph","indent":0,"runs":[{"verse":13,"end":null,"start":true,"text":"Therefore this is what the Lord GOD says:"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":false,"text":"“My servants will eat,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"but you will go hungry;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":false,"text":"My servants will drink,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"but you will go thirsty;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":false,"text":"My servants will rejoice,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"but you will be put to shame."}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":true,"text":"My servants will shout for joy with a glad heart,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"but you will cry out with a heavy heart"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"and wail with a broken spirit."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":true,"text":"You will leave behind your name"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"as a curse for My chosen ones,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":false,"text":"and the Lord GOD will slay you;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"but to His servants He will give another name."}]},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":true,"text":"Whoever invokes a blessing in the land"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"will do so by the God of truth,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":false,"text":"and whoever takes an oath in the land"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"will swear by the God of truth."}]},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":false,"text":"For the former troubles will be forgotten"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"and hidden from My sight."}]},{"kind":"heading","level":2,"text":"A New Heaven and a New Earth"},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":true,"text":"For behold, I will create"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"new heavens and a new earth."}]},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":false,"text":"The former things will not be remembered,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"nor will they come to mind."}]},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":true,"text":"But be glad and rejoice forever"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"in what I create;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":false,"text":"for I will create Jerusalem to be a joy"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"and its people to be a delight."}]},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":true,"text":"I will rejoice in Jerusalem"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"and take delight in My people."}]},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":false,"text":"The sounds of weeping and crying"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"will no longer be heard in her."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":true,"text":"No longer will a nursing infant live but a few days,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"or an old man fail to live out his years."}]},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":false,"text":"For the youth will die at a hundred years,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"and he who fails to reach a hundred"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"will be considered accursed."}]},{"kind":"poetry","indent":1,"runs":[{"verse":21,"end":null,"start":true,"text":"They will build houses and dwell in them;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":21,"end":null,"start":false,"text":"they will plant vineyards and eat their fruit."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":22,"end":null,"start":true,"text":"No longer will they build houses for others to inhabit,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":22,"end":null,"start":false,"text":"nor plant for others to eat."}]},{"kind":"poetry","indent":1,"runs":[{"verse":22,"end":null,"start":false,"text":"For as is the lifetime of a tree,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":22,"end":null,"start":false,"text":"so will be the days of My people,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":22,"end":null,"start":false,"text":"and My chosen ones will fully enjoy"}]},{"kind":"poetry","indent":2,"runs":[{"verse":22,"end":null,"start":false,"text":"the work of their hands."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":23,"end":null,"start":true,"text":"They will not labor in vain"}]},{"kind":"poetry","indent":2,"runs":[{"verse":23,"end":null,"start":false,"text":"or bear children doomed to disaster;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":23,"end":null,"start":false,"text":"for they will be a people blessed by the LORD —"}]},{"kind":"poetry","indent":2,"runs":[{"verse":23,"end":null,"start":false,"text":"they and their descendants with them."}]},{"kind":"poetry","indent":1,"runs":[{"verse":24,"end":null,"start":true,"text":"Even before they call, I will answer,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":24,"end":null,"start":false,"text":"and while they are still speaking, I will hear."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":25,"end":null,"start":true,"text":"The wolf and the lamb will feed together,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":25,"end":null,"start":false,"text":"and the lion will eat straw like the ox,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":25,"end":null,"start":false,"text":"but the food of the serpent will be dust."}]},{"kind":"poetry","indent":2,"runs":[{"verse":25,"end":null,"start":false,"text":"They will neither harm nor destroy"}]},{"kind":"poetry","indent":2,"runs":[{"verse":25,"end":null,"start":false,"text":"on all My holy mountain,”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":25,"end":null,"start":false,"text":"says the LORD."}]}]}
