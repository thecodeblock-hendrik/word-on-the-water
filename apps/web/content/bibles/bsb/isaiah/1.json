{"version":"bsb","book":"isaiah","chapter":1,"blocks":[{"kind":"heading","level":2,"text":"Judah’s Rebellion"},{"kind":"paragraph","indent":0,"runs":[{"verse":1,"end":null,"start":true,"text":"This is the vision concerning Judah and Jerusalem that Isaiah son of Amoz saw during the reigns of Uzziah, Jotham, Ahaz, and Hezekiah, kings of Judah."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"Listen, O heavens, and give ear, O earth,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"for the LORD has spoken:"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":false,"text":"“I have raised children and brought them up,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"but they have rebelled against Me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"The ox knows its owner,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"and the donkey its master’s manger,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":false,"text":"but Israel does not know;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"My people do not understand.”"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"Alas, O sinful nation,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"a people laden with iniquity,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":false,"text":"a brood of evildoers,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"children who act corruptly!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":false,"text":"They have forsaken the LORD;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"they have despised the Holy One of Israel"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"and turned their backs on Him."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"Why do you want more beatings?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"Why do you keep rebelling?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":false,"text":"Your head has a massive wound,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"and your whole heart is afflicted."}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"From the sole of your foot to the top of your head,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"there is no soundness—"}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":false,"text":"only wounds and welts and festering sores"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"neither cleansed nor bandaged nor soothed with oil."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"Your land is desolate;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"your cities are burned with fire."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":false,"text":"Foreigners devour your fields before you —"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"a desolation demolished by strangers."}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"And the Daughter of Zion is abandoned"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"like a shelter in a vineyard,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":false,"text":"like a shack in a cucumber field,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"like a city besieged."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"Unless the LORD of Hosts"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"had left us a few survivors,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":false,"text":"we would have become like Sodom,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"we would have resembled Gomorrah."}]},{"kind":"heading","level":2,"text":"Meaningless Offerings"},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"Hear the word of the LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"you rulers of Sodom;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":false,"text":"listen to the instruction of our God,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"you people of Gomorrah!"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"“What good to Me is your multitude of sacrifices?”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"says the LORD."}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":false,"text":"“I am full from the burnt offerings of rams"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"and the fat of well-fed cattle;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":false,"text":"I take no delight in the blood of bulls"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"and lambs and goats."}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"When you come to appear before Me,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"who has required this of you—"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"this trampling of My courts?"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":true,"text":"Bring your worthless offerings no more;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"your incense is detestable to Me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":false,"text":"New Moons, Sabbaths, and convocations—"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"I cannot endure iniquity in a solemn assembly."}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":true,"text":"I hate your New Moons"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"and your appointed feasts."}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":false,"text":"They have become a burden to Me;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"I am weary of bearing them."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":true,"text":"When you spread out your hands in prayer,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"I will hide My eyes from you;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":false,"text":"even though you multiply your prayers,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"I will not listen."}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"Your hands are covered with blood."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":true,"text":"Wash and cleanse yourselves."}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"Remove your evil deeds from My sight."}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"Stop doing evil!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":true,"text":"Learn to do right;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"seek justice and correct the oppressor."}]},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":false,"text":"Defend the fatherless"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"and plead the case of the widow.”"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":true,"text":"“Come now, let us reason together,”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"says the LORD."}]},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":false,"text":"“Though your sins are like scarlet,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"they will be as white as snow;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":false,"text":"though they are as red as crimson,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"they will become like wool."}]},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":true,"text":"If you are willing and obedient,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"you will eat the best of the land."}]},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":true,"text":"But if you resist and rebel,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"you will be devoured by the sword.”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"For the mouth of the LORD has spoken."}]},{"kind":"heading","level":2,"text":"The Corruption of Zion"},{"kind":"poetry","indent":1,"runs":[{"verse":21,"end":null,"start":true,"text":"See how the faithful city has become a harlot!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":21,"end":null,"start":false,"text":"She once was full of justice;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":21,"end":null,"start":false,"text":"righteousness resided within her,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":21,"end":null,"start":false,"text":"but now only murderers!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":22,"end":null,"start":true,"text":"Your silver has become dross;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":22,"end":null,"start":false,"text":"your fine wine is diluted with water."}]},{"kind":"poetry","indent":1,"runs":[{"verse":23,"end":null,"start":true,"text":"Your rulers are rebels,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":23,"end":null,"start":false,"text":"friends of thieves."}]},{"kind":"poetry","indent":1,"runs":[{"verse":23,"end":null,"start":false,"text":"They all love bribes"}]},{"kind":"poetry","indent":2,"runs":[{"verse":23,"end":null,"start":false,"text":"and chasing after rewards."}]},{"kind":"poetry","indent":1,"runs":[{"verse":23,"end":null,"start":false,"text":"They do not defend the fatherless,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":23,"end":null,"start":false,"text":"and the plea of the widow never comes before them."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":24,"end":null,"start":true,"text":"Therefore the Lord GOD of Hosts,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":24,"end":null,"start":false,"text":"the Mighty One of Israel, declares:"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":24,"end":null,"start":false,"text":"“Ah, I will be relieved of My foes"}]},{"kind":"poetry","indent":2,"runs":[{"verse":24,"end":null,"start":false,"text":"and avenge Myself on My enemies."}]},{"kind":"poetry","indent":1,"runs":[{"verse":25,"end":null,"start":true,"text":"I will turn My hand against you;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":25,"end":null,"start":false,"text":"I will thoroughly purge your dross;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":25,"end":null,"start":false,"text":"I will remove all your impurities."}]},{"kind":"poetry","indent":1,"runs":[{"verse":26,"end":null,"start":true,"text":"I will restore your judges as at first,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":26,"end":null,"start":false,"text":"and your counselors as at the beginning."}]},{"kind":"poetry","indent":1,"runs":[{"verse":26,"end":null,"start":false,"text":"After that you will be called the City of Righteousness,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":26,"end":null,"start":false,"text":"the Faithful City.”"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":27,"end":null,"start":true,"text":"Zion will be redeemed with justice,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":27,"end":null,"start":false,"text":"her repentant ones with righteousness."}]},{"kind":"poetry","indent":1,"runs":[{"verse":28,"end":null,"start":true,"text":"But rebels and sinners will together be shattered,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":28,"end":null,"start":false,"text":"and those who forsake the LORD will perish."}]},{"kind":"poetry","indent":1,"runs":[{"verse":29,"end":null,"start":true,"text":"Surely you will be ashamed of the sacred oaks"}]},{"kind":"poetry","indent":2,"runs":[{"verse":29,"end":null,"start":false,"text":"in which you have delighted;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":29,"end":null,"start":false,"text":"you will be embarrassed by the gardens"}]},{"kind":"poetry","indent":2,"runs":[{"verse":29,"end":null,"start":false,"text":"that you have chosen."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":30,"end":null,"start":true,"text":"For you will become like an oak whose leaves are withered,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":30,"end":null,"start":false,"text":"like a garden without water."}]},{"kind":"poetry","indent":1,"runs":[{"verse":31,"end":null,"start":true,"text":"The strong man will become tinder"}]},{"kind":"poetry","indent":2,"runs":[{"verse":31,"end":null,"start":false,"text":"and his work will be a spark;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":31,"end":null,"start":false,"text":"both will burn together,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":31,"end":null,"start":false,"text":"with no one to quench the flames."}]}]}
