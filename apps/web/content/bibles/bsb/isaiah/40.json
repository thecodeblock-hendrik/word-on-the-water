{"version":"bsb","book":"isaiah","chapter":40,"blocks":[{"kind":"heading","level":2,"text":"Prepare the Way for the LORD"},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"“Comfort, comfort My people,”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"says your God."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"“Speak tenderly to Jerusalem,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"and proclaim to her"}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":false,"text":"that her forced labor has been completed;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"her iniquity has been pardoned."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":false,"text":"For she has received from the hand of the LORD"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"double for all her sins.”"}]},{"kind":"paragraph","indent":0,"runs":[{"verse":3,"end":null,"start":true,"text":"A voice of one calling:"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":false,"text":"“Prepare the way for the LORD in the wilderness;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"make a straight highway for our God in the desert."}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"Every valley shall be lifted up,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"and every mountain and hill made low;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":false,"text":"the uneven ground will become smooth,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"and the rugged land a plain."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"And the glory of the LORD will be revealed,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"and all humanity together will see it.”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"For the mouth of the LORD has spoken."}]},{"kind":"heading","level":2,"text":"The Enduring Word"},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"A voice says, “Cry out!”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"And I asked, “What should I cry out?”"}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":false,"text":"“All flesh is like grass,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"and all its glory like the flowers of the field."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"The grass withers and the flowers fall"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"when the breath of the LORD blows on them;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"indeed, the people are grass."}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"The grass withers and the flowers fall,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"but the word of our God stands forever.”"}]},{"kind":"heading","level":2,"text":"Here Is Your God!"},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"Go up on a high mountain,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"O Zion, herald of good news."}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":false,"text":"Raise your voice loudly,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"O Jerusalem, herald of good news."}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":false,"text":"Lift it up,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"do not be afraid!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":false,"text":"Say to the cities of Judah,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"“Here is your God!”"}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"Behold, the Lord GOD comes with might,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"and His arm establishes His rule."}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":false,"text":"His reward is with Him,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"and His recompense accompanies Him."}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"He tends His flock like a shepherd;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"He gathers the lambs in His arms"}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":false,"text":"and carries them close to His heart."}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"He gently leads the nursing ewes."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"Who has measured the waters in the hollow of his hand,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"or marked off the heavens with the span of his hand?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":false,"text":"Who has held the dust of the earth in a basket,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"or weighed the mountains on a scale"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"and the hills with a balance?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":true,"text":"Who has directed the Spirit of the LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"or informed Him as His counselor?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":true,"text":"Whom did He consult to enlighten Him,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"and who taught Him the paths of justice?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":false,"text":"Who imparted knowledge to Him"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"and showed Him the way of understanding?"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":true,"text":"Surely the nations are like a drop in a bucket;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"they are considered a speck of dust on the scales;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"He lifts up the islands like fine dust."}]},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":true,"text":"Lebanon is not sufficient for fuel,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"nor its animals enough for a burnt offering."}]},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":true,"text":"All the nations are as nothing before Him;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"He regards them as nothingness and emptiness."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":true,"text":"To whom will you liken God?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"To what image will you compare Him?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":true,"text":"To an idol that a craftsman casts"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"and a metalworker overlays with gold"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"and fits with silver chains?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":true,"text":"One lacking such an offering"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"chooses wood that will not rot."}]},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":false,"text":"He seeks a skilled craftsman"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"to set up an idol that will not topple."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":21,"end":null,"start":true,"text":"Do you not know?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":21,"end":null,"start":false,"text":"Have you not heard?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":21,"end":null,"start":false,"text":"Has it not been declared to you from the beginning?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":21,"end":null,"start":false,"text":"Have you not understood since the foundation of the earth?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":22,"end":null,"start":true,"text":"He sits enthroned above the circle of the earth;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":22,"end":null,"start":false,"text":"its dwellers are like grasshoppers."}]},{"kind":"poetry","indent":1,"runs":[{"verse":22,"end":null,"start":false,"text":"He stretches out the heavens like a curtain,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":22,"end":null,"start":false,"text":"and spreads them out like a tent to dwell in."}]},{"kind":"poetry","indent":1,"runs":[{"verse":23,"end":null,"start":true,"text":"He brings the princes to nothing"}]},{"kind":"poetry","indent":2,"runs":[{"verse":23,"end":null,"start":false,"text":"and makes the rulers of the earth meaningless."}]},{"kind":"poetry","indent":1,"runs":[{"verse":24,"end":null,"start":true,"text":"No sooner are they planted, no sooner are they sown,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":24,"end":null,"start":false,"text":"no sooner have their stems taken root in the ground,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":24,"end":null,"start":false,"text":"than He blows on them and they wither,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":24,"end":null,"start":false,"text":"and a whirlwind sweeps them away like stubble."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":25,"end":null,"start":true,"text":"“To whom will you liken Me,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":25,"end":null,"start":false,"text":"or who is My equal?” asks the Holy One."}]},{"kind":"poetry","indent":1,"runs":[{"verse":26,"end":null,"start":true,"text":"Lift up your eyes on high:"}]},{"kind":"poetry","indent":2,"runs":[{"verse":26,"end":null,"start":false,"text":"Who created all these?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":26,"end":null,"start":false,"text":"He leads forth the starry host by number;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":26,"end":null,"start":false,"text":"He calls each one by name."}]},{"kind":"poetry","indent":1,"runs":[{"verse":26,"end":null,"start":false,"text":"Because of His great power and mighty strength,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":26,"end":null,"start":false,"text":"not one of them is missing."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":27,"end":null,"start":true,"text":"Why do you say, O Jacob,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":27,"end":null,"start":false,"text":"and why do you assert, O Israel,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":27,"end":null,"start":false,"text":"“My way is hidden from the LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":27,"end":null,"start":false,"text":"and my claim is ignored by my God”?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":28,"end":null,"start":true,"text":"Do you not know?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":28,"end":null,"start":false,"text":"Have you not heard?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":28,"end":null,"start":false,"text":"The LORD is the everlasting God,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":28,"end":null,"start":false,"text":"the Creator of the ends of the earth."}]},{"kind":"poetry","indent":1,"runs":[{"verse":28,"end":null,"start":false,"text":"He will not grow tired or weary;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":28,"end":null,"start":false,"text":"His understanding is beyond searching out."}]},{"kind":"poetry","indent":1,"runs":[{"verse":29,"end":null,"start":true,"text":"He gives power to the faint"}]},{"kind":"poetry","indent":2,"runs":[{"verse":29,"end":null,"start":false,"text":"and increases the strength of the weak."}]},{"kind":"poetry","indent":1,"runs":[{"verse":30,"end":null,"start":true,"text":"Even youths grow tired and weary,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":30,"end":null,"start":false,"text":"and young men stumble and fall."}]},{"kind":"poetry","indent":1,"runs":[{"verse":31,"end":null,"start":true,"text":"But those who wait upon the LORD will renew their strength;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":31,"end":null,"start":false,"text":"they will mount up with wings like eagles;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":31,"end":null,"start":false,"text":"they will run and not grow weary,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":31,"end":null,"start":false,"text":"they will walk and not faint."}]}]}
