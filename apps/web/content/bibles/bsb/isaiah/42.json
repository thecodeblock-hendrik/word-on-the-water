{"version":"bsb","book":"isaiah","chapter":42,"blocks":[{"kind":"heading","level":2,"text":"Here Is My Servant"},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"“Here is My Servant, whom I uphold,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"My Chosen One, in whom My soul delights."}]},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":false,"text":"I will put My Spirit on Him,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"and He will bring justice to the nations."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"He will not cry out or raise His voice,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"nor make His voice heard in the streets."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"A bruised reed He will not break"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"and a smoldering wick He will not extinguish;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"He will faithfully bring forth justice."}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"He will not grow weak or discouraged"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"before He has established justice on the earth."}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"In His law the islands will put their hope.”"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"This is what God the LORD says—"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"He who created the heavens"}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":false,"text":"and stretched them out,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"who spread out the earth and its offspring,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":false,"text":"who gives breath to the people on it"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"and life to those who walk in it:"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"“I, the LORD, have called you"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"for a righteous purpose,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":false,"text":"and I will take hold of your hand."}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"I will keep you and appoint you"}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":false,"text":"to be a covenant for the people"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"and a light to the nations,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"to open the eyes of the blind,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"to bring prisoners out of the dungeon"}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":false,"text":"and those sitting in darkness"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"out from the prison house."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"I am the LORD;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"that is My name!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":false,"text":"I will not yield My glory to another"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"or My praise to idols."}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"Behold, the former things have happened,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"and now I declare new things."}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":false,"text":"Before they spring forth"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"I proclaim them to you.”"}]},{"kind":"heading","level":2,"text":"A New Song of Praise"},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"Sing to the LORD a new song—"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"His praise from the ends of the earth—"}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":false,"text":"you who go down to the sea, and all that is in it,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"you islands, and all who dwell in them."}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"Let the desert and its cities raise their voices;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"let the villages of Kedar cry aloud."}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":false,"text":"Let the people of Sela sing for joy;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"let them cry out from the mountaintops."}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"Let them give glory to the LORD"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"and declare His praise in the islands."}]},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":true,"text":"The LORD goes forth like a mighty one;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"He stirs up His zeal like a warrior."}]},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":false,"text":"He shouts; yes, He roars"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"in triumph over His enemies:"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":true,"text":"“I have kept silent from ages past;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"I have remained quiet and restrained."}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":false,"text":"But now I will groan like a woman in labor;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"I will at once gasp and pant."}]},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":true,"text":"I will lay waste the mountains and hills"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"and dry up all their vegetation."}]},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":false,"text":"I will turn the rivers into dry land"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"and drain the marshes."}]},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":true,"text":"I will lead the blind by a way they did not know;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"I will guide them on unfamiliar paths."}]},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":false,"text":"I will turn darkness into light before them"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"and rough places into level ground."}]},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":false,"text":"These things I will do for them,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"and I will not forsake them."}]},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":true,"text":"But those who trust in idols"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"and say to molten images, ‘You are our gods!’"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"will be turned back in utter shame."}]},{"kind":"heading","level":2,"text":"Israel Is Deaf and Blind"},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":true,"text":"Listen, you deaf ones;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"look, you blind ones, that you may see!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":true,"text":"Who is blind but My servant,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"or deaf like the messenger I am sending?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":false,"text":"Who is blind like My covenant partner,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"or blind like the servant of the LORD?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":true,"text":"Though seeing many things, you do not keep watch."}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"Though your ears are open, you do not hear.”"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":21,"end":null,"start":true,"text":"The LORD was pleased, for the sake of His righteousness,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":21,"end":null,"start":false,"text":"to magnify His law and make it glorious."}]},{"kind":"poetry","indent":1,"runs":[{"verse":22,"end":null,"start":true,"text":"But this is a people plundered and looted,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":22,"end":null,"start":false,"text":"all trapped in caves or imprisoned in dungeons."}]},{"kind":"poetry","indent":1,"runs":[{"verse":22,"end":null,"start":false,"text":"They have become plunder with no one to rescue them,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":22,"end":null,"start":false,"text":"and loot with no one to say, “Send them back!”"}]},{"kind":"poetry","indent":1,"runs":[{"verse":23,"end":null,"start":true,"text":"Who among you will pay attention to this?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":23,"end":null,"start":false,"text":"Who will listen and obey hereafter?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":24,"end":null,"start":true,"text":"Who gave Jacob up for spoil,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":24,"end":null,"start":false,"text":"and Israel to the plunderers?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":24,"end":null,"start":false,"text":"Was it not the LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":24,"end":null,"start":false,"text":"against whom we have sinned?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":24,"end":null,"start":false,"text":"They were unwilling to walk in His ways,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":24,"end":null,"start":false,"text":"and they would not obey His law."}]},{"kind":"poetry","indent":1,"runs":[{"verse":25,"end":null,"start":true,"text":"So He poured out on them His furious anger"}]},{"kind":"poetry","indent":2,"runs":[{"verse":25,"end":null,"start":false,"text":"and the fierceness of battle."}]},{"kind":"poetry","indent":1,"runs":[{"verse":25,"end":null,"start":false,"text":"It enveloped them in flames,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":25,"end":null,"start":false,"text":"but they did not understand;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":25,"end":null,"start":false,"text":"it consumed them,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":25,"end":null,"start":false,"text":"but they did not take it to heart."}]}]}
