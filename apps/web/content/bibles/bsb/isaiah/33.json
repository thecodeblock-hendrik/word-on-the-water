{"version":"bsb","book":"isaiah","chapter":33,"blocks":[{"kind":"heading","level":2,"text":"The LORD Is Exalted"},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"Woe to you, O destroyer never destroyed,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"O traitor never betrayed!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":false,"text":"When you have finished destroying,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"you will be destroyed."}]},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":false,"text":"When you have finished betraying,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"you will be betrayed."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"O LORD, be gracious to us!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"We wait for You."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":false,"text":"Be our strength every morning"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"and our salvation in time of trouble."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"The peoples flee the thunder of Your voice;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"the nations scatter when You rise."}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"Your spoil, O nations, is gathered as by locusts;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"like a swarm of locusts men sweep over it."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"The LORD is exalted, for He dwells on high;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"He has filled Zion with justice and righteousness."}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"He will be the sure foundation for your times,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"a storehouse of salvation, wisdom, and knowledge."}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"The fear of the LORD is Zion’s treasure."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"Behold, their valiant ones cry aloud in the streets;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"the envoys of peace weep bitterly."}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"The highways are deserted;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"travel has ceased."}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":false,"text":"The treaty has been broken,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"the witnesses are despised,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"and human life is disregarded."}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"The land mourns and languishes;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"Lebanon is ashamed and decayed."}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":false,"text":"Sharon is like a desert;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"Bashan and Carmel shake off their leaves."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"“Now I will arise,” says the LORD."}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"“Now I will lift Myself up. Now I will be exalted."}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"You conceive chaff; you give birth to stubble."}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"Your breath is a fire that will consume you."}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"The peoples will be burned to ashes,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"like thorns cut down and set ablaze."}]},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":true,"text":"You who are far off, hear what I have done;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"you who are near, acknowledge My might.”"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":true,"text":"The sinners in Zion are afraid;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"trembling grips the ungodly:"}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":false,"text":"“Who of us can dwell with a consuming fire?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"Who of us can dwell with everlasting flames?”"}]},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":true,"text":"He who walks righteously"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"and speaks with sincerity,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":false,"text":"who refuses gain from extortion,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"whose hand never takes a bribe,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":false,"text":"who stops his ears against murderous plots"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"and shuts his eyes tightly against evil—"}]},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":true,"text":"he will dwell on the heights;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"the mountain fortress will be his refuge;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":false,"text":"his food will be provided"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"and his water assured."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":true,"text":"Your eyes will see the King in His beauty"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"and behold a land that stretches afar."}]},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":true,"text":"Your mind will ponder the former terror:"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"“Where is he who tallies? Where is he who weighs?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"Where is he who counts the towers?”"}]},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":true,"text":"You will no longer see the insolent,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"a people whose speech is unintelligible,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"who stammer in a language you cannot understand."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":true,"text":"Look upon Zion,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"the city of our appointed feasts."}]},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":false,"text":"Your eyes will see Jerusalem,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"a peaceful pasture, a tent that does not wander;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":false,"text":"its tent pegs will not be pulled up,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"nor will any of its cords be broken."}]},{"kind":"poetry","indent":1,"runs":[{"verse":21,"end":null,"start":true,"text":"But there the Majestic One, our LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":21,"end":null,"start":false,"text":"will be for us a place of rivers and wide canals,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":21,"end":null,"start":false,"text":"where no galley with oars will row,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":21,"end":null,"start":false,"text":"and no majestic vessel will pass."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":22,"end":null,"start":true,"text":"For the LORD is our Judge,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":22,"end":null,"start":false,"text":"the LORD is our lawgiver,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":22,"end":null,"start":false,"text":"the LORD is our King."}]},{"kind":"poetry","indent":2,"runs":[{"verse":22,"end":null,"start":false,"text":"It is He who will save us."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":23,"end":null,"start":true,"text":"Your ropes are slack;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":23,"end":null,"start":false,"text":"they cannot secure the mast or spread the sail."}]},{"kind":"poetry","indent":1,"runs":[{"verse":23,"end":null,"start":false,"text":"Then an abundance of spoils will be divided,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":23,"end":null,"start":false,"text":"and even the lame will carry off plunder."}]},{"kind":"poetry","indent":1,"runs":[{"verse":24,"end":null,"start":true,"text":"And no resident of Zion will say, “I am sick.”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":24,"end":null,"start":false,"text":"The people who dwell there"}]},{"kind":"poetry","indent":2,"runs":[{"verse":24,"end":null,"start":false,"text":"will be forgiven of iniquity."}]}]}
