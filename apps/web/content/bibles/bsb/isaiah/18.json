{"version":"bsb","book":"isaiah","chapter":18,"blocks":[{"kind":"heading","level":2,"text":"A Message to Cush"},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"Woe to the land of whirring wings,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"along the rivers of Cush,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"which sends couriers by sea,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"in papyrus vessels on the waters."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":false,"text":"Go, swift messengers,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"to a people tall and smooth-skinned,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"to a people widely feared,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":false,"text":"to a powerful nation of strange speech,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"whose land is divided by rivers."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"All you people of the world"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"and dwellers of the earth,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":false,"text":"when a banner is raised on the mountains,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"you will see it;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":false,"text":"when a ram’s horn sounds,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"you will hear it."}]},{"kind":"break"},{"kind":"paragraph","indent":0,"runs":[{"verse":4,"end":null,"start":true,"text":"For this is what the LORD has told me:"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":false,"text":"“I will quietly look on from My dwelling place,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"like shimmering heat in the sunshine,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"like a cloud of dew in the heat of harvest.”"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"For before the harvest, when the blossom is gone"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"and the flower becomes a ripening grape,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":false,"text":"He will cut off the shoots with a pruning knife"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"and remove and discard the branches."}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"They will all be left to the mountain birds of prey,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"and to the beasts of the land."}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":false,"text":"The birds will feed on them in summer,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"and all the wild animals in winter."}]},{"kind":"paragraph","indent":0,"runs":[{"verse":7,"end":null,"start":true,"text":"At that time gifts will be brought to the LORD of Hosts—"}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":false,"text":"from a people tall and smooth-skinned,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"from a people widely feared,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":false,"text":"from a powerful nation of strange speech,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"whose land is divided by rivers—"}]},{"kind":"paragraph","indent":0,"runs":[{"verse":7,"end":null,"start":false,"text":"to Mount Zion, the place of the Name of the LORD of Hosts."}]}]}
