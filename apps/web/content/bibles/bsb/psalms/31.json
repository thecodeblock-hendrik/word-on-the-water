{"version":"bsb","book":"psalms","chapter":31,"blocks":[{"kind":"heading","level":2,"text":"Into Your Hands I Commit My Spirit"},{"kind":"title","text":"For the choirmaster. A Psalm of David."},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"In You, O LORD, I have taken refuge;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"let me never be put to shame;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"save me by Your righteousness."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"Incline Your ear to me;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"come quickly to my rescue."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":false,"text":"Be my rock of refuge,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"the stronghold of my deliverance."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"For You are my rock and my fortress;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"lead me and guide me for the sake of Your name."}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"You free me from the net laid out for me,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"for You are my refuge."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"Into Your hands I commit my spirit;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"You have redeemed me, O LORD, God of truth."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"I hate those who cling to worthless idols,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"but in the LORD I trust."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"I will be glad and rejoice in Your loving devotion,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"for You have seen my affliction;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"You have known the anguish of my soul."}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"You have not delivered me to the enemy;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"You have set my feet in the open."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"Be merciful to me, O LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"for I am in distress;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":false,"text":"my eyes fail from sorrow,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"my soul and body as well."}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"For my life is consumed with grief"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"and my years with groaning;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":false,"text":"my iniquity has drained my strength,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"and my bones are wasting away."}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"Among all my enemies I am a disgrace,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"and among my neighbors even more."}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":false,"text":"I am dreaded by my friends —"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"they flee when they see me on the street."}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"I am forgotten like a dead man, out of mind."}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"I am like a broken vessel."}]},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":true,"text":"For I hear the slander of many;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"there is terror on every side."}]},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":false,"text":"They conspire against me"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"and plot to take my life."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":true,"text":"But I trust in You, O LORD;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"I say, “You are my God.”"}]},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":true,"text":"My times are in Your hands;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"deliver me from my enemies"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"and from those who pursue me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":true,"text":"Make Your face shine on Your servant;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"save me by Your loving devotion."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":true,"text":"O LORD, let me not be ashamed,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"for I have called on You."}]},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":false,"text":"Let the wicked be put to shame;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"let them lie silent in Sheol."}]},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":true,"text":"May lying lips be silenced —"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"lips that speak with arrogance against the righteous,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"full of pride and contempt."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":true,"text":"How great is Your goodness"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"which You have laid up for those who fear You,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":false,"text":"which You have bestowed before the sons of men"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"on those who take refuge in You!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":true,"text":"You hide them in the secret place of Your presence"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"from the schemes of men."}]},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":false,"text":"You conceal them in Your shelter"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"from accusing tongues."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":21,"end":null,"start":true,"text":"Blessed be the LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":21,"end":null,"start":false,"text":"for He has shown me His loving devotion"}]},{"kind":"poetry","indent":2,"runs":[{"verse":21,"end":null,"start":false,"text":"in a city under siege."}]},{"kind":"poetry","indent":1,"runs":[{"verse":22,"end":null,"start":true,"text":"In my alarm I said,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":22,"end":null,"start":false,"text":"“I am cut off from Your sight!”"}]},{"kind":"poetry","indent":1,"runs":[{"verse":22,"end":null,"start":false,"text":"But You heard my plea for mercy"}]},{"kind":"poetry","indent":2,"runs":[{"verse":22,"end":null,"start":false,"text":"when I called to You for help."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":23,"end":null,"start":true,"text":"Love the LORD, all His saints."}]},{"kind":"poetry","indent":2,"runs":[{"verse":23,"end":null,"start":false,"text":"The LORD preserves the faithful,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":23,"end":null,"start":false,"text":"but fully repays the arrogant."}]},{"kind":"poetry","indent":1,"runs":[{"verse":24,"end":null,"start":true,"text":"Be strong and courageous,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":24,"end":null,"start":false,"text":"all you who hope in the LORD."}]}]}
