{"version":"bsb","book":"psalms","chapter":136,"blocks":[{"kind":"heading","level":2,"text":"His Loving Devotion Endures Forever"},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"Give thanks to the LORD, for He is good."}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"His loving devotion endures forever."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"Give thanks to the God of gods."}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"His loving devotion endures forever."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"Give thanks to the Lord of lords."}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"His loving devotion endures forever."}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"He alone does great wonders."}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"His loving devotion endures forever."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"By His insight He made the heavens."}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"His loving devotion endures forever."}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"He spread out the earth upon the waters."}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"His loving devotion endures forever."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"He made the great lights —"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"His loving devotion endures forever."}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"the sun to rule the day,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"His loving devotion endures forever."}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"the moon and stars to govern the night."}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"His loving devotion endures forever."}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"He struck down the firstborn of Egypt"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"His loving devotion endures forever."}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"and brought Israel out from among them"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"His loving devotion endures forever."}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"with a mighty hand and an outstretched arm."}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"His loving devotion endures forever."}]},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":true,"text":"He divided the Red Sea in two"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"His loving devotion endures forever."}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":true,"text":"and led Israel through the midst,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"His loving devotion endures forever."}]},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":true,"text":"but swept Pharaoh and his army into the Red Sea."}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"His loving devotion endures forever."}]},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":true,"text":"He led His people through the wilderness."}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"His loving devotion endures forever."}]},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":true,"text":"He struck down great kings"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"His loving devotion endures forever."}]},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":true,"text":"and slaughtered mighty kings—"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"His loving devotion endures forever."}]},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":true,"text":"Sihon king of the Amorites"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"His loving devotion endures forever."}]},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":true,"text":"and Og king of Bashan—"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"His loving devotion endures forever."}]},{"kind":"poetry","indent":1,"runs":[{"verse":21,"end":null,"start":true,"text":"and He gave their land as an inheritance,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":21,"end":null,"start":false,"text":"His loving devotion endures forever."}]},{"kind":"poetry","indent":1,"runs":[{"verse":22,"end":null,"start":true,"text":"a heritage to His servant Israel."}]},{"kind":"poetry","indent":2,"runs":[{"verse":22,"end":null,"start":false,"text":"His loving devotion endures forever."}]},{"kind":"poetry","indent":1,"runs":[{"verse":23,"end":null,"start":true,"text":"He remembered us in our low estate"}]},{"kind":"poetry","indent":2,"runs":[{"verse":23,"end":null,"start":false,"text":"His loving devotion endures forever."}]},{"kind":"poetry","indent":1,"runs":[{"verse":24,"end":null,"start":true,"text":"and freed us from our enemies."}]},{"kind":"poetry","indent":2,"runs":[{"verse":24,"end":null,"start":false,"text":"His loving devotion endures forever."}]},{"kind":"poetry","indent":1,"runs":[{"verse":25,"end":null,"start":true,"text":"He gives food to every creature."}]},{"kind":"poetry","indent":2,"runs":[{"verse":25,"end":null,"start":false,"text":"His loving devotion endures forever."}]},{"kind":"poetry","indent":1,"runs":[{"verse":26,"end":null,"start":true,"text":"Give thanks to the God of heaven!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":26,"end":null,"start":false,"text":"His loving devotion endures forever."}]}]}
