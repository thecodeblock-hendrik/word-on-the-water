{"version":"bsb","book":"psalms","chapter":23,"blocks":[{"kind":"heading","level":2,"text":"The LORD Is My Shepherd"},{"kind":"title","text":"A Psalm of David."},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"The LORD is my shepherd;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"I shall not want."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"He makes me lie down in green pastures;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"He leads me beside quiet waters."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"He restores my soul;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"He guides me in the paths of righteousness"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"for the sake of His name."}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"Even though I walk through the valley of the shadow of death,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"I will fear no evil,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":false,"text":"for You are with me;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"Your rod and Your staff, they comfort me."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"You prepare a table before me"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"in the presence of my enemies."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":false,"text":"You anoint my head with oil;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"my cup overflows."}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"Surely goodness and mercy will follow me"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"all the days of my life,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":false,"text":"and I will dwell in the house of the LORD"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"forever."}]}]}
