{"version":"bsb","book":"psalms","chapter":88,"blocks":[{"kind":"heading","level":2,"text":"I Cry Out before You"},{"kind":"title","text":"A song. A Psalm of the sons of Korah. For the choirmaster. According to Mahalath Leannoth. A Maskil of Heman the Ezrahite."},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"O LORD, the God of my salvation,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"day and night I cry out before You."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"May my prayer come before You;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"incline Your ear to my cry."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"For my soul is full of troubles,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"and my life draws near to Sheol."}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"I am counted among those descending to the Pit."}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"I am like a man without strength."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"I am forsaken among the dead,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"like the slain who lie in the grave,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":false,"text":"whom You remember no more,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"who are cut off from Your care."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"You have laid me in the lowest Pit,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"in the darkest of the depths."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"Your wrath weighs heavily upon me;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"all Your waves have submerged me."}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"Selah"}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"You have removed my friends from me;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"You have made me repulsive to them;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"I am confined and cannot escape."}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"My eyes grow dim with grief."}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"I call to You daily, O LORD;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"I spread out my hands to You."}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"Do You work wonders for the dead?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"Do departed spirits rise up to praise You?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"Selah"}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"Can Your loving devotion be proclaimed in the grave,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"Your faithfulness in Abaddon?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"Will Your wonders be known in the darkness,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"or Your righteousness in the land of oblivion?"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":true,"text":"But to You, O LORD, I cry for help;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"in the morning my prayer comes before You."}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":true,"text":"Why, O LORD, do You reject me?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"Why do You hide Your face from me?"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":true,"text":"From my youth I was afflicted and near death."}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"I have borne Your terrors; I am in despair."}]},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":true,"text":"Your wrath has swept over me;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"Your terrors have destroyed me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":true,"text":"All day long they engulf me like water;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"they enclose me on every side."}]},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":true,"text":"You have removed my beloved and my friend;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"darkness is my closest companion."}]}]}
