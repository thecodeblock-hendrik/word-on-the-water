{"version":"bsb","book":"psalms","chapter":1,"blocks":[{"kind":"heading","level":1,"text":"BOOK I"},{"kind":"title","text":"Psalms 1–41"},{"kind":"heading","level":2,"text":"The Two Paths"},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"Blessed is the man"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"who does not walk in the counsel of the wicked,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":false,"text":"or set foot on the path of sinners,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"or sit in the seat of mockers."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"But his delight is in the Law of the LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"and on His law he meditates day and night."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"He is like a tree planted by streams of water,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"yielding its fruit in season,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":false,"text":"whose leaf does not wither,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"and who prospers in all he does."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"Not so the wicked!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"For they are like chaff driven off by the wind."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"Therefore the wicked will not stand in the judgment,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"nor sinners in the assembly of the righteous."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"For the LORD guards the path of the righteous,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"but the way of the wicked will perish."}]}]}
