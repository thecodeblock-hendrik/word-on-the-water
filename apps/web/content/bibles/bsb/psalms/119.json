{"version":"bsb","book":"psalms","chapter":119,"blocks":[{"kind":"heading","level":2,"text":"Your Word Is a Lamp to My Feet"},{"kind":"label","text":"א"},{"kind":"label","text":"ALEPH"},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"Blessed are those whose way is blameless,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"who walk in the Law of the LORD."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"Blessed are those who keep His testimonies"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"and seek Him with all their heart."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"They do no iniquity;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"they walk in His ways."}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"You have ordained Your precepts,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"that we should keep them diligently."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"Oh, that my ways were committed"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"to keeping Your statutes!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"Then I would not be ashamed"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"when I consider all Your commandments."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"I will praise You with an upright heart"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"when I learn Your righteous judgments."}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"I will keep Your statutes;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"do not utterly forsake me."}]},{"kind":"label","text":"ב"},{"kind":"label","text":"BETH"},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"How can a young man keep his way pure?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"By guarding it according to Your word."}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"With all my heart I have sought You;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"do not let me stray from Your commandments."}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"I have hidden Your word in my heart"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"that I might not sin against You."}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"Blessed are You, O LORD;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"teach me Your statutes."}]},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":true,"text":"With my lips I proclaim"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"all the judgments of Your mouth."}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":true,"text":"I rejoice in the way of Your testimonies"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"as much as in all riches."}]},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":true,"text":"I will meditate on Your precepts"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"and regard Your ways."}]},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":true,"text":"I will delight in Your statutes;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"I will not forget Your word."}]},{"kind":"label","text":"ג"},{"kind":"label","text":"GIMEL"},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":true,"text":"Deal bountifully with Your servant,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"that I may live and keep Your word."}]},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":true,"text":"Open my eyes that I may see"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"wondrous things from Your law."}]},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":true,"text":"I am a stranger on the earth;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"do not hide Your commandments from me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":true,"text":"My soul is consumed with longing"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"for Your judgments at all times."}]},{"kind":"poetry","indent":1,"runs":[{"verse":21,"end":null,"start":true,"text":"You rebuke the arrogant —"}]},{"kind":"poetry","indent":2,"runs":[{"verse":21,"end":null,"start":false,"text":"the cursed who stray from Your commandments."}]},{"kind":"poetry","indent":1,"runs":[{"verse":22,"end":null,"start":true,"text":"Remove my scorn and contempt,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":22,"end":null,"start":false,"text":"for I have kept Your testimonies."}]},{"kind":"poetry","indent":1,"runs":[{"verse":23,"end":null,"start":true,"text":"Though rulers sit and slander me,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":23,"end":null,"start":false,"text":"Your servant meditates on Your statutes."}]},{"kind":"poetry","indent":1,"runs":[{"verse":24,"end":null,"start":true,"text":"Your testimonies are indeed my delight;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":24,"end":null,"start":false,"text":"they are my counselors."}]},{"kind":"label","text":"ד"},{"kind":"label","text":"DALETH"},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":25,"end":null,"start":true,"text":"My soul cleaves to the dust;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":25,"end":null,"start":false,"text":"revive me according to Your word."}]},{"kind":"poetry","indent":1,"runs":[{"verse":26,"end":null,"start":true,"text":"I recounted my ways, and You answered me;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":26,"end":null,"start":false,"text":"teach me Your statutes."}]},{"kind":"poetry","indent":1,"runs":[{"verse":27,"end":null,"start":true,"text":"Make clear to me the way of Your precepts;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":27,"end":null,"start":false,"text":"then I will meditate on Your wonders."}]},{"kind":"poetry","indent":1,"runs":[{"verse":28,"end":null,"start":true,"text":"My soul melts with sorrow;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":28,"end":null,"start":false,"text":"strengthen me according to Your word."}]},{"kind":"poetry","indent":1,"runs":[{"verse":29,"end":null,"start":true,"text":"Remove me from the path of deceit"}]},{"kind":"poetry","indent":2,"runs":[{"verse":29,"end":null,"start":false,"text":"and graciously grant me Your law."}]},{"kind":"poetry","indent":1,"runs":[{"verse":30,"end":null,"start":true,"text":"I have chosen the way of truth;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":30,"end":null,"start":false,"text":"I have set Your ordinances before me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":31,"end":null,"start":true,"text":"I cling to Your testimonies, O LORD;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":31,"end":null,"start":false,"text":"let me not be put to shame."}]},{"kind":"poetry","indent":1,"runs":[{"verse":32,"end":null,"start":true,"text":"I run in the path of Your commandments,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":32,"end":null,"start":false,"text":"for You will enlarge my heart."}]},{"kind":"label","text":"ה"},{"kind":"label","text":"HE"},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":33,"end":null,"start":true,"text":"Teach me, O LORD, the way of Your statutes,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":33,"end":null,"start":false,"text":"and I will keep them to the end."}]},{"kind":"poetry","indent":1,"runs":[{"verse":34,"end":null,"start":true,"text":"Give me understanding that I may obey Your law,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":34,"end":null,"start":false,"text":"and follow it with all my heart."}]},{"kind":"poetry","indent":1,"runs":[{"verse":35,"end":null,"start":true,"text":"Direct me in the path of Your commandments,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":35,"end":null,"start":false,"text":"for there I find delight."}]},{"kind":"poetry","indent":1,"runs":[{"verse":36,"end":null,"start":true,"text":"Turn my heart to Your testimonies"}]},{"kind":"poetry","indent":2,"runs":[{"verse":36,"end":null,"start":false,"text":"and not to covetous gain."}]},{"kind":"poetry","indent":1,"runs":[{"verse":37,"end":null,"start":true,"text":"Turn my eyes away from worthless things;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":37,"end":null,"start":false,"text":"revive me with Your word."}]},{"kind":"poetry","indent":1,"runs":[{"verse":38,"end":null,"start":true,"text":"Establish Your word to Your servant,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":38,"end":null,"start":false,"text":"to produce reverence for You."}]},{"kind":"poetry","indent":1,"runs":[{"verse":39,"end":null,"start":true,"text":"Turn away the disgrace I dread,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":39,"end":null,"start":false,"text":"for Your judgments are good."}]},{"kind":"poetry","indent":1,"runs":[{"verse":40,"end":null,"start":true,"text":"How I long for Your precepts!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":40,"end":null,"start":false,"text":"Revive me in Your righteousness."}]},{"kind":"label","text":"ו"},{"kind":"label","text":"WAW"},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":41,"end":null,"start":true,"text":"May Your loving devotion come to me, O LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":41,"end":null,"start":false,"text":"Your salvation, according to Your promise."}]},{"kind":"poetry","indent":1,"runs":[{"verse":42,"end":null,"start":true,"text":"Then I can answer him who taunts,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":42,"end":null,"start":false,"text":"for I trust in Your word."}]},{"kind":"poetry","indent":1,"runs":[{"verse":43,"end":null,"start":true,"text":"Never take Your word of truth from my mouth,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":43,"end":null,"start":false,"text":"for I hope in Your judgments."}]},{"kind":"poetry","indent":1,"runs":[{"verse":44,"end":null,"start":true,"text":"I will always obey Your law,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":44,"end":null,"start":false,"text":"forever and ever."}]},{"kind":"poetry","indent":1,"runs":[{"verse":45,"end":null,"start":true,"text":"And I will walk in freedom,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":45,"end":null,"start":false,"text":"for I have sought Your precepts."}]},{"kind":"poetry","indent":1,"runs":[{"verse":46,"end":null,"start":true,"text":"I will speak of Your testimonies before kings,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":46,"end":null,"start":false,"text":"and I will not be ashamed."}]},{"kind":"poetry","indent":1,"runs":[{"verse":47,"end":null,"start":true,"text":"I delight in Your commandments"}]},{"kind":"poetry","indent":2,"runs":[{"verse":47,"end":null,"start":false,"text":"because I love them."}]},{"kind":"poetry","indent":1,"runs":[{"verse":48,"end":null,"start":true,"text":"I lift up my hands to Your commandments, which I love,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":48,"end":null,"start":false,"text":"and I meditate on Your statutes."}]},{"kind":"label","text":"ז"},{"kind":"label","text":"ZAYIN"},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":49,"end":null,"start":true,"text":"Remember Your word to Your servant,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":49,"end":null,"start":false,"text":"upon which You have given me hope."}]},{"kind":"poetry","indent":1,"runs":[{"verse":50,"end":null,"start":true,"text":"This is my comfort in affliction,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":50,"end":null,"start":false,"text":"that Your promise has given me life."}]},{"kind":"poetry","indent":1,"runs":[{"verse":51,"end":null,"start":true,"text":"The arrogant utterly deride me,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":51,"end":null,"start":false,"text":"but I do not turn from Your law."}]},{"kind":"poetry","indent":1,"runs":[{"verse":52,"end":null,"start":true,"text":"I remember Your judgments of old, O LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":52,"end":null,"start":false,"text":"and in them I find comfort."}]},{"kind":"poetry","indent":1,"runs":[{"verse":53,"end":null,"start":true,"text":"Rage has taken hold of me"}]},{"kind":"poetry","indent":2,"runs":[{"verse":53,"end":null,"start":false,"text":"because of the wicked who reject Your law."}]},{"kind":"poetry","indent":1,"runs":[{"verse":54,"end":null,"start":true,"text":"Your statutes are songs to me"}]},{"kind":"poetry","indent":2,"runs":[{"verse":54,"end":null,"start":false,"text":"in the house of my pilgrimage."}]},{"kind":"poetry","indent":1,"runs":[{"verse":55,"end":null,"start":true,"text":"In the night, O LORD, I remember Your name,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":55,"end":null,"start":false,"text":"that I may keep Your law."}]},{"kind":"poetry","indent":1,"runs":[{"verse":56,"end":null,"start":true,"text":"This is my practice,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":56,"end":null,"start":false,"text":"for I obey Your precepts."}]},{"kind":"label","text":"ח"},{"kind":"label","text":"HETH"},{"kind":"poetry","indent":1,"runs":[{"verse":57,"end":null,"start":true,"text":"The LORD is my portion;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":57,"end":null,"start":false,"text":"I have promised to keep Your words."}]},{"kind":"poetry","indent":1,"runs":[{"verse":58,"end":null,"start":true,"text":"I have sought Your face with all my heart;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":58,"end":null,"start":false,"text":"be gracious to me according to Your promise."}]},{"kind":"poetry","indent":1,"runs":[{"verse":59,"end":null,"start":true,"text":"I considered my ways"}]},{"kind":"poetry","indent":2,"runs":[{"verse":59,"end":null,"start":false,"text":"and turned my steps to Your testimonies."}]},{"kind":"poetry","indent":1,"runs":[{"verse":60,"end":null,"start":true,"text":"I hurried without hesitating"}]},{"kind":"poetry","indent":2,"runs":[{"verse":60,"end":null,"start":false,"text":"to keep Your commandments."}]},{"kind":"poetry","indent":1,"runs":[{"verse":61,"end":null,"start":true,"text":"Though the ropes of the wicked bind me,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":61,"end":null,"start":false,"text":"I do not forget Your law."}]},{"kind":"poetry","indent":1,"runs":[{"verse":62,"end":null,"start":true,"text":"At midnight I rise to give You thanks"}]},{"kind":"poetry","indent":2,"runs":[{"verse":62,"end":null,"start":false,"text":"for Your righteous judgments."}]},{"kind":"poetry","indent":1,"runs":[{"verse":63,"end":null,"start":true,"text":"I am a friend to all who fear You,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":63,"end":null,"start":false,"text":"and to those who keep Your precepts."}]},{"kind":"poetry","indent":1,"runs":[{"verse":64,"end":null,"start":true,"text":"The earth is filled with Your loving devotion, O LORD;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":64,"end":null,"start":false,"text":"teach me Your statutes."}]},{"kind":"label","text":"ט"},{"kind":"label","text":"TETH"},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":65,"end":null,"start":true,"text":"You are good to Your servant, O LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":65,"end":null,"start":false,"text":"according to Your word."}]},{"kind":"poetry","indent":1,"runs":[{"verse":66,"end":null,"start":true,"text":"Teach me good judgment and knowledge,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":66,"end":null,"start":false,"text":"for I believe in Your commandments."}]},{"kind":"poetry","indent":1,"runs":[{"verse":67,"end":null,"start":true,"text":"Before I was afflicted, I went astray;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":67,"end":null,"start":false,"text":"but now I keep Your word."}]},{"kind":"poetry","indent":1,"runs":[{"verse":68,"end":null,"start":true,"text":"You are good, and You do what is good;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":68,"end":null,"start":false,"text":"teach me Your statutes."}]},{"kind":"poetry","indent":1,"runs":[{"verse":69,"end":null,"start":true,"text":"Though the arrogant have smeared me with lies,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":69,"end":null,"start":false,"text":"I keep Your precepts with all my heart."}]},{"kind":"poetry","indent":1,"runs":[{"verse":70,"end":null,"start":true,"text":"Their hearts are callous and insensitive,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":70,"end":null,"start":false,"text":"but I delight in Your law."}]},{"kind":"poetry","indent":1,"runs":[{"verse":71,"end":null,"start":true,"text":"It was good for me to be afflicted,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":71,"end":null,"start":false,"text":"that I might learn Your statutes."}]},{"kind":"poetry","indent":1,"runs":[{"verse":72,"end":null,"start":true,"text":"The law from Your mouth is more precious to me"}]},{"kind":"poetry","indent":2,"runs":[{"verse":72,"end":null,"start":false,"text":"than thousands of pieces of gold and silver."}]},{"kind":"label","text":"י"},{"kind":"label","text":"YODH"},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":73,"end":null,"start":true,"text":"Your hands have made me and fashioned me;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":73,"end":null,"start":false,"text":"give me understanding to learn Your commandments."}]},{"kind":"poetry","indent":1,"runs":[{"verse":74,"end":null,"start":true,"text":"May those who fear You see me and rejoice,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":74,"end":null,"start":false,"text":"for I have hoped in Your word."}]},{"kind":"poetry","indent":1,"runs":[{"verse":75,"end":null,"start":true,"text":"I know, O LORD, that Your judgments are righteous,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":75,"end":null,"start":false,"text":"and that in faithfulness You have afflicted me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":76,"end":null,"start":true,"text":"May Your loving devotion comfort me, I pray,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":76,"end":null,"start":false,"text":"according to Your promise to Your servant."}]},{"kind":"poetry","indent":1,"runs":[{"verse":77,"end":null,"start":true,"text":"May Your compassion come to me, that I may live,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":77,"end":null,"start":false,"text":"for Your law is my delight."}]},{"kind":"poetry","indent":1,"runs":[{"verse":78,"end":null,"start":true,"text":"May the arrogant be put to shame for subverting me with a lie;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":78,"end":null,"start":false,"text":"I will meditate on Your precepts."}]},{"kind":"poetry","indent":1,"runs":[{"verse":79,"end":null,"start":true,"text":"May those who fear You turn to me,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":79,"end":null,"start":false,"text":"those who know Your testimonies."}]},{"kind":"poetry","indent":1,"runs":[{"verse":80,"end":null,"start":true,"text":"May my heart be blameless in Your statutes,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":80,"end":null,"start":false,"text":"that I may not be put to shame."}]},{"kind":"label","text":"כ"},{"kind":"label","text":"KAPH"},{"kind":"poetry","indent":1,"runs":[{"verse":81,"end":null,"start":true,"text":"My soul faints for Your salvation;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":81,"end":null,"start":false,"text":"I wait for Your word."}]},{"kind":"poetry","indent":1,"runs":[{"verse":82,"end":null,"start":true,"text":"My eyes fail, looking for Your promise;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":82,"end":null,"start":false,"text":"I ask, “When will You comfort me?”"}]},{"kind":"poetry","indent":1,"runs":[{"verse":83,"end":null,"start":true,"text":"Though I am like a wineskin dried up by smoke,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":83,"end":null,"start":false,"text":"I do not forget Your statutes."}]},{"kind":"poetry","indent":1,"runs":[{"verse":84,"end":null,"start":true,"text":"How many days must Your servant wait?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":84,"end":null,"start":false,"text":"When will You execute judgment on my persecutors?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":85,"end":null,"start":true,"text":"The arrogant have dug pits for me"}]},{"kind":"poetry","indent":2,"runs":[{"verse":85,"end":null,"start":false,"text":"in violation of Your law."}]},{"kind":"poetry","indent":1,"runs":[{"verse":86,"end":null,"start":true,"text":"All Your commandments are faithful;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":86,"end":null,"start":false,"text":"I am persecuted without cause— help me!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":87,"end":null,"start":true,"text":"They almost wiped me from the earth,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":87,"end":null,"start":false,"text":"but I have not forsaken Your precepts."}]},{"kind":"poetry","indent":1,"runs":[{"verse":88,"end":null,"start":true,"text":"Revive me according to Your loving devotion,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":88,"end":null,"start":false,"text":"that I may obey the testimony of Your mouth."}]},{"kind":"label","text":"ל"},{"kind":"label","text":"LAMEDH"},{"kind":"poetry","indent":1,"runs":[{"verse":89,"end":null,"start":true,"text":"Your word, O LORD, is everlasting;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":89,"end":null,"start":false,"text":"it is firmly fixed in the heavens."}]},{"kind":"poetry","indent":1,"runs":[{"verse":90,"end":null,"start":true,"text":"Your faithfulness continues through all generations;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":90,"end":null,"start":false,"text":"You established the earth, and it endures."}]},{"kind":"poetry","indent":1,"runs":[{"verse":91,"end":null,"start":true,"text":"Your ordinances stand to this day,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":91,"end":null,"start":false,"text":"for all things are servants to You."}]},{"kind":"poetry","indent":1,"runs":[{"verse":92,"end":null,"start":true,"text":"If Your law had not been my delight,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":92,"end":null,"start":false,"text":"then I would have perished in my affliction."}]},{"kind":"poetry","indent":1,"runs":[{"verse":93,"end":null,"start":true,"text":"I will never forget Your precepts,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":93,"end":null,"start":false,"text":"for by them You have revived me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":94,"end":null,"start":true,"text":"I am Yours; save me,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":94,"end":null,"start":false,"text":"for I have sought Your precepts."}]},{"kind":"poetry","indent":1,"runs":[{"verse":95,"end":null,"start":true,"text":"The wicked wait to destroy me,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":95,"end":null,"start":false,"text":"but I will ponder Your testimonies."}]},{"kind":"poetry","indent":1,"runs":[{"verse":96,"end":null,"start":true,"text":"I have seen a limit to all perfection,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":96,"end":null,"start":false,"text":"but Your commandment is without limit."}]},{"kind":"label","text":"מ"},{"kind":"label","text":"MEM"},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":97,"end":null,"start":true,"text":"Oh, how I love Your law!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":97,"end":null,"start":false,"text":"All day long it is my meditation."}]},{"kind":"poetry","indent":1,"runs":[{"verse":98,"end":null,"start":true,"text":"Your commandments make me wiser than my enemies,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":98,"end":null,"start":false,"text":"for they are always with me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":99,"end":null,"start":true,"text":"I have more insight than all my teachers,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":99,"end":null,"start":false,"text":"for Your testimonies are my meditation."}]},{"kind":"poetry","indent":1,"runs":[{"verse":100,"end":null,"start":true,"text":"I discern more than the elders,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":100,"end":null,"start":false,"text":"for I obey Your precepts."}]},{"kind":"poetry","indent":1,"runs":[{"verse":101,"end":null,"start":true,"text":"I have kept my feet from every evil path,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":101,"end":null,"start":false,"text":"that I may keep Your word."}]},{"kind":"poetry","indent":1,"runs":[{"verse":102,"end":null,"start":true,"text":"I have not departed from Your ordinances,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":102,"end":null,"start":false,"text":"for You Yourself have taught me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":103,"end":null,"start":true,"text":"How sweet are Your words to my taste—"}]},{"kind":"poetry","indent":2,"runs":[{"verse":103,"end":null,"start":false,"text":"sweeter than honey in my mouth!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":104,"end":null,"start":true,"text":"I gain understanding from Your precepts;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":104,"end":null,"start":false,"text":"therefore I hate every false way."}]},{"kind":"label","text":"נ"},{"kind":"label","text":"NUN"},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":105,"end":null,"start":true,"text":"Your word is a lamp to my feet"}]},{"kind":"poetry","indent":2,"runs":[{"verse":105,"end":null,"start":false,"text":"and a light to my path."}]},{"kind":"poetry","indent":1,"runs":[{"verse":106,"end":null,"start":true,"text":"I have sworn and confirmed"}]},{"kind":"poetry","indent":2,"runs":[{"verse":106,"end":null,"start":false,"text":"that I will keep Your righteous judgments."}]},{"kind":"poetry","indent":1,"runs":[{"verse":107,"end":null,"start":true,"text":"I am severely afflicted, O LORD;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":107,"end":null,"start":false,"text":"revive me through Your word."}]},{"kind":"poetry","indent":1,"runs":[{"verse":108,"end":null,"start":true,"text":"Accept the freewill offerings of my mouth, O LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":108,"end":null,"start":false,"text":"and teach me Your judgments."}]},{"kind":"poetry","indent":1,"runs":[{"verse":109,"end":null,"start":true,"text":"I constantly take my life in my hands,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":109,"end":null,"start":false,"text":"yet I do not forget Your law."}]},{"kind":"poetry","indent":1,"runs":[{"verse":110,"end":null,"start":true,"text":"The wicked have set a snare for me,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":110,"end":null,"start":false,"text":"but I have not strayed from Your precepts."}]},{"kind":"poetry","indent":1,"runs":[{"verse":111,"end":null,"start":true,"text":"Your testimonies are my heritage forever,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":111,"end":null,"start":false,"text":"for they are the joy of my heart."}]},{"kind":"poetry","indent":1,"runs":[{"verse":112,"end":null,"start":true,"text":"I have inclined my heart to perform Your statutes,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":112,"end":null,"start":false,"text":"even to the very end."}]},{"kind":"label","text":"ס"},{"kind":"label","text":"SAMEKH"},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":113,"end":null,"start":true,"text":"The double-minded I despise,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":113,"end":null,"start":false,"text":"but Your law I love."}]},{"kind":"poetry","indent":1,"runs":[{"verse":114,"end":null,"start":true,"text":"You are my hiding place and my shield;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":114,"end":null,"start":false,"text":"I put my hope in Your word."}]},{"kind":"poetry","indent":1,"runs":[{"verse":115,"end":null,"start":true,"text":"Depart from me, you evildoers,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":115,"end":null,"start":false,"text":"that I may obey the commandments of my God."}]},{"kind":"poetry","indent":1,"runs":[{"verse":116,"end":null,"start":true,"text":"Sustain me as You promised, that I may live;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":116,"end":null,"start":false,"text":"let me not be ashamed of my hope."}]},{"kind":"poetry","indent":1,"runs":[{"verse":117,"end":null,"start":true,"text":"Uphold me, and I will be saved,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":117,"end":null,"start":false,"text":"that I may always regard Your statutes."}]},{"kind":"poetry","indent":1,"runs":[{"verse":118,"end":null,"start":true,"text":"You reject all who stray from Your statutes,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":118,"end":null,"start":false,"text":"for their deceitfulness is in vain."}]},{"kind":"poetry","indent":1,"runs":[{"verse":119,"end":null,"start":true,"text":"All the wicked on earth You discard like dross;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":119,"end":null,"start":false,"text":"therefore I love Your testimonies."}]},{"kind":"poetry","indent":1,"runs":[{"verse":120,"end":null,"start":true,"text":"My flesh trembles in awe of You;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":120,"end":null,"start":false,"text":"I stand in fear of Your judgments."}]},{"kind":"label","text":"ע"},{"kind":"label","text":"AYIN"},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":121,"end":null,"start":true,"text":"I have done what is just and right;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":121,"end":null,"start":false,"text":"do not leave me to my oppressors."}]},{"kind":"poetry","indent":1,"runs":[{"verse":122,"end":null,"start":true,"text":"Ensure Your servant’s well-being;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":122,"end":null,"start":false,"text":"do not let the arrogant oppress me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":123,"end":null,"start":true,"text":"My eyes fail, looking for Your salvation,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":123,"end":null,"start":false,"text":"and for Your righteous promise."}]},{"kind":"poetry","indent":1,"runs":[{"verse":124,"end":null,"start":true,"text":"Deal with Your servant according to Your loving devotion,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":124,"end":null,"start":false,"text":"and teach me Your statutes."}]},{"kind":"poetry","indent":1,"runs":[{"verse":125,"end":null,"start":true,"text":"I am Your servant; give me understanding,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":125,"end":null,"start":false,"text":"that I may know Your testimonies."}]},{"kind":"poetry","indent":1,"runs":[{"verse":126,"end":null,"start":true,"text":"It is time for the LORD to act,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":126,"end":null,"start":false,"text":"for they have broken Your law."}]},{"kind":"poetry","indent":1,"runs":[{"verse":127,"end":null,"start":true,"text":"Therefore I love Your commandments more than gold,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":127,"end":null,"start":false,"text":"even the purest gold."}]},{"kind":"poetry","indent":1,"runs":[{"verse":128,"end":null,"start":true,"text":"Therefore I admire all Your precepts"}]},{"kind":"poetry","indent":2,"runs":[{"verse":128,"end":null,"start":false,"text":"and hate every false way."}]},{"kind":"label","text":"פ"},{"kind":"label","text":"PE"},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":129,"end":null,"start":true,"text":"Wonderful are Your testimonies;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":129,"end":null,"start":false,"text":"therefore I obey them."}]},{"kind":"poetry","indent":1,"runs":[{"verse":130,"end":null,"start":true,"text":"The unfolding of Your words gives light;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":130,"end":null,"start":false,"text":"it informs the simple."}]},{"kind":"poetry","indent":1,"runs":[{"verse":131,"end":null,"start":true,"text":"I open my mouth and pant,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":131,"end":null,"start":false,"text":"longing for Your commandments."}]},{"kind":"poetry","indent":1,"runs":[{"verse":132,"end":null,"start":true,"text":"Turn to me and show me mercy,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":132,"end":null,"start":false,"text":"as You do to those who love Your name."}]},{"kind":"poetry","indent":1,"runs":[{"verse":133,"end":null,"start":true,"text":"Order my steps in Your word;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":133,"end":null,"start":false,"text":"let no sin rule over me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":134,"end":null,"start":true,"text":"Redeem me from the oppression of man,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":134,"end":null,"start":false,"text":"that I may keep Your precepts."}]},{"kind":"poetry","indent":1,"runs":[{"verse":135,"end":null,"start":true,"text":"Make Your face shine upon Your servant,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":135,"end":null,"start":false,"text":"and teach me Your statutes."}]},{"kind":"poetry","indent":1,"runs":[{"verse":136,"end":null,"start":true,"text":"My eyes shed streams of tears"}]},{"kind":"poetry","indent":2,"runs":[{"verse":136,"end":null,"start":false,"text":"because Your law is not obeyed."}]},{"kind":"label","text":"צ"},{"kind":"label","text":"TZADE"},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":137,"end":null,"start":true,"text":"Righteous are You, O LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":137,"end":null,"start":false,"text":"and upright are Your judgments."}]},{"kind":"poetry","indent":1,"runs":[{"verse":138,"end":null,"start":true,"text":"The testimonies You have laid down are righteous"}]},{"kind":"poetry","indent":2,"runs":[{"verse":138,"end":null,"start":false,"text":"and altogether faithful."}]},{"kind":"poetry","indent":1,"runs":[{"verse":139,"end":null,"start":true,"text":"My zeal has consumed me"}]},{"kind":"poetry","indent":2,"runs":[{"verse":139,"end":null,"start":false,"text":"because my foes forget Your words."}]},{"kind":"poetry","indent":1,"runs":[{"verse":140,"end":null,"start":true,"text":"Your promise is completely pure;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":140,"end":null,"start":false,"text":"therefore Your servant loves it."}]},{"kind":"poetry","indent":1,"runs":[{"verse":141,"end":null,"start":true,"text":"I am lowly and despised,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":141,"end":null,"start":false,"text":"but I do not forget Your precepts."}]},{"kind":"poetry","indent":1,"runs":[{"verse":142,"end":null,"start":true,"text":"Your righteousness is everlasting"}]},{"kind":"poetry","indent":2,"runs":[{"verse":142,"end":null,"start":false,"text":"and Your law is true."}]},{"kind":"poetry","indent":1,"runs":[{"verse":143,"end":null,"start":true,"text":"Trouble and distress have found me,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":143,"end":null,"start":false,"text":"but Your commandments are my delight."}]},{"kind":"poetry","indent":1,"runs":[{"verse":144,"end":null,"start":true,"text":"Your testimonies are righteous forever."}]},{"kind":"poetry","indent":2,"runs":[{"verse":144,"end":null,"start":false,"text":"Give me understanding, that I may live."}]},{"kind":"label","text":"ק"},{"kind":"label","text":"KOPH"},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":145,"end":null,"start":true,"text":"I call with all my heart; answer me, O LORD!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":145,"end":null,"start":false,"text":"I will obey Your statutes."}]},{"kind":"poetry","indent":1,"runs":[{"verse":146,"end":null,"start":true,"text":"I call to You; save me,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":146,"end":null,"start":false,"text":"that I may keep Your testimonies."}]},{"kind":"poetry","indent":1,"runs":[{"verse":147,"end":null,"start":true,"text":"I rise before dawn and cry for help;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":147,"end":null,"start":false,"text":"in Your word I have put my hope."}]},{"kind":"poetry","indent":1,"runs":[{"verse":148,"end":null,"start":true,"text":"My eyes anticipate the watches of night,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":148,"end":null,"start":false,"text":"that I may meditate on Your word."}]},{"kind":"poetry","indent":1,"runs":[{"verse":149,"end":null,"start":true,"text":"Hear my voice, O LORD, according to Your loving devotion;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":149,"end":null,"start":false,"text":"give me life according to Your justice."}]},{"kind":"poetry","indent":1,"runs":[{"verse":150,"end":null,"start":true,"text":"Those who follow after wickedness draw near;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":150,"end":null,"start":false,"text":"they are far from Your law."}]},{"kind":"poetry","indent":1,"runs":[{"verse":151,"end":null,"start":true,"text":"You are near, O LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":151,"end":null,"start":false,"text":"and all Your commandments are true."}]},{"kind":"poetry","indent":1,"runs":[{"verse":152,"end":null,"start":true,"text":"Long ago I learned from Your testimonies"}]},{"kind":"poetry","indent":2,"runs":[{"verse":152,"end":null,"start":false,"text":"that You have established them forever."}]},{"kind":"label","text":"ר"},{"kind":"label","text":"RESH"},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":153,"end":null,"start":true,"text":"Look upon my affliction and rescue me,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":153,"end":null,"start":false,"text":"for I have not forgotten Your law."}]},{"kind":"poetry","indent":1,"runs":[{"verse":154,"end":null,"start":true,"text":"Defend my cause and redeem me;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":154,"end":null,"start":false,"text":"revive me according to Your word."}]},{"kind":"poetry","indent":1,"runs":[{"verse":155,"end":null,"start":true,"text":"Salvation is far from the wicked"}]},{"kind":"poetry","indent":2,"runs":[{"verse":155,"end":null,"start":false,"text":"because they do not seek Your statutes."}]},{"kind":"poetry","indent":1,"runs":[{"verse":156,"end":null,"start":true,"text":"Great are Your mercies, O LORD;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":156,"end":null,"start":false,"text":"revive me according to Your ordinances."}]},{"kind":"poetry","indent":1,"runs":[{"verse":157,"end":null,"start":true,"text":"Though my persecutors and foes are many,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":157,"end":null,"start":false,"text":"I have not turned from Your testimonies."}]},{"kind":"poetry","indent":1,"runs":[{"verse":158,"end":null,"start":true,"text":"I look on the faithless with loathing"}]},{"kind":"poetry","indent":2,"runs":[{"verse":158,"end":null,"start":false,"text":"because they do not keep Your word."}]},{"kind":"poetry","indent":1,"runs":[{"verse":159,"end":null,"start":true,"text":"Consider how I love Your precepts, O LORD;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":159,"end":null,"start":false,"text":"give me life according to Your loving devotion."}]},{"kind":"poetry","indent":1,"runs":[{"verse":160,"end":null,"start":true,"text":"The entirety of Your word is truth,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":160,"end":null,"start":false,"text":"and all Your righteous judgments endure forever."}]},{"kind":"label","text":"ש"},{"kind":"label","text":"SIN and SHIN"},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":161,"end":null,"start":true,"text":"Rulers persecute me without cause,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":161,"end":null,"start":false,"text":"but my heart fears only Your word."}]},{"kind":"poetry","indent":1,"runs":[{"verse":162,"end":null,"start":true,"text":"I rejoice in Your promise"}]},{"kind":"poetry","indent":2,"runs":[{"verse":162,"end":null,"start":false,"text":"like one who finds great spoil."}]},{"kind":"poetry","indent":1,"runs":[{"verse":163,"end":null,"start":true,"text":"I hate and abhor falsehood,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":163,"end":null,"start":false,"text":"but Your law I love."}]},{"kind":"poetry","indent":1,"runs":[{"verse":164,"end":null,"start":true,"text":"Seven times a day I praise You"}]},{"kind":"poetry","indent":2,"runs":[{"verse":164,"end":null,"start":false,"text":"for Your righteous judgments."}]},{"kind":"poetry","indent":1,"runs":[{"verse":165,"end":null,"start":true,"text":"Abundant peace belongs to those who love Your law;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":165,"end":null,"start":false,"text":"nothing can make them stumble."}]},{"kind":"poetry","indent":1,"runs":[{"verse":166,"end":null,"start":true,"text":"I wait for Your salvation, O LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":166,"end":null,"start":false,"text":"and I carry out Your commandments."}]},{"kind":"poetry","indent":1,"runs":[{"verse":167,"end":null,"start":true,"text":"I obey Your testimonies"}]},{"kind":"poetry","indent":2,"runs":[{"verse":167,"end":null,"start":false,"text":"and love them greatly."}]},{"kind":"poetry","indent":1,"runs":[{"verse":168,"end":null,"start":true,"text":"I obey Your precepts and Your testimonies,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":168,"end":null,"start":false,"text":"for all my ways are before You."}]},{"kind":"label","text":"ת"},{"kind":"label","text":"TAW"},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":169,"end":null,"start":true,"text":"May my cry come before You, O LORD;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":169,"end":null,"start":false,"text":"give me understanding according to Your word."}]},{"kind":"poetry","indent":1,"runs":[{"verse":170,"end":null,"start":true,"text":"May my plea come before You;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":170,"end":null,"start":false,"text":"rescue me according to Your promise."}]},{"kind":"poetry","indent":1,"runs":[{"verse":171,"end":null,"start":true,"text":"My lips pour forth praise,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":171,"end":null,"start":false,"text":"for You teach me Your statutes."}]},{"kind":"poetry","indent":1,"runs":[{"verse":172,"end":null,"start":true,"text":"My tongue sings of Your word,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":172,"end":null,"start":false,"text":"for all Your commandments are righteous."}]},{"kind":"poetry","indent":1,"runs":[{"verse":173,"end":null,"start":true,"text":"May Your hand be ready to help me,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":173,"end":null,"start":false,"text":"for I have chosen Your precepts."}]},{"kind":"poetry","indent":1,"runs":[{"verse":174,"end":null,"start":true,"text":"I long for Your salvation, O LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":174,"end":null,"start":false,"text":"and Your law is my delight."}]},{"kind":"poetry","indent":1,"runs":[{"verse":175,"end":null,"start":true,"text":"Let me live to praise You;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":175,"end":null,"start":false,"text":"may Your judgments sustain me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":176,"end":null,"start":true,"text":"I have strayed like a lost sheep;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":176,"end":null,"start":false,"text":"seek Your servant, for I have not forgotten Your commandments."}]}]}
