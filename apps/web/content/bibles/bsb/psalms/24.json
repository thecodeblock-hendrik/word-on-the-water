{"version":"bsb","book":"psalms","chapter":24,"blocks":[{"kind":"heading","level":2,"text":"The Earth Is the LORD’s"},{"kind":"title","text":"A Psalm of David."},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"The earth is the LORD’s, and the fullness thereof,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"the world and all who dwell therein."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"For He has founded it upon the seas"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"and established it upon the waters."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"Who may ascend the hill of the LORD?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"Who may stand in His holy place?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"He who has clean hands and a pure heart,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"who does not lift up his soul to an idol"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"or swear deceitfully."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"He will receive blessing from the LORD"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"and vindication from the God of his salvation."}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"Such is the generation of those who seek Him,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"who seek Your face, O God of Jacob."}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"Selah"}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"Lift up your heads, O gates!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"Be lifted up, O ancient doors,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"that the King of Glory may enter!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"Who is this King of Glory?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"The LORD strong and mighty,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"the LORD mighty in battle."}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"Lift up your heads, O gates!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"Be lifted up, O ancient doors,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"that the King of Glory may enter!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"Who is He, this King of Glory?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"The LORD of Hosts —"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"He is the King of Glory."}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"Selah"}]}]}
