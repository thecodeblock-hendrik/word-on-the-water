{"version":"bsb","book":"psalms","chapter":70,"blocks":[{"kind":"heading","level":2,"text":"Hurry, O LORD, to Help Me!"},{"kind":"title","text":"For the choirmaster. Of David. To bring remembrance."},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"Make haste, O God, to deliver me!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"Hurry, O LORD, to help me!"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"May those who seek my life"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"be ashamed and confounded;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":false,"text":"may those who wish me harm"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"be repelled and humiliated."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"May those who say, “Aha, aha!”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"retreat because of their shame."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"May all who seek You"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"rejoice and be glad in You;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":false,"text":"may those who love Your salvation always say,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"“Let God be magnified!”"}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"But I am poor and needy;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"hurry to me, O God."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":false,"text":"You are my help and my deliverer;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"O LORD, do not delay."}]}]}
