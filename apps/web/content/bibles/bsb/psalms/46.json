{"version":"bsb","book":"psalms","chapter":46,"blocks":[{"kind":"heading","level":2,"text":"God Is Our Refuge and Strength"},{"kind":"title","text":"For the choirmaster. Of the sons of Korah. According to Alamoth. A song."},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"God is our refuge and strength,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"an ever-present help in times of trouble."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"Therefore we will not fear,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"though the earth is transformed"}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":false,"text":"and the mountains are toppled"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"into the depths of the seas,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"though their waters roar and foam"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"and the mountains quake in the surge."}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"Selah"}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"There is a river whose streams delight the city of God,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"the holy place where the Most High dwells."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"God is within her; she will not be moved."}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"God will help her when morning dawns."}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"Nations rage, kingdoms crumble;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"the earth melts when He lifts His voice."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"The LORD of Hosts is with us;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"the God of Jacob is our fortress."}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"Selah"}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"Come, see the works of the LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"who brings devastation upon the earth."}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"He makes wars to cease throughout the earth;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"He breaks the bow and shatters the spear;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"He burns the shields in the fire."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"“Be still and know that I am God;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"I will be exalted among the nations,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"I will be exalted over the earth.”"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"The LORD of Hosts is with us;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"the God of Jacob is our fortress."}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"Selah"}]}]}
