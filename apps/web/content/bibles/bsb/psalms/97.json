{"version":"bsb","book":"psalms","chapter":97,"blocks":[{"kind":"heading","level":2,"text":"Let the Earth Rejoice"},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"The LORD reigns, let the earth rejoice;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"let the distant shores be glad."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"Clouds and darkness surround Him;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"righteousness and justice are His throne’s foundation."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"Fire goes before Him"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"and consumes His foes on every side."}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"His lightning illuminates the world;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"the earth sees and trembles."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"The mountains melt like wax"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"at the presence of the LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"before the Lord of all the earth."}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"The heavens proclaim His righteousness;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"all the peoples see His glory."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"All worshipers of images are put to shame —"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"those who boast in idols."}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"Worship Him, all you gods!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"Zion hears and rejoices,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"and the towns of Judah exult"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"because of Your judgments, O LORD."}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"For You, O LORD, are Most High over all the earth;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"You are exalted far above all gods."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"Hate evil, O you who love the LORD!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"He preserves the souls of His saints;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"He delivers them from the hand of the wicked."}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"Light shines on the righteous,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"gladness on the upright in heart."}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"Rejoice in the LORD, you righteous ones,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"and praise His holy name."}]}]}
