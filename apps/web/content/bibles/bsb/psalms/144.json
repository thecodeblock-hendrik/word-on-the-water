{"version":"bsb","book":"psalms","chapter":144,"blocks":[{"kind":"heading","level":2,"text":"Blessed Be the LORD, My Rock"},{"kind":"title","text":"Of David."},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"Blessed be the LORD, my Rock,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"who trains my hands for war,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"my fingers for battle."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"He is my steadfast love and my fortress,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"my stronghold and my deliverer."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":false,"text":"He is my shield, in whom I take refuge,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"who subdues peoples under me."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"O LORD, what is man, that You regard him,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"the son of man that You think of him?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"Man is like a breath;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"his days are like a passing shadow."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"Part Your heavens, O LORD, and come down;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"touch the mountains, that they may smoke."}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"Flash forth Your lightning and scatter them;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"shoot Your arrows and rout them."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"Reach down from on high;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"set me free and rescue me"}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":false,"text":"from the deep waters,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"from the grasp of foreigners,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"whose mouths speak falsehood,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"whose right hands are deceitful."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"I will sing to You a new song, O God;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"on a harp of ten strings I will make music to You —"}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"to Him who gives victory to kings,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"who frees His servant David from the deadly sword."}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"Set me free and rescue me"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"from the grasp of foreigners,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":false,"text":"whose mouths speak falsehood,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"whose right hands are deceitful."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"Then our sons will be like plants"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"nurtured in their youth,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":false,"text":"our daughters like corner pillars"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"carved to adorn a palace."}]},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":true,"text":"Our storehouses will be full,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"supplying all manner of produce;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":false,"text":"our flocks will bring forth thousands,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"tens of thousands in our fields."}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":true,"text":"Our oxen will bear great loads."}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"There will be no breach in the walls,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":false,"text":"no going into captivity,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"and no cry of lament in our streets."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":true,"text":"Blessed are the people of whom this is so;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"blessed are the people whose God is the LORD."}]}]}
