{"version":"bsb","book":"psalms","chapter":11,"blocks":[{"kind":"heading","level":2,"text":"In the LORD I Take Refuge"},{"kind":"title","text":"For the choirmaster. Of David."},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"In the LORD I take refuge."}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"How then can you say to me:"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":false,"text":"“Flee like a bird to your mountain!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":true,"text":"For behold, the wicked bend their bows."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":false,"text":"They set their arrow on the string"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"to shoot from the shadows at the upright in heart."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"If the foundations are destroyed,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"what can the righteous do?”"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"The LORD is in His holy temple;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"the LORD is on His heavenly throne."}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":false,"text":"His eyes are watching closely;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"they examine the sons of men."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"The LORD tests the righteous and the wicked;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"His soul hates the lover of violence."}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"On the wicked He will rain down fiery coals and sulfur;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"a scorching wind will be their portion."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"For the LORD is righteous; He loves justice."}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"The upright will see His face."}]}]}
