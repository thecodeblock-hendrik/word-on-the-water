{"version":"bsb","book":"psalms","chapter":30,"blocks":[{"kind":"heading","level":2,"text":"You Turned My Mourning into Dancing"},{"kind":"title","text":"A Psalm. A song for the dedication of the temple. Of David."},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"I will exalt You, O LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"for You have lifted me up"}]},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":false,"text":"and have not allowed my foes"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"to rejoice over me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"O LORD my God, I cried to You for help,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"and You healed me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"O LORD, You pulled me up from Sheol;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"You spared me from descending into the Pit."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"Sing to the LORD, O you His saints,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"and praise His holy name."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"For His anger is fleeting,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"but His favor lasts a lifetime."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":false,"text":"Weeping may stay the night,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"but joy comes in the morning."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"In prosperity I said,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"“I will never be shaken.”"}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"O LORD, You favored me;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"You made my mountain stand strong."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":false,"text":"When You hid Your face,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"I was dismayed."}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"To You, O LORD, I called,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"and I begged my Lord for mercy:"}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"“What gain is there in my bloodshed,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"in my descent to the Pit?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":false,"text":"Will the dust praise You?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"Will it proclaim Your faithfulness?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"Hear me, O LORD, and have mercy;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"O LORD, be my helper.”"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"You turned my mourning into dancing;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"You peeled off my sackcloth and clothed me with joy,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"that my heart may sing Your praises and not be silent."}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"O LORD my God, I will give thanks forever."}]}]}
