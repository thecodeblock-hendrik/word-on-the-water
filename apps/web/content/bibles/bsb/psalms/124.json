{"version":"bsb","book":"psalms","chapter":124,"blocks":[{"kind":"heading","level":2,"text":"Our Help Is in the Name of the LORD"},{"kind":"title","text":"A song of ascents. Of David."},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"If the LORD had not been on our side—"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"let Israel now declare—"}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"if the LORD had not been on our side"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"when men attacked us,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"when their anger flared against us,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"then they would have swallowed us alive,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"then the floods would have engulfed us,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"then the torrent would have overwhelmed us,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"then the raging waters"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"would have swept us away."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"Blessed be the LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"who has not given us as prey to their teeth."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"We have escaped like a bird from the snare of the fowler;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"the net is torn, and we have slipped away."}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"Our help is in the name of the LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"the Maker of heaven and earth."}]}]}
