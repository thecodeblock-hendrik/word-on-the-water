{"version":"bsb","book":"psalms","chapter":78,"blocks":[{"kind":"heading","level":2,"text":"I Will Open My Mouth in Parables"},{"kind":"title","text":"A Maskil of Asaph."},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"Give ear, O my people, to my instruction;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"listen to the words of my mouth."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"I will open my mouth in parables;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"I will utter things hidden from the beginning,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"that we have heard and known"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"and our fathers have relayed to us."}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"We will not hide them from their children"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"but will declare to the next generation"}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":false,"text":"the praises of the LORD and His might"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"and the wonders He has performed."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"For He established a testimony in Jacob"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"and appointed a law in Israel,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":false,"text":"which He commanded our fathers"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"to teach to their children,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"that the coming generation would know them—"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"even children yet to be born—"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"to arise and tell their own children"}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"that they should put their confidence in God,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"not forgetting His works,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"but keeping His commandments."}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"Then they will not be like their fathers,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"a stubborn and rebellious generation,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":false,"text":"whose heart was not loyal,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"whose spirit was not faithful to God."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"The archers of Ephraim"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"turned back on the day of battle."}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"They failed to keep God’s covenant"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"and refused to live by His law."}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"They forgot what He had done,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"the wonders He had shown them."}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"He worked wonders before their fathers"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"in the land of Egypt, in the region of Zoan."}]},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":true,"text":"He split the sea and brought them through;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"He set the waters upright like a wall."}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":true,"text":"He led them with a cloud by day"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"and with a light of fire all night."}]},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":true,"text":"He split the rocks in the wilderness"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"and gave them drink as abundant as the seas."}]},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":true,"text":"He brought streams from the stone"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"and made water flow down like rivers."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":true,"text":"But they continued to sin against Him,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"rebelling in the desert against the Most High."}]},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":true,"text":"They willfully tested God"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"by demanding the food they craved."}]},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":true,"text":"They spoke against God, saying,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"“Can God really prepare a table in the wilderness?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":true,"text":"When He struck the rock, water gushed out"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"and torrents raged."}]},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":false,"text":"But can He also give bread"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"or supply His people with meat?”"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":21,"end":null,"start":true,"text":"Therefore the LORD heard"}]},{"kind":"poetry","indent":2,"runs":[{"verse":21,"end":null,"start":false,"text":"and was filled with wrath;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":21,"end":null,"start":false,"text":"so a fire was kindled against Jacob,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":21,"end":null,"start":false,"text":"and His anger flared against Israel,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":22,"end":null,"start":true,"text":"because they did not believe God"}]},{"kind":"poetry","indent":2,"runs":[{"verse":22,"end":null,"start":false,"text":"or rely on His salvation."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":23,"end":null,"start":true,"text":"Yet He commanded the clouds above"}]},{"kind":"poetry","indent":2,"runs":[{"verse":23,"end":null,"start":false,"text":"and opened the doors of the heavens."}]},{"kind":"poetry","indent":1,"runs":[{"verse":24,"end":null,"start":true,"text":"He rained down manna for them to eat;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":24,"end":null,"start":false,"text":"He gave them grain from heaven."}]},{"kind":"poetry","indent":1,"runs":[{"verse":25,"end":null,"start":true,"text":"Man ate the bread of angels;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":25,"end":null,"start":false,"text":"He sent them food in abundance."}]},{"kind":"poetry","indent":1,"runs":[{"verse":26,"end":null,"start":true,"text":"He stirred the east wind from the heavens"}]},{"kind":"poetry","indent":2,"runs":[{"verse":26,"end":null,"start":false,"text":"and drove the south wind by His might."}]},{"kind":"poetry","indent":1,"runs":[{"verse":27,"end":null,"start":true,"text":"He rained meat on them like dust,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":27,"end":null,"start":false,"text":"and winged birds like the sand of the sea."}]},{"kind":"poetry","indent":1,"runs":[{"verse":28,"end":null,"start":true,"text":"He felled them in the midst of their camp,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":28,"end":null,"start":false,"text":"all around their dwellings."}]},{"kind":"poetry","indent":1,"runs":[{"verse":29,"end":null,"start":true,"text":"So they ate and were well filled,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":29,"end":null,"start":false,"text":"for He gave them what they craved."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":30,"end":null,"start":true,"text":"Yet before they had filled their desire,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":30,"end":null,"start":false,"text":"with the food still in their mouths,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":31,"end":null,"start":true,"text":"God’s anger flared against them,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":31,"end":null,"start":false,"text":"and He put to death their strongest"}]},{"kind":"poetry","indent":2,"runs":[{"verse":31,"end":null,"start":false,"text":"and subdued the young men of Israel."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":32,"end":null,"start":true,"text":"In spite of all this, they kept on sinning;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":32,"end":null,"start":false,"text":"despite His wonderful works, they did not believe."}]},{"kind":"poetry","indent":1,"runs":[{"verse":33,"end":null,"start":true,"text":"So He ended their days in futility,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":33,"end":null,"start":false,"text":"and their years in sudden terror."}]},{"kind":"poetry","indent":1,"runs":[{"verse":34,"end":null,"start":true,"text":"When He slew them, they would seek Him;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":34,"end":null,"start":false,"text":"they repented and searched for God."}]},{"kind":"poetry","indent":1,"runs":[{"verse":35,"end":null,"start":true,"text":"And they remembered that God was their Rock,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":35,"end":null,"start":false,"text":"that God Most High was their Redeemer."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":36,"end":null,"start":true,"text":"But they deceived Him with their mouths,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":36,"end":null,"start":false,"text":"and lied to Him with their tongues."}]},{"kind":"poetry","indent":1,"runs":[{"verse":37,"end":null,"start":true,"text":"Their hearts were disloyal to Him,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":37,"end":null,"start":false,"text":"and they were unfaithful to His covenant."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":38,"end":null,"start":true,"text":"And yet He was compassionate;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":38,"end":null,"start":false,"text":"He forgave their iniquity and did not destroy them."}]},{"kind":"poetry","indent":1,"runs":[{"verse":38,"end":null,"start":false,"text":"He often restrained His anger"}]},{"kind":"poetry","indent":2,"runs":[{"verse":38,"end":null,"start":false,"text":"and did not unleash His full wrath."}]},{"kind":"poetry","indent":1,"runs":[{"verse":39,"end":null,"start":true,"text":"He remembered that they were but flesh,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":39,"end":null,"start":false,"text":"a passing breeze that does not return."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":40,"end":null,"start":true,"text":"How often they disobeyed Him in the wilderness"}]},{"kind":"poetry","indent":2,"runs":[{"verse":40,"end":null,"start":false,"text":"and grieved Him in the desert!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":41,"end":null,"start":true,"text":"Again and again they tested God"}]},{"kind":"poetry","indent":2,"runs":[{"verse":41,"end":null,"start":false,"text":"and provoked the Holy One of Israel."}]},{"kind":"poetry","indent":1,"runs":[{"verse":42,"end":null,"start":true,"text":"They did not remember His power —"}]},{"kind":"poetry","indent":2,"runs":[{"verse":42,"end":null,"start":false,"text":"the day He redeemed them from the adversary,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":43,"end":null,"start":true,"text":"when He performed His signs in Egypt"}]},{"kind":"poetry","indent":2,"runs":[{"verse":43,"end":null,"start":false,"text":"and His wonders in the fields of Zoan."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":44,"end":null,"start":true,"text":"He turned their rivers to blood,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":44,"end":null,"start":false,"text":"and from their streams they could not drink."}]},{"kind":"poetry","indent":1,"runs":[{"verse":45,"end":null,"start":true,"text":"He sent swarms of flies that devoured them,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":45,"end":null,"start":false,"text":"and frogs that devastated them."}]},{"kind":"poetry","indent":1,"runs":[{"verse":46,"end":null,"start":true,"text":"He gave their crops to the grasshopper,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":46,"end":null,"start":false,"text":"the fruit of their labor to the locust."}]},{"kind":"poetry","indent":1,"runs":[{"verse":47,"end":null,"start":true,"text":"He killed their vines with hailstones"}]},{"kind":"poetry","indent":2,"runs":[{"verse":47,"end":null,"start":false,"text":"and their sycamore-figs with sleet."}]},{"kind":"poetry","indent":1,"runs":[{"verse":48,"end":null,"start":true,"text":"He abandoned their cattle to the hail"}]},{"kind":"poetry","indent":2,"runs":[{"verse":48,"end":null,"start":false,"text":"and their livestock to bolts of lightning."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":49,"end":null,"start":true,"text":"He unleashed His fury against them,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":49,"end":null,"start":false,"text":"wrath, indignation, and calamity—"}]},{"kind":"poetry","indent":2,"runs":[{"verse":49,"end":null,"start":false,"text":"a band of destroying angels."}]},{"kind":"poetry","indent":1,"runs":[{"verse":50,"end":null,"start":true,"text":"He cleared a path for His anger;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":50,"end":null,"start":false,"text":"He did not spare them from death"}]},{"kind":"poetry","indent":2,"runs":[{"verse":50,"end":null,"start":false,"text":"but delivered their lives to the plague."}]},{"kind":"poetry","indent":1,"runs":[{"verse":51,"end":null,"start":true,"text":"He struck all the firstborn of Egypt,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":51,"end":null,"start":false,"text":"the virility in the tents of Ham."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":52,"end":null,"start":true,"text":"He led out His people like sheep"}]},{"kind":"poetry","indent":2,"runs":[{"verse":52,"end":null,"start":false,"text":"and guided them like a flock in the wilderness."}]},{"kind":"poetry","indent":1,"runs":[{"verse":53,"end":null,"start":true,"text":"He led them safely, so they did not fear,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":53,"end":null,"start":false,"text":"but the sea engulfed their enemies."}]},{"kind":"poetry","indent":1,"runs":[{"verse":54,"end":null,"start":true,"text":"He brought them to His holy land,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":54,"end":null,"start":false,"text":"to the mountain His right hand had acquired."}]},{"kind":"poetry","indent":1,"runs":[{"verse":55,"end":null,"start":true,"text":"He drove out nations before them"}]},{"kind":"poetry","indent":2,"runs":[{"verse":55,"end":null,"start":false,"text":"and apportioned their inheritance;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":55,"end":null,"start":false,"text":"He settled the tribes of Israel in their tents."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":56,"end":null,"start":true,"text":"But they tested and disobeyed God Most High,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":56,"end":null,"start":false,"text":"for they did not keep His decrees."}]},{"kind":"poetry","indent":1,"runs":[{"verse":57,"end":null,"start":true,"text":"They turned back and were faithless like their fathers,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":57,"end":null,"start":false,"text":"twisted like a faulty bow."}]},{"kind":"poetry","indent":1,"runs":[{"verse":58,"end":null,"start":true,"text":"They enraged Him with their high places"}]},{"kind":"poetry","indent":2,"runs":[{"verse":58,"end":null,"start":false,"text":"and provoked His jealousy with their idols."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":59,"end":null,"start":true,"text":"On hearing it, God was furious"}]},{"kind":"poetry","indent":2,"runs":[{"verse":59,"end":null,"start":false,"text":"and rejected Israel completely."}]},{"kind":"poetry","indent":1,"runs":[{"verse":60,"end":null,"start":true,"text":"He abandoned the tabernacle of Shiloh,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":60,"end":null,"start":false,"text":"the tent He had pitched among men."}]},{"kind":"poetry","indent":1,"runs":[{"verse":61,"end":null,"start":true,"text":"He delivered His strength to captivity,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":61,"end":null,"start":false,"text":"and His splendor to the hand of the adversary."}]},{"kind":"poetry","indent":1,"runs":[{"verse":62,"end":null,"start":true,"text":"He surrendered His people to the sword"}]},{"kind":"poetry","indent":2,"runs":[{"verse":62,"end":null,"start":false,"text":"because He was enraged by His heritage."}]},{"kind":"poetry","indent":1,"runs":[{"verse":63,"end":null,"start":true,"text":"Fire consumed His young men,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":63,"end":null,"start":false,"text":"and their maidens were left without wedding songs."}]},{"kind":"poetry","indent":1,"runs":[{"verse":64,"end":null,"start":true,"text":"His priests fell by the sword,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":64,"end":null,"start":false,"text":"but their widows could not lament."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":65,"end":null,"start":true,"text":"Then the Lord awoke as from sleep,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":65,"end":null,"start":false,"text":"like a mighty warrior overcome by wine."}]},{"kind":"poetry","indent":1,"runs":[{"verse":66,"end":null,"start":true,"text":"He beat back His foes;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":66,"end":null,"start":false,"text":"He put them to everlasting shame."}]},{"kind":"poetry","indent":1,"runs":[{"verse":67,"end":null,"start":true,"text":"He rejected the tent of Joseph"}]},{"kind":"poetry","indent":2,"runs":[{"verse":67,"end":null,"start":false,"text":"and refused the tribe of Ephraim."}]},{"kind":"poetry","indent":1,"runs":[{"verse":68,"end":null,"start":true,"text":"But He chose the tribe of Judah,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":68,"end":null,"start":false,"text":"Mount Zion, which He loved."}]},{"kind":"poetry","indent":1,"runs":[{"verse":69,"end":null,"start":true,"text":"He built His sanctuary like the heights,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":69,"end":null,"start":false,"text":"like the earth He has established forever."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":70,"end":null,"start":true,"text":"He chose David His servant"}]},{"kind":"poetry","indent":2,"runs":[{"verse":70,"end":null,"start":false,"text":"and took him from the sheepfolds;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":71,"end":null,"start":true,"text":"from tending the ewes He brought him"}]},{"kind":"poetry","indent":2,"runs":[{"verse":71,"end":null,"start":false,"text":"to be shepherd of His people Jacob,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":71,"end":null,"start":false,"text":"of Israel His inheritance."}]},{"kind":"poetry","indent":1,"runs":[{"verse":72,"end":null,"start":true,"text":"So David shepherded them with integrity of heart"}]},{"kind":"poetry","indent":2,"runs":[{"verse":72,"end":null,"start":false,"text":"and guided them with skillful hands."}]}]}
