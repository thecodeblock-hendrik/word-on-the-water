{"version":"bsb","book":"psalms","chapter":43,"blocks":[{"kind":"heading","level":2,"text":"Send Out Your Light"},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"Vindicate me, O God, and plead my case"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"against an ungodly nation;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"deliver me from deceitful and unjust men."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"For You are the God of my refuge."}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"Why have You rejected me?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":false,"text":"Why must I walk in sorrow"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"because of the enemy’s oppression?"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"Send out Your light and Your truth;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"let them lead me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":false,"text":"Let them bring me to Your holy mountain"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"and to the place where You dwell."}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"Then I will go to the altar of God,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"to God, my greatest joy."}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":false,"text":"I will praise You with the harp,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"O God, my God."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"Why are you downcast, O my soul?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"Why the unease within me?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":false,"text":"Put your hope in God, for I will yet praise Him,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"my Savior and my God."}]}]}
