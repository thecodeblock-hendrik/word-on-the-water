{"version":"bsb","book":"psalms","chapter":104,"blocks":[{"kind":"heading","level":2,"text":"How Many Are Your Works, O LORD!"},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"Bless the LORD, O my soul!"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":false,"text":"O LORD my God, You are very great;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"You are clothed with splendor and majesty."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"He wraps Himself in light as with a garment;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"He stretches out the heavens like a tent,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"laying the beams of His chambers"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"in the waters above,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":false,"text":"making the clouds His chariot,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"walking on the wings of the wind."}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"He makes the winds His messengers,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"flames of fire His servants."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"He set the earth on its foundations,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"never to be moved."}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"You covered it with the deep like a garment;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"the waters stood above the mountains."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"At Your rebuke the waters fled;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"at the sound of Your thunder they hurried away —"}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"the mountains rose and the valleys sank"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"to the place You assigned for them —"}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"You set a boundary they cannot cross,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"that they may never again cover the earth."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"He sends forth springs in the valleys;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"they flow between the mountains."}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"They give drink to every beast of the field;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"the wild donkeys quench their thirst."}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"The birds of the air nest beside the springs;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"they sing among the branches."}]},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":true,"text":"He waters the mountains from His chambers;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"the earth is satisfied by the fruit of His works."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":true,"text":"He makes the grass grow for the livestock"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"and provides crops for man to cultivate,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"bringing forth food from the earth:"}]},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":true,"text":"wine that gladdens the heart of man,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"oil that makes his face to shine,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"and bread that sustains his heart."}]},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":true,"text":"The trees of the LORD have their fill,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"the cedars of Lebanon that He planted,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":true,"text":"where the birds build their nests;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"the stork makes her home in the cypresses."}]},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":true,"text":"The high mountains are for the wild goats,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"the cliffs a refuge for the rock badgers."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":true,"text":"He made the moon to mark the seasons;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"the sun knows when to set."}]},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":true,"text":"You bring darkness, and it becomes night,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"when all the beasts of the forest prowl."}]},{"kind":"poetry","indent":1,"runs":[{"verse":21,"end":null,"start":true,"text":"The young lions roar for their prey"}]},{"kind":"poetry","indent":2,"runs":[{"verse":21,"end":null,"start":false,"text":"and seek their food from God."}]},{"kind":"poetry","indent":1,"runs":[{"verse":22,"end":null,"start":true,"text":"The sun rises, and they withdraw;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":22,"end":null,"start":false,"text":"they lie down in their dens."}]},{"kind":"poetry","indent":1,"runs":[{"verse":23,"end":null,"start":true,"text":"Man goes forth to his work"}]},{"kind":"poetry","indent":2,"runs":[{"verse":23,"end":null,"start":false,"text":"and to his labor until evening."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":24,"end":null,"start":true,"text":"How many are Your works, O LORD!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":24,"end":null,"start":false,"text":"In wisdom You have made them all;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":24,"end":null,"start":false,"text":"the earth is full of Your creatures."}]},{"kind":"poetry","indent":1,"runs":[{"verse":25,"end":null,"start":true,"text":"Here is the sea, vast and wide,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":25,"end":null,"start":false,"text":"teeming with creatures beyond number,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":25,"end":null,"start":false,"text":"living things both great and small."}]},{"kind":"poetry","indent":1,"runs":[{"verse":26,"end":null,"start":true,"text":"There the ships pass,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":26,"end":null,"start":false,"text":"and Leviathan, which You formed to frolic there."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":27,"end":null,"start":true,"text":"All creatures look to You"}]},{"kind":"poetry","indent":2,"runs":[{"verse":27,"end":null,"start":false,"text":"to give them their food in due season."}]},{"kind":"poetry","indent":1,"runs":[{"verse":28,"end":null,"start":true,"text":"When You give it to them,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":28,"end":null,"start":false,"text":"they gather it up;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":28,"end":null,"start":false,"text":"when You open Your hand,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":28,"end":null,"start":false,"text":"they are satisfied with good things."}]},{"kind":"poetry","indent":1,"runs":[{"verse":29,"end":null,"start":true,"text":"When You hide Your face,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":29,"end":null,"start":false,"text":"they are terrified;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":29,"end":null,"start":false,"text":"when You take away their breath,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":29,"end":null,"start":false,"text":"they die and return to dust."}]},{"kind":"poetry","indent":1,"runs":[{"verse":30,"end":null,"start":true,"text":"When You send Your Spirit,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":30,"end":null,"start":false,"text":"they are created,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":30,"end":null,"start":false,"text":"and You renew"}]},{"kind":"poetry","indent":2,"runs":[{"verse":30,"end":null,"start":false,"text":"the face of the earth."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":31,"end":null,"start":true,"text":"May the glory of the LORD endure forever;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":31,"end":null,"start":false,"text":"may the LORD rejoice in His works."}]},{"kind":"poetry","indent":1,"runs":[{"verse":32,"end":null,"start":true,"text":"He looks on the earth,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":32,"end":null,"start":false,"text":"and it trembles;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":32,"end":null,"start":false,"text":"He touches the mountains,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":32,"end":null,"start":false,"text":"and they smolder."}]},{"kind":"poetry","indent":1,"runs":[{"verse":33,"end":null,"start":true,"text":"I will sing to the LORD all my life;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":33,"end":null,"start":false,"text":"I will sing praise to my God while I have my being."}]},{"kind":"poetry","indent":1,"runs":[{"verse":34,"end":null,"start":true,"text":"May my meditation be pleasing to Him,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":34,"end":null,"start":false,"text":"for I rejoice in the LORD."}]},{"kind":"poetry","indent":1,"runs":[{"verse":35,"end":null,"start":true,"text":"May sinners vanish from the earth"}]},{"kind":"poetry","indent":2,"runs":[{"verse":35,"end":null,"start":false,"text":"and the wicked be no more."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":35,"end":null,"start":false,"text":"Bless the LORD, O my soul."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":35,"end":null,"start":false,"text":"Hallelujah!"}]}]}
