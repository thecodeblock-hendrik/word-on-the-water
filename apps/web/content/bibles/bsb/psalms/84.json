{"version":"bsb","book":"psalms","chapter":84,"blocks":[{"kind":"heading","level":2,"text":"Better Is One Day in Your Courts"},{"kind":"title","text":"For the choirmaster. According to Gittith. A Psalm of the sons of Korah."},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"How lovely is Your dwelling place,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"O LORD of Hosts!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"My soul longs, even faints,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"for the courts of the LORD;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":false,"text":"my heart and my flesh cry out"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"for the living God."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"Even the sparrow has found a home,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"and the swallow a nest for herself,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":false,"text":"where she places her young near Your altars,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"O LORD of Hosts, my King and my God."}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"How blessed are those who dwell in Your house!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"They are ever praising You."}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"Selah"}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"Blessed are those whose strength is in You,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"whose hearts are set on pilgrimage."}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"As they pass through the Valley of Baca,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"they make it a place of springs;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"even the autumn rain covers it with pools."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"They go from strength to strength,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"until each appears before God in Zion."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"O LORD God of Hosts, hear my prayer;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"give ear, O God of Jacob."}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"Selah"}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"Take notice of our shield, O God,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"and look with favor on the face of Your anointed."}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"For better is one day in Your courts"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"than a thousand elsewhere."}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":false,"text":"I would rather be a doorkeeper in the house of my God"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"than dwell in the tents of the wicked."}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"For the LORD God is a sun and a shield;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"the LORD gives grace and glory;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":false,"text":"He withholds no good thing"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"from those who walk with integrity."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"O LORD of Hosts,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"how blessed is the man who trusts in You!"}]}]}
