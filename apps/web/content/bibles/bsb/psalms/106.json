{"version":"bsb","book":"psalms","chapter":106,"blocks":[{"kind":"heading","level":2,"text":"Give Thanks to the LORD, for He Is Good"},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"Hallelujah!"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":false,"text":"Give thanks to the LORD, for He is good;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"His loving devotion endures forever."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"Who can describe the mighty acts of the LORD"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"or fully proclaim His praise?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"Blessed are those who uphold justice,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"who practice righteousness at all times."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"Remember me, O LORD, in Your favor to Your people;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"visit me with Your salvation,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"that I may see the prosperity of Your chosen ones,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"and rejoice in the gladness of Your nation,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"and give glory with Your inheritance."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"We have sinned like our fathers;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"we have done wrong and acted wickedly."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"Our fathers in Egypt did not grasp Your wonders"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"or remember Your abundant kindness;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":false,"text":"but they rebelled by the sea,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"there at the Red Sea."}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"Yet He saved them for the sake of His name,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"to make His power known."}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"He rebuked the Red Sea, and it dried up;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"He led them through the depths as through a desert."}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"He saved them from the hand that hated them;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"He redeemed them from the hand of the enemy."}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"The waters covered their foes;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"not one of them remained."}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"Then they believed His promises"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"and sang His praise."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":true,"text":"Yet they soon forgot His works"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"and failed to wait for His counsel."}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":true,"text":"They craved intensely in the wilderness"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"and tested God in the desert."}]},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":true,"text":"So He granted their request,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"but sent a wasting disease upon them."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":true,"text":"In the camp they envied Moses,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"as well as Aaron, the holy one of the LORD."}]},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":true,"text":"The earth opened up and swallowed Dathan;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"it covered the assembly of Abiram."}]},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":true,"text":"Then fire blazed through their company;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"flames consumed the wicked."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":true,"text":"At Horeb they made a calf"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"and worshiped a molten image."}]},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":true,"text":"They exchanged their Glory"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"for the image of a grass-eating ox."}]},{"kind":"poetry","indent":1,"runs":[{"verse":21,"end":null,"start":true,"text":"They forgot God their Savior,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":21,"end":null,"start":false,"text":"who did great things in Egypt,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":22,"end":null,"start":true,"text":"wondrous works in the land of Ham,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":22,"end":null,"start":false,"text":"and awesome deeds by the Red Sea."}]},{"kind":"poetry","indent":1,"runs":[{"verse":23,"end":null,"start":true,"text":"So He said He would destroy them—"}]},{"kind":"poetry","indent":2,"runs":[{"verse":23,"end":null,"start":false,"text":"had not Moses His chosen one"}]},{"kind":"poetry","indent":1,"runs":[{"verse":23,"end":null,"start":false,"text":"stood before Him in the breach"}]},{"kind":"poetry","indent":2,"runs":[{"verse":23,"end":null,"start":false,"text":"to divert His wrath from destroying them."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":24,"end":null,"start":true,"text":"They despised the pleasant land;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":24,"end":null,"start":false,"text":"they did not believe His promise."}]},{"kind":"poetry","indent":1,"runs":[{"verse":25,"end":null,"start":true,"text":"They grumbled in their tents"}]},{"kind":"poetry","indent":2,"runs":[{"verse":25,"end":null,"start":false,"text":"and did not listen to the voice of the LORD."}]},{"kind":"poetry","indent":1,"runs":[{"verse":26,"end":null,"start":true,"text":"So He raised His hand and swore"}]},{"kind":"poetry","indent":2,"runs":[{"verse":26,"end":null,"start":false,"text":"to cast them down in the wilderness,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":27,"end":null,"start":true,"text":"to disperse their offspring among the nations"}]},{"kind":"poetry","indent":2,"runs":[{"verse":27,"end":null,"start":false,"text":"and scatter them throughout the lands."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":28,"end":null,"start":true,"text":"They yoked themselves to Baal of Peor"}]},{"kind":"poetry","indent":2,"runs":[{"verse":28,"end":null,"start":false,"text":"and ate sacrifices offered to lifeless gods."}]},{"kind":"poetry","indent":1,"runs":[{"verse":29,"end":null,"start":true,"text":"So they provoked the LORD to anger with their deeds,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":29,"end":null,"start":false,"text":"and a plague broke out among them."}]},{"kind":"poetry","indent":1,"runs":[{"verse":30,"end":null,"start":true,"text":"But Phinehas stood and intervened,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":30,"end":null,"start":false,"text":"and the plague was restrained."}]},{"kind":"poetry","indent":1,"runs":[{"verse":31,"end":null,"start":true,"text":"It was credited to him as righteousness"}]},{"kind":"poetry","indent":2,"runs":[{"verse":31,"end":null,"start":false,"text":"for endless generations to come."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":32,"end":null,"start":true,"text":"At the waters of Meribah they angered the LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":32,"end":null,"start":false,"text":"and trouble came to Moses because of them."}]},{"kind":"poetry","indent":1,"runs":[{"verse":33,"end":null,"start":true,"text":"For they rebelled against His Spirit,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":33,"end":null,"start":false,"text":"and Moses spoke rashly with his lips."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":34,"end":null,"start":true,"text":"They did not destroy the peoples"}]},{"kind":"poetry","indent":2,"runs":[{"verse":34,"end":null,"start":false,"text":"as the LORD had commanded them,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":35,"end":null,"start":true,"text":"but they mingled with the nations"}]},{"kind":"poetry","indent":2,"runs":[{"verse":35,"end":null,"start":false,"text":"and adopted their customs."}]},{"kind":"poetry","indent":1,"runs":[{"verse":36,"end":null,"start":true,"text":"They worshiped their idols,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":36,"end":null,"start":false,"text":"which became a snare to them."}]},{"kind":"poetry","indent":1,"runs":[{"verse":37,"end":null,"start":true,"text":"They sacrificed their sons"}]},{"kind":"poetry","indent":2,"runs":[{"verse":37,"end":null,"start":false,"text":"and their daughters to demons."}]},{"kind":"poetry","indent":1,"runs":[{"verse":38,"end":null,"start":true,"text":"They shed innocent blood—"}]},{"kind":"poetry","indent":2,"runs":[{"verse":38,"end":null,"start":false,"text":"the blood of their sons and daughters,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":38,"end":null,"start":false,"text":"whom they sacrificed to the idols of Canaan,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":38,"end":null,"start":false,"text":"and the land was polluted with blood."}]},{"kind":"poetry","indent":1,"runs":[{"verse":39,"end":null,"start":true,"text":"They defiled themselves by their actions"}]},{"kind":"poetry","indent":2,"runs":[{"verse":39,"end":null,"start":false,"text":"and prostituted themselves by their deeds."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":40,"end":null,"start":true,"text":"So the anger of the LORD burned against His people,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":40,"end":null,"start":false,"text":"and He abhorred His own inheritance."}]},{"kind":"poetry","indent":1,"runs":[{"verse":41,"end":null,"start":true,"text":"He delivered them into the hand of the nations,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":41,"end":null,"start":false,"text":"and those who hated them ruled over them."}]},{"kind":"poetry","indent":1,"runs":[{"verse":42,"end":null,"start":true,"text":"Their enemies oppressed them"}]},{"kind":"poetry","indent":2,"runs":[{"verse":42,"end":null,"start":false,"text":"and subdued them under their hand."}]},{"kind":"poetry","indent":1,"runs":[{"verse":43,"end":null,"start":true,"text":"Many times He rescued them,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":43,"end":null,"start":false,"text":"but they were bent on rebellion"}]},{"kind":"poetry","indent":2,"runs":[{"verse":43,"end":null,"start":false,"text":"and sank down in their iniquity."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":44,"end":null,"start":true,"text":"Nevertheless He heard their cry;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":44,"end":null,"start":false,"text":"He took note of their distress."}]},{"kind":"poetry","indent":1,"runs":[{"verse":45,"end":null,"start":true,"text":"And He remembered His covenant with them,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":45,"end":null,"start":false,"text":"and relented by the abundance of His loving devotion."}]},{"kind":"poetry","indent":1,"runs":[{"verse":46,"end":null,"start":true,"text":"He made them objects of compassion"}]},{"kind":"poetry","indent":2,"runs":[{"verse":46,"end":null,"start":false,"text":"to all who held them captive."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":47,"end":null,"start":true,"text":"Save us, O LORD our God,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":47,"end":null,"start":false,"text":"and gather us from the nations,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":47,"end":null,"start":false,"text":"that we may give thanks to Your holy name,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":47,"end":null,"start":false,"text":"that we may glory in Your praise."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":48,"end":null,"start":true,"text":"Blessed be the LORD, the God of Israel,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":48,"end":null,"start":false,"text":"from everlasting to everlasting."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":48,"end":null,"start":false,"text":"Let all the people say, “Amen!”"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":48,"end":null,"start":false,"text":"Hallelujah!"}]}]}
