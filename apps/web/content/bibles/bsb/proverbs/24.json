{"version":"bsb","book":"proverbs","chapter":24,"blocks":[{"kind":"heading","level":2,"text":"Do Not Envy"},{"kind":"heading","level":3,"text":"Saying 20"},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"Do not envy wicked men"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"or desire their company;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"for their hearts devise violence,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"and their lips declare trouble."}]},{"kind":"heading","level":3,"text":"Saying 21"},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"By wisdom a house is built"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"and by understanding it is established;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"through knowledge its rooms are filled"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"with every precious and beautiful treasure."}]},{"kind":"heading","level":3,"text":"Saying 22"},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"A wise man is strong,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"and a man of knowledge enhances his strength."}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"Only with sound guidance should you wage war,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"and victory lies in a multitude of counselors."}]},{"kind":"heading","level":3,"text":"Saying 23"},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"Wisdom is too high for a fool;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"he does not open his mouth in the meeting place."}]},{"kind":"heading","level":3,"text":"Saying 24"},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"He who plots evil"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"will be called a schemer."}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"A foolish scheme is sin,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"and a mocker is detestable to men."}]},{"kind":"heading","level":3,"text":"Saying 25"},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"If you faint in the day of distress,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"how small is your strength!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"Rescue those being led away to death,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"and restrain those stumbling toward the slaughter."}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"If you say, “Behold, we did not know about this,”"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"does not He who weighs hearts consider it?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":false,"text":"Does not the One who guards your life know?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"Will He not repay a man according to his deeds?"}]},{"kind":"heading","level":3,"text":"Saying 26"},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":true,"text":"Eat honey, my son, for it is good,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"and the honeycomb is sweet to your taste."}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":true,"text":"Know therefore that wisdom is sweet to your soul."}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"If you find it, there is a future for you,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"and your hope will never be cut off."}]},{"kind":"heading","level":3,"text":"Saying 27"},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":true,"text":"Do not lie in wait, O wicked man, near the dwelling of the righteous;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"do not destroy his resting place."}]},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":true,"text":"For though a righteous man may fall seven times, he still gets up;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"but the wicked stumble in bad times."}]},{"kind":"heading","level":3,"text":"Saying 28"},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":true,"text":"Do not gloat when your enemy falls,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"and do not let your heart rejoice when he stumbles,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":true,"text":"or the LORD will see and disapprove,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"and turn His wrath away from him."}]},{"kind":"heading","level":3,"text":"Saying 29"},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":true,"text":"Do not fret over evildoers,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"and do not be envious of the wicked."}]},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":true,"text":"For the evil man has no future;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"the lamp of the wicked will be extinguished."}]},{"kind":"heading","level":3,"text":"Saying 30"},{"kind":"poetry","indent":1,"runs":[{"verse":21,"end":null,"start":true,"text":"My son, fear the LORD and the king,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":21,"end":null,"start":false,"text":"and do not associate with the rebellious."}]},{"kind":"poetry","indent":1,"runs":[{"verse":22,"end":null,"start":true,"text":"For they will bring sudden destruction."}]},{"kind":"poetry","indent":2,"runs":[{"verse":22,"end":null,"start":false,"text":"Who knows what ruin they can bring?"}]},{"kind":"heading","level":2,"text":"Further Sayings of the Wise"},{"kind":"paragraph","indent":0,"runs":[{"verse":23,"end":null,"start":true,"text":"These also are sayings of the wise:"}]},{"kind":"poetry","indent":1,"runs":[{"verse":23,"end":null,"start":false,"text":"To show partiality in judgment"}]},{"kind":"poetry","indent":2,"runs":[{"verse":23,"end":null,"start":false,"text":"is not good."}]},{"kind":"poetry","indent":1,"runs":[{"verse":24,"end":null,"start":true,"text":"Whoever tells the guilty, “You are innocent”—"}]},{"kind":"poetry","indent":2,"runs":[{"verse":24,"end":null,"start":false,"text":"peoples will curse him, and nations will denounce him;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":25,"end":null,"start":true,"text":"but it will go well with those who convict the guilty,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":25,"end":null,"start":false,"text":"and rich blessing will come upon them."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":26,"end":null,"start":true,"text":"An honest answer given"}]},{"kind":"poetry","indent":2,"runs":[{"verse":26,"end":null,"start":false,"text":"is like a kiss on the lips."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":27,"end":null,"start":true,"text":"Complete your outdoor work and prepare your field;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":27,"end":null,"start":false,"text":"after that, you may build your house."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":28,"end":null,"start":true,"text":"Do not testify against your neighbor without cause,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":28,"end":null,"start":false,"text":"and do not deceive with your lips."}]},{"kind":"poetry","indent":1,"runs":[{"verse":29,"end":null,"start":true,"text":"Do not say, “I will do to him as he has done to me;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":29,"end":null,"start":false,"text":"I will repay the man according to his work.”"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":30,"end":null,"start":true,"text":"I went past the field of a slacker"}]},{"kind":"poetry","indent":2,"runs":[{"verse":30,"end":null,"start":false,"text":"and by the vineyard of a man lacking judgment."}]},{"kind":"poetry","indent":1,"runs":[{"verse":31,"end":null,"start":true,"text":"Thorns had grown up everywhere,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":31,"end":null,"start":false,"text":"thistles had covered the ground,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":31,"end":null,"start":false,"text":"and the stone wall was broken down."}]},{"kind":"poetry","indent":1,"runs":[{"verse":32,"end":null,"start":true,"text":"I observed and took it to heart;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":32,"end":null,"start":false,"text":"I looked and received instruction:"}]},{"kind":"poetry","indent":1,"runs":[{"verse":33,"end":null,"start":true,"text":"A little sleep, a little slumber,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":33,"end":null,"start":false,"text":"a little folding of the hands to rest,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":34,"end":null,"start":true,"text":"and poverty will come upon you like a robber,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":34,"end":null,"start":false,"text":"and need like a bandit."}]}]}
