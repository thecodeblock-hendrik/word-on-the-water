{"version":"bsb","book":"proverbs","chapter":23,"blocks":[{"kind":"heading","level":2,"text":"True Riches"},{"kind":"heading","level":3,"text":"Saying 7"},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"When you sit down to dine with a ruler,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"consider carefully what is set before you,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"and put a knife to your throat"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"if you possess a great appetite."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"Do not crave his delicacies,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"for that food is deceptive."}]},{"kind":"heading","level":3,"text":"Saying 8"},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"Do not wear yourself out to get rich;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"be wise enough to restrain yourself."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"When you glance at wealth, it disappears,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"for it makes wings for itself"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"and flies like an eagle to the sky."}]},{"kind":"heading","level":3,"text":"Saying 9"},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"Do not eat the bread of a stingy man,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"and do not crave his delicacies;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"for he is keeping track,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"inwardly counting the cost."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":false,"text":"“Eat and drink,” he says to you,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"but his heart is not with you."}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"You will vomit up what little you have eaten"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"and waste your pleasant words."}]},{"kind":"heading","level":3,"text":"Saying 10"},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"Do not speak to a fool,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"for he will despise the wisdom of your words."}]},{"kind":"heading","level":3,"text":"Saying 11"},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"Do not move an ancient boundary stone"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"or encroach on the fields of the fatherless,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"for their Redeemer is strong;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"He will take up their case against you."}]},{"kind":"heading","level":3,"text":"Saying 12"},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"Apply your heart to instruction"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"and your ears to words of knowledge."}]},{"kind":"heading","level":3,"text":"Saying 13"},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":true,"text":"Do not withhold discipline from a child;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"although you strike him with a rod, he will not die."}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":true,"text":"Strike him with a rod,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"and you will deliver his soul from Sheol."}]},{"kind":"heading","level":3,"text":"Saying 14"},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":true,"text":"My son, if your heart is wise,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"my own heart will indeed rejoice."}]},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":true,"text":"My inmost being will rejoice"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"when your lips speak what is right."}]},{"kind":"heading","level":3,"text":"Saying 15"},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":true,"text":"Do not let your heart envy sinners,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"but always continue in the fear of the LORD."}]},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":true,"text":"For surely there is a future,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"and your hope will not be cut off."}]},{"kind":"heading","level":3,"text":"Saying 16"},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":true,"text":"Listen, my son, and be wise,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"and guide your heart on the right course."}]},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":true,"text":"Do not join those who drink too much wine"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"or gorge themselves on meat."}]},{"kind":"poetry","indent":1,"runs":[{"verse":21,"end":null,"start":true,"text":"For the drunkard and the glutton will come to poverty,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":21,"end":null,"start":false,"text":"and drowsiness will clothe them in rags."}]},{"kind":"heading","level":3,"text":"Saying 17"},{"kind":"poetry","indent":1,"runs":[{"verse":22,"end":null,"start":true,"text":"Listen to your father who gave you life,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":22,"end":null,"start":false,"text":"and do not despise your mother when she is old."}]},{"kind":"poetry","indent":1,"runs":[{"verse":23,"end":null,"start":true,"text":"Invest in truth and never sell it—"}]},{"kind":"poetry","indent":2,"runs":[{"verse":23,"end":null,"start":false,"text":"in wisdom and instruction and understanding."}]},{"kind":"poetry","indent":1,"runs":[{"verse":24,"end":null,"start":true,"text":"The father of a righteous man will greatly rejoice,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":24,"end":null,"start":false,"text":"and he who fathers a wise son will delight in him."}]},{"kind":"poetry","indent":1,"runs":[{"verse":25,"end":null,"start":true,"text":"May your father and mother be glad,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":25,"end":null,"start":false,"text":"and may she who gave you birth rejoice!"}]},{"kind":"heading","level":3,"text":"Saying 18"},{"kind":"poetry","indent":1,"runs":[{"verse":26,"end":null,"start":true,"text":"My son, give me your heart,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":26,"end":null,"start":false,"text":"and let your eyes delight in my ways."}]},{"kind":"poetry","indent":1,"runs":[{"verse":27,"end":null,"start":true,"text":"For a prostitute is a deep pit,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":27,"end":null,"start":false,"text":"and an adulteress is a narrow well."}]},{"kind":"poetry","indent":1,"runs":[{"verse":28,"end":null,"start":true,"text":"Like a robber she lies in wait"}]},{"kind":"poetry","indent":2,"runs":[{"verse":28,"end":null,"start":false,"text":"and multiplies the faithless among men."}]},{"kind":"heading","level":3,"text":"Saying 19"},{"kind":"poetry","indent":1,"runs":[{"verse":29,"end":null,"start":true,"text":"Who has woe? Who has sorrow?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":29,"end":null,"start":false,"text":"Who has contentions? Who has complaints?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":29,"end":null,"start":false,"text":"Who has needless wounds? Who has bloodshot eyes?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":30,"end":null,"start":true,"text":"Those who linger over wine,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":30,"end":null,"start":false,"text":"who go to taste mixed drinks."}]},{"kind":"poetry","indent":1,"runs":[{"verse":31,"end":null,"start":true,"text":"Do not gaze at wine while it is red,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":31,"end":null,"start":false,"text":"when it sparkles in the cup"}]},{"kind":"poetry","indent":2,"runs":[{"verse":31,"end":null,"start":false,"text":"and goes down smoothly."}]},{"kind":"poetry","indent":1,"runs":[{"verse":32,"end":null,"start":true,"text":"In the end it bites like a snake"}]},{"kind":"poetry","indent":2,"runs":[{"verse":32,"end":null,"start":false,"text":"and stings like a viper."}]},{"kind":"poetry","indent":1,"runs":[{"verse":33,"end":null,"start":true,"text":"Your eyes will see strange things,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":33,"end":null,"start":false,"text":"and your mind will utter perversities."}]},{"kind":"poetry","indent":1,"runs":[{"verse":34,"end":null,"start":true,"text":"You will be like one sleeping on the high seas"}]},{"kind":"poetry","indent":2,"runs":[{"verse":34,"end":null,"start":false,"text":"or lying on the top of a mast:"}]},{"kind":"poetry","indent":1,"runs":[{"verse":35,"end":null,"start":true,"text":"“They struck me, but I feel no pain!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":35,"end":null,"start":false,"text":"They beat me, but I did not know it!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":35,"end":null,"start":false,"text":"When can I wake up"}]},{"kind":"poetry","indent":2,"runs":[{"verse":35,"end":null,"start":false,"text":"to search for another drink?”"}]}]}
