{"version":"bsb","book":"proverbs","chapter":22,"blocks":[{"kind":"heading","level":2,"text":"A Good Name"},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"A good name is more desirable than great riches;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"favor is better than silver and gold."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"The rich and the poor have this in common:"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"The LORD is Maker of them all."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"The prudent see danger and take cover,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"but the simple keep going and suffer the consequences."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"The rewards of humility and the fear of the LORD"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"are wealth and honor and life."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"Thorns and snares lie on the path of the perverse;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"he who guards his soul stays far from them."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"Train up a child in the way he should go,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"and when he is old he will not depart from it."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"The rich rule over the poor,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"and the borrower is slave to the lender."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"He who sows injustice will reap disaster,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"and the rod of his fury will be destroyed."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"A generous man will be blessed,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"for he shares his bread with the poor."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"Drive out the mocker, and conflict will depart;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"even quarreling and insults will cease."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"He who loves a pure heart and gracious lips"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"will have the king for a friend."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"The LORD’s eyes keep watch over knowledge,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"but He frustrates the words of the faithless."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":true,"text":"The slacker says, “There is a lion outside!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"I will be slain in the streets!”"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":true,"text":"The mouth of an adulteress is a deep pit;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"he who is under the wrath of the LORD will fall into it."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":true,"text":"Foolishness is bound up in the heart of a child,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"but the rod of discipline drives it far from him."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":true,"text":"Oppressing the poor to enrich oneself or giving gifts to the rich"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"will surely lead to poverty."}]},{"kind":"heading","level":2,"text":"Thirty Sayings of the Wise"},{"kind":"heading","level":3,"text":"Saying 1"},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":true,"text":"Incline your ear and hear the words of the wise —"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"apply your mind to my knowledge —"}]},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":true,"text":"for it is pleasing when you keep them within you"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"and they are constantly on your lips."}]},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":true,"text":"So that your trust may be in the LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"I instruct you today — yes, you."}]},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":true,"text":"Have I not written for you thirty sayings"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"about counsel and knowledge,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":21,"end":null,"start":true,"text":"to show you true and reliable words,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":21,"end":null,"start":false,"text":"that you may soundly answer those who sent you?"}]},{"kind":"heading","level":3,"text":"Saying 2"},{"kind":"poetry","indent":1,"runs":[{"verse":22,"end":null,"start":true,"text":"Do not rob a poor man because he is poor,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":22,"end":null,"start":false,"text":"and do not crush the afflicted at the gate,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":23,"end":null,"start":true,"text":"for the LORD will take up their case"}]},{"kind":"poetry","indent":2,"runs":[{"verse":23,"end":null,"start":false,"text":"and will plunder those who rob them."}]},{"kind":"heading","level":3,"text":"Saying 3"},{"kind":"poetry","indent":1,"runs":[{"verse":24,"end":null,"start":true,"text":"Do not make friends with an angry man,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":24,"end":null,"start":false,"text":"and do not associate with a hot-tempered man,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":25,"end":null,"start":true,"text":"or you may learn his ways"}]},{"kind":"poetry","indent":2,"runs":[{"verse":25,"end":null,"start":false,"text":"and entangle yourself in a snare."}]},{"kind":"heading","level":3,"text":"Saying 4"},{"kind":"poetry","indent":1,"runs":[{"verse":26,"end":null,"start":true,"text":"Do not be one who gives pledges,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":26,"end":null,"start":false,"text":"who puts up security for debts."}]},{"kind":"poetry","indent":1,"runs":[{"verse":27,"end":null,"start":true,"text":"If you have nothing with which to pay,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":27,"end":null,"start":false,"text":"why should your bed be taken from under you?"}]},{"kind":"heading","level":3,"text":"Saying 5"},{"kind":"poetry","indent":1,"runs":[{"verse":28,"end":null,"start":true,"text":"Do not move an ancient boundary stone"}]},{"kind":"poetry","indent":2,"runs":[{"verse":28,"end":null,"start":false,"text":"which your fathers have placed."}]},{"kind":"heading","level":3,"text":"Saying 6"},{"kind":"poetry","indent":1,"runs":[{"verse":29,"end":null,"start":true,"text":"Do you see a man skilled in his work?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":29,"end":null,"start":false,"text":"He will be stationed in the presence of kings;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":29,"end":null,"start":false,"text":"he will not stand before obscure men."}]}]}
