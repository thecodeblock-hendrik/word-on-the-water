{"version":"bsb","book":"proverbs","chapter":18,"blocks":[{"kind":"heading","level":2,"text":"The Selfishness of the Unfriendly"},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"He who isolates himself pursues selfish desires;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"he rebels against all sound judgment."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"A fool does not delight in understanding,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"but only in airing his opinions."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"With a wicked man comes contempt as well,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"and shame is accompanied by disgrace."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"The words of a man’s mouth are deep waters;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"the fountain of wisdom is a bubbling brook."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"Showing partiality to the wicked is not good,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"nor is depriving the innocent of justice."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"A fool’s lips bring him strife,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"and his mouth invites a beating."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"A fool’s mouth is his ruin,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"and his lips are a snare to his soul."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"The words of a gossip are like choice morsels"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"that go down into the inmost being."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"Whoever is slothful in his work"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"is brother to him who destroys."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"The name of the LORD is a strong tower;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"the righteous run to it and are safe."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"A rich man’s wealth is his fortified city;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"it is like a high wall in his imagination."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"Before his downfall a man’s heart is proud,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"but humility comes before honor."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":true,"text":"He who answers a matter before he hears it—"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"this is folly and disgrace to him."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":true,"text":"The spirit of a man can endure his sickness,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"but who can survive a broken spirit?"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":true,"text":"The heart of the discerning acquires knowledge,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"and the ear of the wise seeks it out."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":true,"text":"A man’s gift opens doors for him,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"and brings him before great men."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":true,"text":"The first to state his case seems right"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"until another comes and cross-examines him."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":true,"text":"Casting the lot ends quarrels"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"and separates strong opponents."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":true,"text":"An offended brother is harder to win than a fortified city,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"and disputes are like the bars of a castle."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":true,"text":"From the fruit of his mouth a man’s belly is filled;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"with the harvest from his lips he is satisfied."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":21,"end":null,"start":true,"text":"Life and death are in the power of the tongue,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":21,"end":null,"start":false,"text":"and those who love it will eat its fruit."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":22,"end":null,"start":true,"text":"He who finds a wife finds a good thing"}]},{"kind":"poetry","indent":2,"runs":[{"verse":22,"end":null,"start":false,"text":"and obtains favor from the LORD."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":23,"end":null,"start":true,"text":"The poor man pleads for mercy,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":23,"end":null,"start":false,"text":"but the rich man answers harshly."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":24,"end":null,"start":true,"text":"A man of many companions may come to ruin,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":24,"end":null,"start":false,"text":"but there is a friend who stays closer than a brother."}]}]}
