{"version":"bsb","book":"judges","chapter":5,"blocks":[{"kind":"heading","level":2,"text":"The Song of Deborah and Barak"},{"kind":"paragraph","indent":0,"runs":[{"verse":1,"end":null,"start":true,"text":"On that day Deborah and Barak son of Abinoam sang this song:"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"“When the princes take the lead in Israel,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"when the people volunteer,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"bless the LORD."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"Listen, O kings! Give ear, O princes!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"I will sing to the LORD;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":false,"text":"I will sing praise to the LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"the God of Israel."}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"O LORD, when You went out from Seir,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"when You marched from the land of Edom,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":false,"text":"the earth trembled, the heavens poured out rain,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"and the clouds poured down water."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"The mountains quaked before the LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"the One of Sinai,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":false,"text":"before the LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"the God of Israel."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"In the days of Shamgar son of Anath,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"in the days of Jael,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":false,"text":"the highways were deserted"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"and the travelers took the byways."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"Life in the villages ceased;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"it ended in Israel,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":false,"text":"until I, Deborah, arose,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"a mother in Israel."}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"When they chose new gods,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"then war came to their gates."}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":false,"text":"Not a shield or spear was found"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"among forty thousand in Israel."}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"My heart is with the princes of Israel,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"with the volunteers among the people."}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"Bless the LORD!"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"You who ride white donkeys,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"who sit on saddle blankets,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"and you who travel the road,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":false,"text":"ponder"},{"verse":11,"end":null,"start":true,"text":"the voices of the singers"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"at the watering places."}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":false,"text":"There they shall recount the righteous acts of the LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"the righteous deeds of His villagers in Israel."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":false,"text":"Then the people of the LORD"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"went down to the gates:"}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"‘Awake, awake, O Deborah!"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"Awake, awake, sing a song!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":false,"text":"Arise, O Barak,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"and take hold of your captives, O son of Abinoam!’"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":true,"text":"Then the survivors came down to the nobles;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"the people of the LORD came down to me against the mighty."}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":true,"text":"Some came from Ephraim, with their roots in Amalek;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"Benjamin came with your people after you."}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":false,"text":"The commanders came down from Machir,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"the bearers of the marshal’s staff from Zebulun."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":true,"text":"The princes of Issachar were with Deborah,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"and Issachar was with Barak,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"rushing into the valley at his heels."}]},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":false,"text":"In the clans of Reuben"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"there was great indecision."}]},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":true,"text":"Why did you sit among the sheepfolds"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"to hear the whistling for the flocks?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":false,"text":"In the clans of Reuben"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"there was great indecision."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":true,"text":"Gilead remained beyond the Jordan."}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"Dan, why did you linger by the ships?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":false,"text":"Asher stayed at the coast"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"and remained in his harbors."}]},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":true,"text":"Zebulun was a people who risked their lives;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"Naphtali, too, on the heights of the battlefield."}]},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":true,"text":"Kings came and fought;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"then the kings of Canaan fought at Taanach"}]},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":false,"text":"by the waters of Megiddo,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"but they took no plunder of silver."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":true,"text":"From the heavens the stars fought;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"from their courses they fought against Sisera."}]},{"kind":"poetry","indent":1,"runs":[{"verse":21,"end":null,"start":true,"text":"The River Kishon swept them away,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":21,"end":null,"start":false,"text":"the ancient river, the River Kishon."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":21,"end":null,"start":false,"text":"March on, O my soul, in strength!"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":22,"end":null,"start":true,"text":"Then the hooves of horses thundered—"}]},{"kind":"poetry","indent":2,"runs":[{"verse":22,"end":null,"start":false,"text":"the mad galloping of his stallions."}]},{"kind":"poetry","indent":1,"runs":[{"verse":23,"end":null,"start":true,"text":"‘Curse Meroz,’ says the angel of the LORD."}]},{"kind":"poetry","indent":2,"runs":[{"verse":23,"end":null,"start":false,"text":"‘Bitterly curse her inhabitants;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":23,"end":null,"start":false,"text":"for they did not come to help the LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":23,"end":null,"start":false,"text":"to help the LORD against the mighty.’"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":24,"end":null,"start":true,"text":"Most blessed among women is Jael,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":24,"end":null,"start":false,"text":"the wife of Heber the Kenite,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":24,"end":null,"start":false,"text":"most blessed of tent-dwelling women."}]},{"kind":"poetry","indent":1,"runs":[{"verse":25,"end":null,"start":true,"text":"He asked for water, and she gave him milk."}]},{"kind":"poetry","indent":2,"runs":[{"verse":25,"end":null,"start":false,"text":"In a magnificent bowl she brought him curds."}]},{"kind":"poetry","indent":1,"runs":[{"verse":26,"end":null,"start":true,"text":"She reached for the tent peg,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":26,"end":null,"start":false,"text":"her right hand for the workman’s hammer."}]},{"kind":"poetry","indent":1,"runs":[{"verse":26,"end":null,"start":false,"text":"She struck Sisera and crushed his skull;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":26,"end":null,"start":false,"text":"she shattered and pierced his temple."}]},{"kind":"poetry","indent":1,"runs":[{"verse":27,"end":null,"start":true,"text":"At her feet he collapsed, he fell,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":27,"end":null,"start":false,"text":"there he lay still;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":27,"end":null,"start":false,"text":"at her feet he collapsed, he fell;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":27,"end":null,"start":false,"text":"where he collapsed, there he fell dead."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":28,"end":null,"start":true,"text":"Sisera’s mother looked through the window;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":28,"end":null,"start":false,"text":"she peered through the lattice and lamented:"}]},{"kind":"poetry","indent":1,"runs":[{"verse":28,"end":null,"start":false,"text":"‘Why is his chariot so long in coming?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":28,"end":null,"start":false,"text":"What has delayed the clatter of his chariots?’"}]},{"kind":"poetry","indent":1,"runs":[{"verse":29,"end":null,"start":true,"text":"Her wisest ladies answer;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":29,"end":null,"start":false,"text":"indeed she keeps telling herself,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":30,"end":null,"start":true,"text":"‘Are they not finding and dividing the spoil—"}]},{"kind":"poetry","indent":2,"runs":[{"verse":30,"end":null,"start":false,"text":"a girl or two for each warrior,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":30,"end":null,"start":false,"text":"a plunder of dyed garments for Sisera,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":30,"end":null,"start":false,"text":"the spoil of embroidered garments"}]},{"kind":"poetry","indent":2,"runs":[{"verse":30,"end":null,"start":false,"text":"for the neck of the looter?’"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":31,"end":null,"start":true,"text":"So may all Your enemies perish,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":31,"end":null,"start":false,"text":"O LORD!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":31,"end":null,"start":false,"text":"But may those who love You"}]},{"kind":"poetry","indent":2,"runs":[{"verse":31,"end":null,"start":false,"text":"shine like the sun at its brightest.”"}]},{"kind":"paragraph","indent":0,"runs":[{"verse":31,"end":null,"start":false,"text":"And the land had rest for forty years."}]}]}
