{"version":"bsb","book":"lamentations","chapter":3,"blocks":[{"kind":"heading","level":2,"text":"The Prophet’s Afflictions"},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"I am the man who has seen affliction"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"under the rod of God’s wrath."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"He has driven me away and made me walk"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"in darkness instead of light."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"Indeed, He keeps turning His hand"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"against me all day long."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"He has worn away my flesh and skin;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"He has shattered my bones."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"He has besieged me and surrounded me"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"with bitterness and hardship."}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"He has made me dwell in darkness"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"like those dead for ages."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"He has walled me in so I cannot escape;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"He has weighed me down with chains."}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"Even when I cry out and plead for help,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"He shuts out my prayer."}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"He has barred my ways with cut stones;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"He has made my paths crooked."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"He is a bear lying in wait,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"a lion hiding in ambush."}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"He forced me off my path and tore me to pieces;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"He left me without help."}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"He bent His bow"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"and set me as the target for His arrow."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":true,"text":"He pierced my kidneys"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"with His arrows."}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":true,"text":"I am a laughingstock to all my people;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"they mock me in song all day long."}]},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":true,"text":"He has filled me with bitterness;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"He has intoxicated me with wormwood."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":true,"text":"He has ground my teeth with gravel"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"and trampled me in the dust."}]},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":true,"text":"My soul has been deprived of peace;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"I have forgotten what prosperity is."}]},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":true,"text":"So I say, “My strength has perished,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"along with my hope from the LORD.”"}]},{"kind":"heading","level":2,"text":"The Prophet’s Hope"},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":true,"text":"Remember my affliction and wandering,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"the wormwood and the gall."}]},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":true,"text":"Surely my soul remembers"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"and is humbled within me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":21,"end":null,"start":true,"text":"Yet I call this to mind,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":21,"end":null,"start":false,"text":"and therefore I have hope:"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":22,"end":null,"start":true,"text":"Because of the loving devotion of the LORD we are not consumed,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":22,"end":null,"start":false,"text":"for His mercies never fail."}]},{"kind":"poetry","indent":1,"runs":[{"verse":23,"end":null,"start":true,"text":"They are new every morning;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":23,"end":null,"start":false,"text":"great is Your faithfulness!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":24,"end":null,"start":true,"text":"“The LORD is my portion,” says my soul,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":24,"end":null,"start":false,"text":"“therefore I will hope in Him.”"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":25,"end":null,"start":true,"text":"The LORD is good to those who wait for Him,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":25,"end":null,"start":false,"text":"to the soul who seeks Him."}]},{"kind":"poetry","indent":1,"runs":[{"verse":26,"end":null,"start":true,"text":"It is good to wait quietly"}]},{"kind":"poetry","indent":2,"runs":[{"verse":26,"end":null,"start":false,"text":"for the salvation of the LORD."}]},{"kind":"poetry","indent":1,"runs":[{"verse":27,"end":null,"start":true,"text":"It is good for a man to bear the yoke"}]},{"kind":"poetry","indent":2,"runs":[{"verse":27,"end":null,"start":false,"text":"while he is still young."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":28,"end":null,"start":true,"text":"Let him sit alone in silence,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":28,"end":null,"start":false,"text":"for the LORD has laid it upon him."}]},{"kind":"poetry","indent":1,"runs":[{"verse":29,"end":null,"start":true,"text":"Let him bury his face in the dust—"}]},{"kind":"poetry","indent":2,"runs":[{"verse":29,"end":null,"start":false,"text":"perhaps there is still hope."}]},{"kind":"poetry","indent":1,"runs":[{"verse":30,"end":null,"start":true,"text":"Let him offer his cheek to the one who would strike him;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":30,"end":null,"start":false,"text":"let him be filled with reproach."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":31,"end":null,"start":true,"text":"For the Lord will not"}]},{"kind":"poetry","indent":2,"runs":[{"verse":31,"end":null,"start":false,"text":"cast us off forever."}]},{"kind":"poetry","indent":1,"runs":[{"verse":32,"end":null,"start":true,"text":"Even if He causes grief, He will show compassion"}]},{"kind":"poetry","indent":2,"runs":[{"verse":32,"end":null,"start":false,"text":"according to His abundant loving devotion."}]},{"kind":"poetry","indent":1,"runs":[{"verse":33,"end":null,"start":true,"text":"For He does not willingly afflict"}]},{"kind":"poetry","indent":2,"runs":[{"verse":33,"end":null,"start":false,"text":"or grieve the sons of men."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":34,"end":null,"start":true,"text":"To crush underfoot"}]},{"kind":"poetry","indent":2,"runs":[{"verse":34,"end":null,"start":false,"text":"all the prisoners of the land,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":35,"end":null,"start":true,"text":"to deny a man justice"}]},{"kind":"poetry","indent":2,"runs":[{"verse":35,"end":null,"start":false,"text":"before the Most High,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":36,"end":null,"start":true,"text":"to subvert a man in his lawsuit—"}]},{"kind":"poetry","indent":2,"runs":[{"verse":36,"end":null,"start":false,"text":"of these the Lord does not approve."}]},{"kind":"heading","level":2,"text":"God’s Justice"},{"kind":"poetry","indent":1,"runs":[{"verse":37,"end":null,"start":true,"text":"Who has spoken and it came to pass,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":37,"end":null,"start":false,"text":"unless the Lord has ordained it?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":38,"end":null,"start":true,"text":"Do not both adversity and good"}]},{"kind":"poetry","indent":2,"runs":[{"verse":38,"end":null,"start":false,"text":"come from the mouth of the Most High?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":39,"end":null,"start":true,"text":"Why should any mortal man complain,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":39,"end":null,"start":false,"text":"in view of his sins?"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":40,"end":null,"start":true,"text":"Let us examine and test our ways,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":40,"end":null,"start":false,"text":"and turn back to the LORD."}]},{"kind":"poetry","indent":1,"runs":[{"verse":41,"end":null,"start":true,"text":"Let us lift up our hearts and hands"}]},{"kind":"poetry","indent":2,"runs":[{"verse":41,"end":null,"start":false,"text":"to God in heaven:"}]},{"kind":"poetry","indent":1,"runs":[{"verse":42,"end":null,"start":true,"text":"“We have sinned and rebelled;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":42,"end":null,"start":false,"text":"You have not forgiven.”"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":43,"end":null,"start":true,"text":"You have covered Yourself in anger and pursued us;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":43,"end":null,"start":false,"text":"You have killed without pity."}]},{"kind":"poetry","indent":1,"runs":[{"verse":44,"end":null,"start":true,"text":"You have covered Yourself with a cloud"}]},{"kind":"poetry","indent":2,"runs":[{"verse":44,"end":null,"start":false,"text":"that no prayer can pass through."}]},{"kind":"poetry","indent":1,"runs":[{"verse":45,"end":null,"start":true,"text":"You have made us scum and refuse"}]},{"kind":"poetry","indent":2,"runs":[{"verse":45,"end":null,"start":false,"text":"among the nations."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":46,"end":null,"start":true,"text":"All our enemies"}]},{"kind":"poetry","indent":2,"runs":[{"verse":46,"end":null,"start":false,"text":"open their mouths against us."}]},{"kind":"poetry","indent":1,"runs":[{"verse":47,"end":null,"start":true,"text":"Panic and pitfall have come upon us —"}]},{"kind":"poetry","indent":2,"runs":[{"verse":47,"end":null,"start":false,"text":"devastation and destruction."}]},{"kind":"poetry","indent":1,"runs":[{"verse":48,"end":null,"start":true,"text":"Streams of tears flow from my eyes"}]},{"kind":"poetry","indent":2,"runs":[{"verse":48,"end":null,"start":false,"text":"over the destruction of the daughter of my people."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":49,"end":null,"start":true,"text":"My eyes overflow unceasingly,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":49,"end":null,"start":false,"text":"without relief,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":50,"end":null,"start":true,"text":"until the LORD"}]},{"kind":"poetry","indent":2,"runs":[{"verse":50,"end":null,"start":false,"text":"looks down from heaven and sees."}]},{"kind":"poetry","indent":1,"runs":[{"verse":51,"end":null,"start":true,"text":"My eyes bring grief to my soul"}]},{"kind":"poetry","indent":2,"runs":[{"verse":51,"end":null,"start":false,"text":"because of all the daughters of my city."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":52,"end":null,"start":true,"text":"Without cause my enemies"}]},{"kind":"poetry","indent":2,"runs":[{"verse":52,"end":null,"start":false,"text":"hunted me like a bird."}]},{"kind":"poetry","indent":1,"runs":[{"verse":53,"end":null,"start":true,"text":"They dropped me alive into a pit"}]},{"kind":"poetry","indent":2,"runs":[{"verse":53,"end":null,"start":false,"text":"and cast stones upon me."}]},{"kind":"poetry","indent":1,"runs":[{"verse":54,"end":null,"start":true,"text":"The waters flowed over my head,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":54,"end":null,"start":false,"text":"and I thought I was going to die."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":55,"end":null,"start":true,"text":"I called on Your name, O LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":55,"end":null,"start":false,"text":"out of the depths of the Pit."}]},{"kind":"poetry","indent":1,"runs":[{"verse":56,"end":null,"start":true,"text":"You heard my plea:"}]},{"kind":"poetry","indent":2,"runs":[{"verse":56,"end":null,"start":false,"text":"“Do not ignore my cry for relief.”"}]},{"kind":"poetry","indent":1,"runs":[{"verse":57,"end":null,"start":true,"text":"You drew near when I called on You;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":57,"end":null,"start":false,"text":"You said, “Do not be afraid.”"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":58,"end":null,"start":true,"text":"You defend my cause, O Lord;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":58,"end":null,"start":false,"text":"You redeem my life."}]},{"kind":"poetry","indent":1,"runs":[{"verse":59,"end":null,"start":true,"text":"You have seen, O LORD, the wrong done to me;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":59,"end":null,"start":false,"text":"vindicate my cause!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":60,"end":null,"start":true,"text":"You have seen all their malice,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":60,"end":null,"start":false,"text":"all their plots against me."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":61,"end":null,"start":true,"text":"O LORD, You have heard their insults,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":61,"end":null,"start":false,"text":"all their plots against me —"}]},{"kind":"poetry","indent":1,"runs":[{"verse":62,"end":null,"start":true,"text":"the slander and murmuring of my assailants"}]},{"kind":"poetry","indent":2,"runs":[{"verse":62,"end":null,"start":false,"text":"against me all day long."}]},{"kind":"poetry","indent":1,"runs":[{"verse":63,"end":null,"start":true,"text":"When they sit and when they rise,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":63,"end":null,"start":false,"text":"see how they mock me in song."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":64,"end":null,"start":true,"text":"You will pay them back what they deserve, O LORD,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":64,"end":null,"start":false,"text":"according to the work of their hands."}]},{"kind":"poetry","indent":1,"runs":[{"verse":65,"end":null,"start":true,"text":"Put a veil of anguish over their hearts;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":65,"end":null,"start":false,"text":"may Your curse be upon them!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":66,"end":null,"start":true,"text":"You will pursue them in anger and exterminate them"}]},{"kind":"poetry","indent":2,"runs":[{"verse":66,"end":null,"start":false,"text":"from under Your heavens, O LORD."}]}]}
