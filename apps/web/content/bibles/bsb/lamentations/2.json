{"version":"bsb","book":"lamentations","chapter":2,"blocks":[{"kind":"heading","level":2,"text":"God’s Anger over Jerusalem"},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":true,"text":"How the Lord has covered the Daughter of Zion"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"with the cloud of His anger!"}]},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":false,"text":"He has cast the glory of Israel"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"from heaven to earth."}]},{"kind":"poetry","indent":1,"runs":[{"verse":1,"end":null,"start":false,"text":"He has abandoned His footstool"}]},{"kind":"poetry","indent":2,"runs":[{"verse":1,"end":null,"start":false,"text":"in the day of His anger."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":true,"text":"Without pity the Lord has swallowed up"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"all the dwellings of Jacob."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":false,"text":"In His wrath He has demolished"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"the fortified cities of the Daughter of Judah."}]},{"kind":"poetry","indent":1,"runs":[{"verse":2,"end":null,"start":false,"text":"He brought to the ground and defiled"}]},{"kind":"poetry","indent":2,"runs":[{"verse":2,"end":null,"start":false,"text":"her kingdom and its princes."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":true,"text":"In fierce anger He has cut off"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"every horn of Israel"}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":false,"text":"and withdrawn His right hand"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"at the approach of the enemy."}]},{"kind":"poetry","indent":1,"runs":[{"verse":3,"end":null,"start":false,"text":"He has burned in Jacob like a flaming fire"}]},{"kind":"poetry","indent":2,"runs":[{"verse":3,"end":null,"start":false,"text":"that consumes everything around it."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":true,"text":"He has bent His bow like an enemy;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"His right hand is positioned."}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":false,"text":"Like a foe He has killed"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"all who were pleasing to the eye;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":4,"end":null,"start":false,"text":"He has poured out His wrath like fire"}]},{"kind":"poetry","indent":2,"runs":[{"verse":4,"end":null,"start":false,"text":"on the tent of the Daughter of Zion."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":true,"text":"The Lord is like an enemy;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"He has swallowed up Israel."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":false,"text":"He has swallowed up all her palaces"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"and destroyed her strongholds."}]},{"kind":"poetry","indent":1,"runs":[{"verse":5,"end":null,"start":false,"text":"He has multiplied mourning and lamentation"}]},{"kind":"poetry","indent":2,"runs":[{"verse":5,"end":null,"start":false,"text":"for the Daughter of Judah."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":true,"text":"He has laid waste His tabernacle like a garden booth;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"He has destroyed His place of meeting."}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":false,"text":"The LORD has made Zion forget"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"her appointed feasts and Sabbaths."}]},{"kind":"poetry","indent":1,"runs":[{"verse":6,"end":null,"start":false,"text":"In His fierce anger"}]},{"kind":"poetry","indent":2,"runs":[{"verse":6,"end":null,"start":false,"text":"He has despised both king and priest."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":true,"text":"The Lord has rejected His altar;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"He has abandoned His sanctuary;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":false,"text":"He has delivered the walls of her palaces"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"into the hand of the enemy."}]},{"kind":"poetry","indent":1,"runs":[{"verse":7,"end":null,"start":false,"text":"They have raised a shout in the house of the LORD"}]},{"kind":"poetry","indent":2,"runs":[{"verse":7,"end":null,"start":false,"text":"as on the day of an appointed feast."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":true,"text":"The LORD determined to destroy"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"the wall of the Daughter of Zion."}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":false,"text":"He stretched out a measuring line"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"and did not withdraw His hand from destroying."}]},{"kind":"poetry","indent":1,"runs":[{"verse":8,"end":null,"start":false,"text":"He made the ramparts and walls lament;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":8,"end":null,"start":false,"text":"together they waste away."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":true,"text":"Her gates have sunk into the ground;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"He has destroyed and shattered their bars."}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":false,"text":"Her king and her princes are exiled among the nations,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"the law is no more,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":9,"end":null,"start":false,"text":"and even her prophets"}]},{"kind":"poetry","indent":2,"runs":[{"verse":9,"end":null,"start":false,"text":"find no vision from the LORD."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":true,"text":"The elders of the Daughter of Zion"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"sit on the ground in silence."}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":false,"text":"They have thrown dust on their heads"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"and put on sackcloth."}]},{"kind":"poetry","indent":1,"runs":[{"verse":10,"end":null,"start":false,"text":"The young women of Jerusalem"}]},{"kind":"poetry","indent":2,"runs":[{"verse":10,"end":null,"start":false,"text":"have bowed their heads to the ground."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":true,"text":"My eyes fail from weeping;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"I am churning within."}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":false,"text":"My heart is poured out in grief"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"over the destruction of the daughter of my people,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":11,"end":null,"start":false,"text":"because children and infants faint"}]},{"kind":"poetry","indent":2,"runs":[{"verse":11,"end":null,"start":false,"text":"in the streets of the city."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":true,"text":"They cry out to their mothers:"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"“Where is the grain and wine?”"}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":false,"text":"as they faint like the wounded"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"in the streets of the city,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":12,"end":null,"start":false,"text":"as their lives fade away"}]},{"kind":"poetry","indent":2,"runs":[{"verse":12,"end":null,"start":false,"text":"in the arms of their mothers."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":true,"text":"What can I say for you?"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"To what can I compare you,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"O Daughter of Jerusalem?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":false,"text":"To what can I liken you,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"that I may console you,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"O Virgin Daughter of Zion?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":13,"end":null,"start":false,"text":"For your wound is as deep as the sea."}]},{"kind":"poetry","indent":2,"runs":[{"verse":13,"end":null,"start":false,"text":"Who can ever heal you?"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":true,"text":"The visions of your prophets"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"were empty and deceptive;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":false,"text":"they did not expose your guilt"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"to ward off your captivity."}]},{"kind":"poetry","indent":1,"runs":[{"verse":14,"end":null,"start":false,"text":"The burdens they envisioned for you"}]},{"kind":"poetry","indent":2,"runs":[{"verse":14,"end":null,"start":false,"text":"were empty and misleading."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":true,"text":"All who pass by"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"clap their hands at you in scorn."}]},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":false,"text":"They hiss and shake their heads"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"at the Daughter of Jerusalem:"}]},{"kind":"poetry","indent":1,"runs":[{"verse":15,"end":null,"start":false,"text":"“Is this the city that was called"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"the perfection of beauty,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":15,"end":null,"start":false,"text":"the joy of all the earth?”"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":true,"text":"All your enemies"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"open their mouths against you."}]},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":false,"text":"They hiss and gnash their teeth,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"saying, “We have swallowed her up."}]},{"kind":"poetry","indent":1,"runs":[{"verse":16,"end":null,"start":false,"text":"This is the day for which we have waited."}]},{"kind":"poetry","indent":2,"runs":[{"verse":16,"end":null,"start":false,"text":"We have lived to see it!”"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":true,"text":"The LORD has done what He planned;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"He has accomplished His decree,"}]},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":false,"text":"which He ordained in days of old;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"He has overthrown you without pity."}]},{"kind":"poetry","indent":1,"runs":[{"verse":17,"end":null,"start":false,"text":"He has let the enemy gloat over you"}]},{"kind":"poetry","indent":2,"runs":[{"verse":17,"end":null,"start":false,"text":"and exalted the horn of your foes."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":true,"text":"The hearts of the people"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"cry out to the Lord."}]},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":false,"text":"O wall of the Daughter of Zion,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"let your tears run down like a river"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"day and night."}]},{"kind":"poetry","indent":1,"runs":[{"verse":18,"end":null,"start":false,"text":"Give yourself no relief,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":18,"end":null,"start":false,"text":"and your eyes no rest."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":true,"text":"Arise, cry out in the night"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"from the first watch of the night."}]},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":false,"text":"Pour out your heart like water"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"in the presence of the Lord."}]},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":false,"text":"Lift up your hands to Him"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"for the lives of your children"}]},{"kind":"poetry","indent":1,"runs":[{"verse":19,"end":null,"start":false,"text":"who are fainting from hunger"}]},{"kind":"poetry","indent":2,"runs":[{"verse":19,"end":null,"start":false,"text":"on the corner of every street."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":true,"text":"Look, O LORD, and consider:"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"Whom have You ever treated like this?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":false,"text":"Should women eat their offspring,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"the infants they have nurtured?"}]},{"kind":"poetry","indent":1,"runs":[{"verse":20,"end":null,"start":false,"text":"Should priests and prophets be killed"}]},{"kind":"poetry","indent":2,"runs":[{"verse":20,"end":null,"start":false,"text":"in the sanctuary of the Lord?"}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":21,"end":null,"start":true,"text":"Both young and old lie together"}]},{"kind":"poetry","indent":2,"runs":[{"verse":21,"end":null,"start":false,"text":"in the dust of the streets."}]},{"kind":"poetry","indent":1,"runs":[{"verse":21,"end":null,"start":false,"text":"My young men and maidens"}]},{"kind":"poetry","indent":2,"runs":[{"verse":21,"end":null,"start":false,"text":"have fallen by the sword."}]},{"kind":"poetry","indent":1,"runs":[{"verse":21,"end":null,"start":false,"text":"You have slain them in the day of Your anger;"}]},{"kind":"poetry","indent":2,"runs":[{"verse":21,"end":null,"start":false,"text":"You have slaughtered them without compassion."}]},{"kind":"break"},{"kind":"poetry","indent":1,"runs":[{"verse":22,"end":null,"start":true,"text":"You summoned my terrors on every side,"}]},{"kind":"poetry","indent":2,"runs":[{"verse":22,"end":null,"start":false,"text":"as for the day of an appointed feast."}]},{"kind":"poetry","indent":1,"runs":[{"verse":22,"end":null,"start":false,"text":"In the day of the LORD’s anger"}]},{"kind":"poetry","indent":2,"runs":[{"verse":22,"end":null,"start":false,"text":"no one escaped or survived;"}]},{"kind":"poetry","indent":1,"runs":[{"verse":22,"end":null,"start":false,"text":"my enemy has destroyed"}]},{"kind":"poetry","indent":2,"runs":[{"verse":22,"end":null,"start":false,"text":"those I nurtured and reared."}]}]}
