{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "ignoreCommand": "[ \"$VERCEL_ENV\" = production ] && [ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] && [ \"$VERCEL_GIT_PREVIOUS_SHA\" != \"$VERCEL_GIT_COMMIT_SHA\" ] && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- . || exit 1",
  "functions": {
    "app/main.py": {
      "maxDuration": 30,
      "excludeFiles": "{tests/**,alembic/**,.venv/**,.pytest_cache/**,.mypy_cache/**,.ruff_cache/**,.coverage}"
    }
  },
  "crons": [{ "path": "/cron/drain-outbox", "schedule": "0 5 * * *" }]
}
