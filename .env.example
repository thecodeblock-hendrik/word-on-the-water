# Names only. Copy to .env for local development.

# Database (local docker compose)
DATABASE_URL=
DATABASE_URL_DIRECT=
# On Vercel: built from the Neon branch host (NEON_PGHOST) plus these role passwords
DB_RUNTIME_PASSWORD=
DB_MIGRATOR_PASSWORD=

# Redis
REDIS_URL=

# API <-> web
API_BASE_URL=
SERVICE_TOKEN=
CRON_SECRET=
# Web only: the API project's Vercel protection-bypass secret
API_BYPASS_SECRET=
IP_HASH_SALT=

# Email
EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=
POSTMARK_SERVER_TOKEN=
# Sentry project DSN for the API; leave blank locally to disable error reporting
SENTRY_DSN=

# Bot protection
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Encryption (prayer requests)
PRAYER_ENCRYPTION_KEY_ID=
PRAYER_ENCRYPTION_KEY=

# Observability
SENTRY_DSN=

# Web only, optional: pretend it is this day (YYYY-MM-DD) to preview upcoming devotionals.
# Ignored on the production site.
DEVOTIONAL_TODAY=

# Web only: set to 1 to show the Bible reader (/bible). Off by default until it is ready to launch.
BIBLE_ENABLED=
# Set to 1 to turn on the Got Questions chat (docs/archive/chat.md). Off by default; unset is the kill switch (503).
CHAT_ENABLED=
# Optional chat tuning (blank uses the default): seconds before a message counts as human (0.5),
# messages allowed per visitor address (30) in a window of seconds (600).
CHAT_MIN_SECONDS=
CHAT_LIMIT=
CHAT_WINDOW_SECONDS=
# Comma-separated hostnames allowed to use `pnpm dev`, e.g. your Mac's Wi-Fi address to test on a phone
DEV_ORIGINS=
# Kit (kit.com): API key from Kit developer settings, and the id of the double opt-in sign-up form (use the test form locally and in Preview)
KIT_API_KEY=
KIT_FORM_ID=
# Kit key used by `pnpm broadcast:devotional` (draft broadcasts) unless --live is given; the Kit account is shared, so drafts show up in the live account
KIT_API_KEY_PREVIEW=
# Optional: SITE_URL, the public address for canonical links, the sitemap and the weekly email's "read it on the website" link (default https://wordonthewater.net; a Vercel preview uses its own address). It must be the address the page is served from, because Next makes the page's prev, next and image links absolute from it and the CSP blocks links to another site.
# Optional, for `pnpm broadcast:devotional`: EMAIL_IMAGE_BASE, where the email banner is fetched from (default https://wordonthewater.net/email; only to test before the site is live)
# Kit webhook signing secret, saved here by `make kit-webhook URL=...` (shown by Kit only once). Only with a paid Kit plan: the free plan has no webhooks, so it stays empty at launch
KIT_WEBHOOK_SECRET=
