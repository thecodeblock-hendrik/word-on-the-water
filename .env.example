# Names only. Copy to .env for local development.

# Database (local docker compose)
DATABASE_URL=
DATABASE_URL_DIRECT=
# On Vercel: built from the Neon branch host (NEON_PGHOST) plus these role passwords
DB_RUNTIME_PASSWORD=
DB_MIGRATOR_PASSWORD=

# Redis
REDIS_URL=

# API <-> web
API_BASE_URL=
SERVICE_TOKEN=
CRON_SECRET=
# Web only: the API project's Vercel protection-bypass secret
API_BYPASS_SECRET=
IP_HASH_SALT=

# Email
EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=
POSTMARK_SERVER_TOKEN=
# Sentry project DSN for the API; leave blank locally to disable error reporting
SENTRY_DSN=

# Bot protection
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Encryption (prayer requests)
PRAYER_ENCRYPTION_KEY_ID=
PRAYER_ENCRYPTION_KEY=

# Observability
SENTRY_DSN=

# Web only, optional: pretend it is this day (YYYY-MM-DD) to preview upcoming devotionals.
# Ignored on the production site.
DEVOTIONAL_TODAY=

# Web only: set to 1 to show the Bible reader (/bible). Off by default until it is ready to launch.
BIBLE_ENABLED=
# Comma-separated hostnames allowed to use `pnpm dev`, e.g. your Mac's Wi-Fi address to test on a phone
DEV_ORIGINS=
# Kit (kit.com): API key from Kit developer settings, and the id of the double opt-in sign-up form (use the test form locally and in Preview)
KIT_API_KEY=
KIT_FORM_ID=
# Kit webhook signing secret, saved here by `make kit-webhook URL=...` (shown by Kit only once)
KIT_WEBHOOK_SECRET=
